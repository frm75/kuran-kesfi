<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Capacitor id'si "webview" olmali; Bridge onu buradan bulur. -->
    <com.getcapacitor.CapacitorWebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/alt_serit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/serit_zemin"
        app:itemIconTint="@color/serit_oge"
        app:itemTextColor="@color/serit_oge"
        app:itemRippleColor="@color/serit_vurgu_zemin"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/alt_serit" />
</LinearLayout>
