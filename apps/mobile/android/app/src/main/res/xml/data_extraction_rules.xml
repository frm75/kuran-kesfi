<?xml version="1.0" encoding="utf-8"?>
<!--
  Yedekleme kapali (Android 12+). Konum ve ayarlar (Preferences) cihazdan
  cikmaz: ne Google Drive bulut yedegine ne de cihazdan cihaza aktarima girer.
  Android 11 ve alti icin AndroidManifest allowBackup="false" ve
  fullBackupContent="false".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
