---
import type { GetStaticPaths } from "astro";
import Base from "~/layouts/Base.astro";
import SurahReading from "~/components/SurahReading.astro";
import { getDefaultAuthor, getSurahMetaById, getSurahsIndex } from "~/lib/data";

/**
 * Klasik okuma ekrani — surenin kanonik adresi (plan §7).
 *
 * Ontanimli meali (Diyanet Isleri) gosterir. Ekranin kendisi
 * <SurahReading> icinde; bu dosya yalnizca hangi surenin, hangi mealle ve
 * hangi baslikla acilacagini soyler. Diger 25 Turkce meal
 * `/<sure>/meal/<yazar>` altinda ayni bilesenle uretilir.
 */

export const getStaticPaths = (() => {
  return getSurahsIndex().surahs.map((surah) => ({
    params: { surah: surah.slug },
    props: { surahId: surah.id },
  }));
}) satisfies GetStaticPaths;

const { surahId } = Astro.props;

const surah = getSurahMetaById().get(surahId);
if (surah === undefined) throw new Error(`surahs_index.json icinde ${surahId} yok.`);

const author = getDefaultAuthor();
const title = `${surah.nameTr} Suresi — Kur'an-ı Kerim`;
---

<Base
  title={title}
  description={`${surah.nameTr} suresi: ${surah.verseCount} ayet, Arapça metin ve ${author.name} meali.`}
  arabic
  reading
>
  <SurahReading surahId={surahId} authorSlug={author.slug} />
</Base>
