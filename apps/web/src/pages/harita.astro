---
import Base from "~/layouts/Base.astro";
import HaritaCanli from "~/components/HaritaCanli.astro";
import HaritaStatik from "~/components/HaritaStatik.astro";
import { getLocations } from "~/lib/data";
import { getMapGeometry } from "~/lib/harita/statik";

/**
 * Kıssa haritası — plan §2.1.
 *
 * ## Neden MapLibre değil
 *
 * Plandaki tasarım MapLibre GL kullanıyor: WebGL, ~200 KB betik ve harita
 * altlığı için üçüncü taraf tile isteği. İkisi de bugün mümkün değil —
 * sunucu CSP'si `default-src 'none'`, `script-src` tanımlı değil ve
 * `connect-src 'self'` üçüncü taraf tile'ı engelliyor (CLAUDE.md: betik
 * gerektiren öğe JS'siz karşılığıyla kurulur).
 *
 * Yerine: build zamanında üretilen STATİK SVG. Kara parçaları Natural Earth
 * 1:110m verisinden (kamu malı, data/geo/) Mercator ile çiziliyor; konumlar
 * pin olarak üstüne biniyor. Sıfır bayt JavaScript, sıfır dış istek.
 *
 * Projeksiyon ve pin hesabı 2026-09-07'de `lib/harita/statik.ts` içine,
 * çizim ise `components/HaritaStatik.astro` içine alındı: ana sayfa aynı
 * haritanın etiketsiz küçük hâlini gösteriyor ve iki kadrajın ayrışması
 * kabul edilemezdi.
 *
 * Kaybedilen: yakınlaştırma ve kaydırma. Karşılığında sayfa altındaki
 * KONUM LİSTESİ tam veriyi taşıyor — plan §12 haritalar için liste
 * alternatifini zaten zorunlu kılıyor, burada liste asıl arayüz.
 *
 * ## Güven derecesi görsel olarak da ayrışır
 *
 * DESIGN.md §1: renk tek başına anlam taşımaz. Pin biçimi de değişir:
 * kesin = dolu daire, muhtemel = halkalı, rivayet = kesikli halka.
 */

const locations = getLocations();
const { pins } = getMapGeometry();

/**
 * Enum degeri ASCII (`tartismali`), kullaniciya gosterilen metin Turkce
 * (`tartışmalı`). Ikisi ayni sey degil: slug CSS sinifi ve veri anahtari,
 * etiket ise okunacak kelime. Ilk surumde bu ayrim yapilmamis ve liste
 * cipinde ham slug goruntulenmisti — kissa sayfasi dogru yaziyordu, harita
 * sayfasi yanlis. Ayni tablo `pages/kissa/[slug].astro` icinde de var.
 */
/**
 * Yükseklik metni. Ölçüm verisi (Esri Elevation), editoryal değil.
 * Negatif değer anlamlıdır ve gizlenmez — Lût gölü −415 m, kıssanın kendisi
 * "alçalmış şehir" anlatısıyla ilgili. Türkçe eksi işareti U+2212.
 */
function metre(m: number | null): string | null {
  if (m === null) return null;
  const s = new Intl.NumberFormat("tr-TR").format(Math.abs(m));
  return `${m < 0 ? "\u2212" : ""}${s} m`;
}

const confidenceLabel = {
  kesin: "kesin",
  muhtemel: "muhtemel",
  gelenek: "gelenek",
  tartismali: "tartışmalı",
} as const;

const byConfidence = {
  kesin: locations.filter((l) => l.confidence === "kesin").length,
  muhtemel: locations.filter((l) => l.confidence === "muhtemel").length,
  gelenek: locations.filter((l) => l.confidence === "gelenek").length,
  tartismali: locations.filter((l) => l.confidence === "tartismali").length,
};
const withAlternatives = locations.filter((l) => l.alternatives.length > 0);
---

<Base
  title="Kıssa Haritası — Kur'an-ı Kerim Keşfi"
  description={`Kur'an kıssalarının geçtiği ${locations.length} yer; her birinin güven derecesi ve kaynağıyla.`}
>
  <main id="icerik" class="pg pg-wide">
    <nav aria-label="Konum" class="pg-crumb">
      <a href="/">Ana sayfa</a> <span aria-hidden="true">›</span>
      <a href="/kesfet">Keşfet</a> <span aria-hidden="true">›</span>
      <span aria-current="page">Harita</span>
    </nav>

    <header class="pg-head">
      <p class="pg-kicker">Kıssa coğrafyası</p>
      <h1 class="pg-title">Harita</h1>
      <p class="pg-lede">
        Kıssaların geçtiği yerler. <strong>Hiçbiri "işte tam burası" demez</strong> — her
        konumun ne kadar kesin olduğu yanında yazılı ve farklı görüşler gizlenmiyor.
      </p>
      <ul class="fact-row">
        <li><b>{locations.length}</b><span>konum</span></li>
        <li><b>{byConfidence.kesin}</b><span>kesin</span></li>
        <li><b>{byConfidence.muhtemel}</b><span>muhtemel</span></li>
        <li><b>{byConfidence.gelenek}</b><span>gelenek</span></li>
        <li><b>{byConfidence.tartismali}</b><span>tartışmalı</span></li>
      </ul>
    </header>

    <section>
      {/*
        Etkilesimli harita statik SVG'nin YERINE GECMEZ, ustune eklenir.
        Bilesen kendini yalnizca MapLibre gercekten yuklendiginde gosterir
        ve o an SVG'yi gizler; betik calismazsa sayfa aynen eskisi gibidir.
      */}
      <HaritaCanli
        locations={locations}
        label={`Kur'an kissalarinin gectigi ${String(pins.length)} yerin etkilesimli haritasi`}
      />
      <HaritaStatik />

      <ul class="map-legend">
        <li class="pin is-kesin"><span class="lg-mark" aria-hidden="true"></span> kesin — tartışmasız yer</li>
        <li class="pin is-muhtemel"><span class="lg-mark" aria-hidden="true"></span> muhtemel — bölge kabul, nokta kesin değil</li>
        <li class="pin is-gelenek"><span class="lg-mark" aria-hidden="true"></span> gelenek — geleneğin gösterdiği yer, teyit yok</li>
        <li class="pin is-tartismali"><span class="lg-mark" aria-hidden="true"></span> tartışmalı — birden fazla ciddi aday</li>
      </ul>
    </section>

    <section>
      <div class="sec-head">
        <h2>Konumlar</h2>
        <span class="sec-note">
          {withAlternatives.length} konumda birden fazla görüş var; hepsi yazılı
        </span>
      </div>
      <ol class="location-list">
        {
          locations.map((location) => (
            <li id={`konum-${location.slug}`}>
              <div class="lc-head">
                <h3>{location.name}</h3>
                <span class:list={["conf", `is-${location.confidence}`]}>
                  {confidenceLabel[location.confidence]}
                </span>
                {location.modernName !== null && <span class="lc-modern">{location.modernName}</span>}
                {location.country !== null && <span class="lc-country">{location.country}</span>}
                {metre(location.elevationM) !== null && (
                  <span class="lc-elev" title="Deniz seviyesinden yükseklik">
                    {metre(location.elevationM)}
                  </span>
                )}
              </div>
              <p class="lc-note">{location.sourceNote}</p>
              {location.alternatives.length > 0 && (
                <details class="lc-alts">
                  <summary>Farklı görüşler ({location.alternatives.length})</summary>
                  <ul>
                    {location.alternatives.map((alt) => (
                      <li>
                        <strong>{alt.name}</strong>
                        {metre(alt.elevationM) !== null && (
                          <span class="lc-elev">{metre(alt.elevationM)}</span>
                        )}
                        {" — "}
                        {alt.note}
                      </li>
                    ))}
                  </ul>
                </details>
              )}
              {location.stories.length > 0 && (
                <ul class="tag-list">
                  {location.stories.map((story) => (
                    <li><a href={`/kissa/${story.slug}`}>{story.title}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ol>
    </section>
  </main>
</Base>
