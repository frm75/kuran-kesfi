---
import Base from "~/layouts/Base.astro";
import RadyalAtlas from "~/components/RadyalAtlas.astro";
import { getPrincipleAreas, getPrinciplesIndex } from "~/lib/data";
import { radyalYerlesim } from "~/lib/graf";
import type { RadyalGrup, RadyalKenar } from "~/lib/graf";

/**
 * İlke listesi — plan §18.5. Her ilke en az bir birincil ayet dayanağı taşır.
 *
 * İlkeler yedi alana gruplanır (2026-09-07, principle_area tablosu). Alanlar
 * `order`'a göre sıralı gösterilir; henüz hiç ilkesi olmayan bir alan (ör.
 * "ibadet" — bu görev sırasında 0) BÖLÜM OLARAK BASILMAZ: boş/söz verici bir
 * bölüm göstermek yerine veri dolunca kendiliğinden görünür. `fact-row`
 * "alan" sayısı da aynı filtrelenmiş listeden gelir, aksi hâlde sayfa 7 alan
 * iddia edip 6 tanesini gösterirdi.
 */

const principles = getPrinciplesIndex();
const areas = getPrincipleAreas()
  .filter((a) => a.principleCount > 0)
  .sort((a, b) => a.order - b.order);
const principlesByArea = new Map<string, typeof principles>();
for (const p of principles) {
  const bucket = principlesByArea.get(p.areaSlug) ?? [];
  bucket.push(p);
  principlesByArea.set(p.areaSlug, bucket);
}
const totals = {
  primary: principles.reduce((a, p) => a + p.primaryCount, 0),
  verses: principles.reduce((a, p) => a + p.verseCount, 0),
};

/*
 * İlke atlası — görev 4 (2026-09-07), Plan 2'nin radyalYerlesim/RadyalAtlas
 * bileşenini yeniden kullanır. Yedi alan halkada, altmış dört ilke dışta;
 * ağırlık `primaryCount` (kavram atlasındaki ayet sayısının ilke karşılığı —
 * bkz. `graf.ts`'teki `agirlik` alan yorumu, aynı görsel kanal çağırana göre
 * farklı ölçek taşıyabilir).
 *
 * Alanların KENDİ sayfası yok (yalnızca ilkenin `/ilke/<slug>` sayfası var),
 * bu yüzden grup düğümleri `RadyalAtlas`'ın `grupHrefOnEk` ile aşağıdaki
 * listenin kendi bölümüne (`#<alanSlug>` capası) yönlendirilir — `hrefOnEk`
 * (ilke düğümleri için `/ilke/`) alanlara da uygulansaydı `/ilke/ibadet` gibi
 * var olmayan bir adrese, sessiz bir 404'e çıkardı.
 */
const gruplar: RadyalGrup[] = areas.map((area) => ({
  slug: area.slug,
  label: area.nameTr,
  cocuklar: (principlesByArea.get(area.slug) ?? []).map((p) => ({
    slug: p.slug,
    label: p.nameTr,
    agirlik: p.primaryCount,
  })),
}));

/*
 * Kenarlar: YALNIZCA emir/nehiy çiftleri (`contrast`, `curated` — platform
 * kendi ilkesini icat etmez, plan §CLAUDE.md kural 4). Karşılıklı bir çift
 * TEK kenar sayılır — `oppositeSlug` her iki yönde de yazıldığı için (linter
 * bunu denetler, bkz. `scripts/build/linter.ts`) sıralanmış slug çiftiyle
 * anahtarlanıp yinelenmez; aksi hâlde her çift iki kez çizilir, bu da daha
 * önce (kavram atlasında) komşuların slug'a göre değil dizideki sıraya göre
 * eşlenmesinden doğan yüzen düğüm hatasının aynısını doğururdu.
 */
const gorulenCiftler = new Set<string>();
const kenarlar: RadyalKenar[] = [];
for (const p of principles) {
  if (p.oppositeSlug === null) continue;
  const anahtar = [p.slug, p.oppositeSlug].sort().join("|");
  if (gorulenCiftler.has(anahtar)) continue;
  gorulenCiftler.add(anahtar);
  kenarlar.push({ a: p.slug, b: p.oppositeSlug, type: "contrast", weight: 1, origin: "curated" });
}

const yerlesim = radyalYerlesim({ boyut: 900, gruplar, kenarlar });
---

<Base
  title="İlkeler — Kur'an-ı Kerim Keşfi"
  description={`Kur'an'ın doğrudan emrettiği ${principles.length} ilke; dayanak ayetleri ve kaynaklarıyla.`}
>
  <main id="icerik" class="pg pg-wide">
    <nav aria-label="Konum" class="pg-crumb">
      <a href="/">Ana sayfa</a> <span aria-hidden="true">›</span>
      <a href="/anla">Anla</a> <span aria-hidden="true">›</span>
      <span aria-current="page">İlkeler</span>
    </nav>

    <header class="pg-head">
      <p class="pg-kicker">Anla</p>
      <h1 class="pg-title">İlkeler</h1>
      <p class="pg-lede">
        Kur'an'ın doğrudan emrettiği ya da tavsiye ettiği ahlâkî ilkeler. Her ilkenin
        <strong>birincil</strong> dayanağı doğrudan emir içeren ayettir; <strong>ikincil</strong>
        dayanaklar ilkeyi örnekleyen ayetlerdir. Platform kendi ilkesini icat etmez.
      </p>
      <ul class="fact-row">
        <li><b>{principles.length}</b><span>ilke</span></li>
        <li><b>{totals.primary}</b><span>birincil dayanak</span></li>
        <li><b>{totals.verses}</b><span>ayet bağı</span></li>
        <li><b>{areas.length}</b><span>alan</span></li>
      </ul>
    </header>

    <RadyalAtlas
      yerlesim={yerlesim}
      baslik="İlke atlası"
      aciklama={`${String(principles.length)} ilke, ${String(gruplar.length)} alan altında; çemberin içinden geçen ${String(kenarlar.length)} çizgi, Kur'an'ın aynı bağlamda karşı karşıya koyduğu emir/nehiy çiftlerini gösterir. İlkelerin tamamı aşağıda liste hâlinde var; her çiftin bağı ilgili ilkenin kendi sayfasında "karşıtı" olarak da görünür.`}
      hrefOnEk="/ilke/"
      grupHrefOnEk="/ilkeler#"
      idOnEk="ilke-atlas"
    />
    <p class="atlas-not">
      Bu bölümleme platform derlemesidir; ilkelerin kendisi ve dayanak ayetleri
      kaynağa dayalıdır. İlkelerin tamamı aşağıda liste hâlinde var; grafikteki{" "}
      {kenarlar.length} çift Kur'an'ın açıkça karşı karşıya koyduğu emir/nehiy
      ilkeleridir — zorlanmış bir eşleştirme değildir, karşıtı olmayan ilkede bu
      bağ hiç kurulmaz.
    </p>

    {
      areas.map((area) => (
        <section id={area.slug} class="ilke-alan">
          <div class="sec-head">
            <h2>{area.nameTr}</h2>
            <span class="sec-note">{area.definition}</span>
          </div>
          <ol class="principle-grid">
            {
              (principlesByArea.get(area.slug) ?? []).map((principle) => (
                <li>
                  <a href={`/ilke/${principle.slug}`}>
                    <span class="pn-head">
                      <span class="pn-name">{principle.nameTr}</span>
                      {principle.nameAr !== null && (
                        <span class="pn-ar" lang="ar" dir="rtl">
                          {principle.nameAr}
                        </span>
                      )}
                    </span>
                    <span class="pn-def">{principle.definition}</span>
                    <span class="pn-meta">
                      {principle.primaryCount} birincil
                      <span aria-hidden="true"> · </span>
                      {principle.verseCount} ayet
                    </span>
                  </a>
                </li>
              ))
            }
          </ol>
        </section>
      ))
    }
  </main>
</Base>
