---
import Base from "~/layouts/Base.astro";
import IbadetSekmeleri from "~/components/IbadetSekmeleri.astro";
import IbadetKonum from "~/components/IbadetKonum.astro";
---

<Base
  title="İmsakiye — Kur'an-ı Kerim Keşfi"
  description="Aylık imsakiye tablosu; vakitler cihazda hesaplanır."
>
  <main id="icerik" class="pg pg-normal">
    <nav aria-label="Konum" class="pg-crumb">
      <a href="/">Ana sayfa</a> <span aria-hidden="true">›</span>
      <span aria-current="page">İmsakiye</span>
    </nav>
    <header class="pg-head">
      <p class="pg-kicker">İbadet</p>
      <h1 class="pg-title">İmsakiye</h1>
    </header>
    <IbadetSekmeleri aktif="/ibadet/imsakiye" />
    <noscript><p class="g-warn">Bu araç tarayıcınızda JavaScript gerektirir.</p></noscript>
    <IbadetKonum />
    <section id="ib-imsakiye" hidden>
      <h2 class="ib-h2" id="ib-imsakiye-baslik" aria-live="polite"></h2>
      <div class="ib-ay-gez">
        <button type="button" class="g-btn" id="ib-onceki">Önceki ay</button>
        <button type="button" class="g-btn" id="ib-sonraki">Sonraki ay</button>
      </div>
      <div class="ib-tablo-kap">
        <table class="ib-tablo" id="ib-imsakiye-tablo"></table>
      </div>
      <p class="sec-note">Hesaplama: Diyanet yöntemi (adhan kütüphanesi). Diyanet'in yayımladığı vakitlerle 1-2 dakika fark olabilir.</p>
    </section>
  </main>
</Base>

<script>
  import "~/lib/ibadet/sayfa/imsakiye";
</script>
