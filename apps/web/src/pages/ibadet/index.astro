---
import Base from "~/layouts/Base.astro";
import IbadetSekmeleri from "~/components/IbadetSekmeleri.astro";
import IbadetKonum from "~/components/IbadetKonum.astro";
---

<Base
  title="Namaz vakitleri — Kur'an-ı Kerim Keşfi"
  description="Bulunduğunuz yerin namaz vakitleri ve sıradaki vakte kalan süre; hesaplama cihazda yapılır."
>
  <main id="icerik" class="pg pg-normal">
    <nav aria-label="Konum" class="pg-crumb">
      <a href="/">Ana sayfa</a> <span aria-hidden="true">›</span>
      <span aria-current="page">Namaz vakitleri</span>
    </nav>
    <header class="pg-head">
      <p class="pg-kicker">İbadet</p>
      <h1 class="pg-title">Namaz vakitleri</h1>
    </header>
    <IbadetSekmeleri aktif="/ibadet" />
    <noscript><p class="g-warn">Bu araç tarayıcınızda JavaScript gerektirir.</p></noscript>
    <IbadetKonum />
    <section id="ib-vakitler" hidden aria-label="Bugünün vakitleri">
      <p class="ib-sayac" id="ib-sayac" role="timer" aria-live="off"></p>
      <ul class="ib-vakitler" id="ib-vakit-liste"></ul>
      <p class="sec-note">Hesaplama: Diyanet yöntemi (adhan kütüphanesi). Diyanet'in yayımladığı vakitlerle 1-2 dakika fark olabilir.</p>
    </section>
  </main>
</Base>

<script>
  import "~/lib/ibadet/sayfa/index";
</script>
