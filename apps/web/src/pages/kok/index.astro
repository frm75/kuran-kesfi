---
import Base from "~/layouts/Base.astro";
import { getRootsIndex } from "~/lib/data";

/**
 * Kök listesi — plan §2 "Kelime" kapısı.
 *
 * 1641 kök, geçiş sayısına göre sıralı. Kök adresleri Arapça harflerle
 * kurulur (/kok/قول): Latin çevriyazı büyük-küçük harf anlamlı (S=ص, s=س)
 * ve küçültüldüğünde 141 kök çakışıyor, adres olarak kullanılamaz.
 *
 * Kaynak rozeti 2026-09-05'te kaldırıldı; atıf <Attribution> ve /kaynaklar'da
 * duruyor (data/LICENSE).
 */

const { roots, totals } = getRootsIndex();

const withoutRoot = totals.words - totals.wordsWithRoot;
const percent = Math.round((totals.wordsWithRoot / totals.words) * 100);

/** En çok geçen 50 — hızlı giriş. */
const mostFrequent = roots.slice(0, 50);

/**
 * Alfabetik gruplar.
 *
 * 1641 kartlık tek liste taranamıyor. Kökler ilk harfe göre gruplanıp harf
 * çubuğuyla geziliyor — JavaScript gerekmiyor, çapa bağlantıları yetiyor.
 */
const byLetter = new Map<string, typeof roots>();
for (const root of [...roots].sort((a, b) => a.arabic.localeCompare(b.arabic, "ar"))) {
  const letter = [...root.arabic][0] ?? "?";
  const bucket = byLetter.get(letter) ?? [];
  bucket.push(root);
  byLetter.set(letter, bucket);
}
const letterGroups = [...byLetter.entries()].sort((a, b) => a[0].localeCompare(b[0], "ar"));
---

<Base
  title="Kökler — Kur'an-ı Kerim Keşfi"
  description={`Kur'an'da geçen ${totals.roots} kök ve ${totals.wordsWithRoot} kelime bağlantısı.`}
  arabic
>
  <main id="icerik" class="pg pg-wide">
    <nav aria-label="Konum" class="pg-crumb">
      <a href="/">Ana sayfa</a> <span aria-hidden="true">›</span>
      <span aria-current="page">Kökler</span>
    </nav>

    <header class="pg-head">
      <p class="pg-kicker">IV. Kapı — Kelime</p>
      <h1 class="pg-title">Kökler</h1>
      <p class="pg-lede">
        Arapça'da kelimeler üç harfli köklerden türer. Aynı kökten gelen kelimeler
        anlamca akrabadır; kökü takip etmek Kur'an'ın kendi iç bağlarını gösterir.
      </p>
      <ul class="fact-row">
        <li><b>{totals.roots}</b><span>kök</span></li>
        <li><b>{totals.words}</b><span>kelime</span></li>
        <li><b>%{percent}</b><span>köke bağlı</span></li>
      </ul>
      <p class="text-text-muted mt-3 text-sm">
        {withoutRoot} kelimeye kök atanmamış — harf-i cerler, zamirler ve özel
        adların çoğu. Eksiklik gizlenmiyor: o kelimeler kelime kelime görünümde
        bağlantısız gösteriliyor.
      </p>
    </header>

    <div class="sec-head">
      <h2>En çok geçen 50 kök</h2>
      <span class="sec-note">Kur'an'ın omurgasını kuran kelimeler</span>
    </div>
    <ol class="root-grid">
      {
        mostFrequent.map((root) => (
          <li>
            <a href={`/kok/${root.arabic}`}>
              <span class="r-head">
                <span lang="ar" dir="rtl" class="r-arabic">
                  {root.arabic}
                </span>
                <span class="r-count">{root.occurrenceCount}</span>
              </span>
              <span class="r-latin">{root.latin}</span>
              {root.meaningSummary && <span class="r-meaning">{root.meaningSummary}</span>}
            </a>
          </li>
        ))
      }
    </ol>

    <div class="sec-head">
      <h2>Alfabetik</h2>
      <span class="sec-note">{totals.roots} kök, ilk harfe göre</span>
    </div>
    <nav aria-label="Harfe git" class="letter-bar">
      {
        letterGroups.map(([letter]) => (
          <a href={`#harf-${encodeURIComponent(letter)}`} lang="ar" dir="rtl">
            {letter}
          </a>
        ))
      }
    </nav>

    {
      letterGroups.map(([letter, group]) => (
        <section id={`harf-${letter}`} class="mt-8 scroll-mt-4">
          <h3 class="border-border m-0 border-b pb-2 text-lg">
            <span lang="ar" dir="rtl">
              {letter}
            </span>
            <span class="text-text-muted ms-2 text-sm">({group.length})</span>
          </h3>
          <ol class="root-list mt-3">
            {group.map((root) => (
              <li>
                <a href={`/kok/${root.arabic}`}>
                  <span lang="ar" dir="rtl" class="rl-arabic">
                    {root.arabic}
                  </span>
                  <span class="rl-latin">{root.latin}</span>
                  <span class="rl-count">{root.occurrenceCount}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </main>
</Base>
