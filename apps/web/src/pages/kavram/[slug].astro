---
import type { GetStaticPaths } from "astro";
import Base from "~/layouts/Base.astro";
import RadyalAtlas from "~/components/RadyalAtlas.astro";
import { getConcept, getConceptsIndex, getDefaultAuthor, getVerseText } from "~/lib/data";
import { radyalYerlesim } from "~/lib/graf";
import type { RadyalGrup, RadyalKenar } from "~/lib/graf";

/**
 * Tek kavram — plan §2.4, §12.3 "kavramın Kur'an içindeki dağılımı".
 *
 * Dağılım gerçek veriden hesaplanır. Mekke/Medine oranı SURE bazlıdır: ayet
 * bazlı nüzul verisi yok, o yüzden sayfada da böyle yazılır (plan §1.5).
 *
 * Ayet listesi ağırlığa göre sıralı ve İLK 60 ile sınırlı — "iman" 879 ayette
 * geçiyor, hepsini meal metniyle basmak sayfayı 1 MB yapardı. Kesildiği
 * kullanıcıya yazılır, sessizce kırpılmaz.
 */

export const getStaticPaths = (() =>
  getConceptsIndex().map((c) => ({ params: { slug: c.slug } }))) satisfies GetStaticPaths;

const LIMIT = 60;

const { slug } = Astro.params;
if (slug === undefined) throw new Error("kavram slug yok");
const concept = getConcept(slug);
const author = getDefaultAuthor();

const shown = concept.verses.slice(0, LIMIT);
const hidden = concept.verses.length - shown.length;

const relationLabel = {
  co_occurrence: "birlikte geçer",
  cause: "sebep-sonuç",
  contrast: "zıt",
  part_of: "parçası",
} as const;

const total = concept.stats.mekki + concept.stats.medeni;
const mekkiPercent = total === 0 ? 0 : Math.round((concept.stats.mekki / total) * 100);

/** En çok geçtiği 12 sure — dağılım çubuğu için. */
const topSurahs = [...concept.stats.bySurah].sort((a, b) => b.count - a.count).slice(0, 12);
const maxCount = topSurahs[0]?.count ?? 1;

/*
 * Ego-graf — plan Task 6. Kavram merkezde, en güçlü 6 komşusu tek halkada.
 * `radyalYerlesim` yeniden kullanılıyor: merkezdeki kavram tek elemanlı bir
 * "grup", komşular onun çocukları.
 *
 * `concept.relations` KIRPILMAMIŞ tam listeyi taşır (dizin dosyası —
 * `concepts_index.json` — kırpar, kavram dosyası kırpmaz; bkz.
 * `scripts/build/lib/content.ts`). Dizi tipe göre gruplu, tip içinde
 * ağırlığa göre azalan sırada (`.sort((a,b) => tip esitse agirlik, degilse
 * tip)`) — yani düz `.slice(0, 6)` "en güçlü 6" DEĞİL, "alfabetik ilk tipin
 * en güçlüleri" demek. Ölçüldü: `adalet`'te bu, en güçlü bağlardan biri olan
 * `zulum` (contrast, ağırlık 3 — adalet/zulüm zıt çifti) tamamen dışarıda
 * kalıyor çünkü "contrast" tipi alfabetik olarak "co_occurrence"tan sonra
 * geliyor. `iman`'da da aynı sorun: `takva`/`emanet`/`tevekkul` (part_of)
 * tamamen kayboluyor.
 *
 * Bu yüzden burada AYRI bir sıralama yapılıyor: önce kaynak (curated her
 * zaman computed'tan önce — insan kararı istatistiğe feda edilmez, dizin
 * dosyasındaki kuralla aynı ilke), sonra ağırlığa göre azalan, sonra slug
 * (belirlilik için). İlk 6 bu sıradan alınır. `adalet` için sonuç artık
 * `zulum`'u içeriyor; `iman` için `sirk`/`takva`/`emanet` de giriyor.
 */
const komsular = [...concept.relations]
  .sort((a, b) => {
    if (a.origin !== b.origin) return a.origin === "curated" ? -1 : 1;
    return b.weight - a.weight || a.slug.localeCompare(b.slug);
  })
  .slice(0, 6);

const egoGruplar: RadyalGrup[] = [
  {
    slug: concept.slug,
    label: concept.nameTr,
    cocuklar: komsular.map((r) => ({ slug: r.slug, label: r.nameTr, agirlik: r.weight })),
  },
];
const egoKenarlar: RadyalKenar[] = komsular.map((r) => ({
  a: concept.slug,
  b: r.slug,
  type: r.type,
  weight: r.weight,
  origin: r.origin,
}));
// boyut=420 ölçüldü: 109 kavramın tümünde (1..~12 komşu, ilk 6'ya kırpılmış)
// tek bir düğüm çifti bile çakışmıyor — bkz. görev raporu.
const egoYerlesim = radyalYerlesim({ boyut: 420, gruplar: egoGruplar, kenarlar: egoKenarlar });
---

<Base
  title={`${concept.nameTr} — Kavram — Kur'an-ı Kerim Keşfi`}
  description={concept.definition.slice(0, 160)}
  arabic
  reading
>
  <main id="icerik" class="pg pg-normal">
    <nav aria-label="Konum" class="pg-crumb">
      <a href="/">Ana sayfa</a> <span aria-hidden="true">›</span>
      <a href="/kavramlar">Kavramlar</a> <span aria-hidden="true">›</span>
      {concept.parent !== null && (
        <>
          <a href={`/kavram/${concept.parent.slug}`}>{concept.parent.nameTr}</a>
          <span aria-hidden="true">›</span>
        </>
      )}
      <span aria-current="page">{concept.nameTr}</span>
    </nav>

    <header class="pg-head">
      <p class="pg-kicker">Kavram</p>
      <h1 class="pg-title">
        {concept.nameTr}
        {concept.nameAr !== null && (
          <span lang="ar" dir="rtl" class="pg-title-ar">{concept.nameAr}</span>
        )}
      </h1>
      <p class="pg-lede">{concept.definition}</p>
      <ul class="chip-row">
        <li class="chip is-accent"><b>{concept.stats.verseCount}</b> ayet</li>
        <li class="chip"><b>{concept.stats.surahCount}</b> sure</li>
        {
          concept.roots.map((root) => (
            <li class="chip">
              kök <a href={`/kok/${root.arabic}`} lang="ar" dir="rtl">{root.arabic}</a>
            </li>
          ))
        }
      </ul>
    </header>

    {
      concept.stats.verseCount > 0 && (
        <section>
          <div class="sec-head">
            <h2>Kur'an'daki dağılımı</h2>
            <span class="sec-note">Kök geçişlerinden hesaplandı</span>
          </div>
          <p class="dist-note">
            Ayetlerin <strong>%{mekkiPercent}</strong>'i Mekke, <strong>%{100 - mekkiPercent}</strong>'i
            Medine surelerinde. <span class="text-text-muted">
              Oran <em>sure</em> bazlıdır: ayet bazlı nüzul verisi kaynakta yok, bu yüzden
              karma surelerde ayrım yapılamıyor.
            </span>
          </p>
          <ol class="dist-bars">
            {topSurahs.map((surah) => (
              <li>
                <a href={`/${surah.slug}`}>{surah.nameTr}</a>
                <span class="db-track">
                  <span class="db-fill" style={`width:${String(Math.round((surah.count / maxCount) * 100))}%`} />
                </span>
                <span class="db-count">{surah.count}</span>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      concept.relations.length > 0 && (
        <section>
          <div class="sec-head">
            <h2>Bağlı kavramlar</h2>
            <span class="sec-note">
              Bu bağların bir kısmı kaynaklardan derlendi, bir kısmı iki kavramın ortak
              ayetlerinden hesaplandı. Hesaplananlar <em>hesaplanmış</em> etiketiyle
              işaretlidir; etiketsiz olanlar kaynağa dayanır.
            </span>
          </div>
          <RadyalAtlas
            yerlesim={egoYerlesim}
            baslik={`${concept.nameTr} ve en güçlü ${String(komsular.length)} komşusu`}
            aciklama={`Merkezde ${concept.nameTr}, çevresinde en güçlü ${String(komsular.length)} bağlı kavram; elle yazılmış bağlar ağırlığından bağımsız önce gelir, kalan yer en ağırlıklı hesaplananlarla doldurulur. Aynı veri altta liste hâlinde de var.`}
            hrefOnEk="/kavram/"
          />
          <ul class="rel-list">
            {concept.relations.map((rel) => (
              <li>
                <a href={`/kavram/${rel.slug}`}>{rel.nameTr}</a>
                <span class:list={["rel-type", `is-${rel.type}`]}>{relationLabel[rel.type]}</span>
                {rel.origin === "computed" && (
                  <span class="rel-origin" title="Bu bağ iki kavramın ortak ayetlerinden hesaplandı; bir kaynağın kurduğu bağ değildir.">
                    hesaplanmış
                  </span>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      shown.length > 0 && (
        <section>
          <div class="sec-head">
            <h2>Geçtiği ayetler</h2>
            <span class="sec-note">
              {hidden > 0
                ? `En yoğun ${String(shown.length)} ayet gösteriliyor, ${String(hidden)} ayet daha var`
                : `${String(shown.length)} ayet`} · meal: {author.name}
            </span>
          </div>
          <ol class="ref-list">
            {shown.map((verse) => (
              <li>
                <a class="rf-ref" href={`/${verse.surahSlug}/${String(verse.verseNumber)}`}>
                  {verse.surahNameTr} {verse.verseNumber}
                </a>
                <span class:list={["rf-weight", `is-w${String(verse.weight)}`]}>
                  {verse.weight === 3 ? "merkezî" : verse.weight === 2 ? "belirgin" : "geçiyor"}
                </span>
                <p class="rf-text">
                  {getVerseText(verse.surahId, verse.verseNumber, author.slug) ??
                    "Bu ayetin bu mealde karşılığı kaynakta yok."}
                </p>
              </li>
            ))}
          </ol>
          {hidden > 0 && (
            <p class="text-text-muted mt-4 text-sm">
              Kalan {hidden} ayet için kök sayfasına bakın:{" "}
              {concept.roots.map((root) => (
                <a href={`/kok/${root.arabic}`} lang="ar" dir="rtl" class="ms-2">{root.arabic}</a>
              ))}
            </p>
          )}
        </section>
      )
    }

    {
      (concept.stories.length > 0 || concept.principles.length > 0 || concept.children.length > 0) && (
        <section>
          <div class="sec-head"><h2>Bağlantılar</h2></div>
          <div class="link-groups">
            {concept.children.length > 0 && (
              <div>
                <h3>Alt kavramlar</h3>
                <ul class="tag-list">
                  {concept.children.map((c) => (
                    <li><a href={`/kavram/${c.slug}`}>{c.nameTr}</a></li>
                  ))}
                </ul>
              </div>
            )}
            {concept.principles.length > 0 && (
              <div>
                <h3>İlkeler</h3>
                <ul class="tag-list">
                  {concept.principles.map((p) => (
                    <li><a href={`/ilke/${p.slug}`}>{p.nameTr}</a></li>
                  ))}
                </ul>
              </div>
            )}
            {concept.stories.length > 0 && (
              <div>
                <h3>Kıssalar</h3>
                <ul class="tag-list">
                  {concept.stories.map((s) => (
                    <li><a href={`/kissa/${s.slug}`}>{s.title}</a></li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      )
    }
  </main>
</Base>
