---
import type { GetStaticPaths } from "astro";
import Base from "~/layouts/Base.astro";
import Translation from "~/components/Translation.astro";
import VerseArabic from "~/components/VerseArabic.astro";
import WordByWord from "~/components/WordByWord.astro";
import {
  getAuthorsIndex,
  getDefaultAuthor,
  getPassageVerses,
  getVerseSections,
  getRelatedVerses,
  getSurahsIndex,
  getVerseDetail,
  getVerseText,
  getVerseWords,
  getVerseConnections,
  sortAuthorsForDisplay,
  verseLabel,
} from "~/lib/data";

/**
 * Tek ayet sayfası — plan §12.4 (ayet paneli) ve §2.3 (meal karşılaştırma).
 *
 * Sure sayfası tek meal gösterir; burada ayetin BÜTÜN mealleri yan yana durur.
 * Plan §1.4 ve CLAUDE.md kural 4: farklı görüşler tek doğru gibi sunulmaz,
 * yan yana verilir. Sıra Türkçe mealler önce, sonra İngilizce.
 *
 * 6236 sayfa üretilir. JavaScript yok.
 *
 * ## 2026-09-05 düzeni
 *
 * Dört kaynak rozeti kaldırıldı (kullanıcı kararı). Yasal atıf kaybolmadı:
 * her mealin sahibi kendi bloğunun başlığında, <Attribution> her sayfanın
 * altında, tam döküm /kaynaklar'da (data/LICENSE, CC BY-NC-SA 4.0).
 *
 * Mealler tek sütun yerine ızgarada: 20+ meal alt alta 15 ekran sürüyordu,
 * geniş ekranda iki sütuna açılınca yarıya iniyor (.meal-grid).
 */

export const getStaticPaths = (() => {
  return getSurahsIndex().surahs.flatMap((surah) =>
    Array.from({ length: surah.verseCount }, (_unused, offset) => ({
      params: { surah: surah.slug, verse: String(offset + 1) },
      props: { surahId: surah.id, verseNumber: offset + 1 },
    })),
  );
}) satisfies GetStaticPaths;

const { surahId, verseNumber } = Astro.props;

const verse = getVerseDetail(surahId, verseNumber);
const surahMeta = getSurahsIndex().surahs.find((item) => item.id === surahId);
if (surahMeta === undefined) throw new Error(`surahs_index.json icinde ${surahId} yok`);

const label = verseLabel(verse.surahNameTr, verse.verseNumber);
const verseWords = getVerseWords(surahId, verseNumber);

/**
 * Keşif ağı bağları — plan §12.4: "ayet, bilgi ağının merkezidir".
 *
 * verse_links.json bir kez okunur (data.ts `once`), 6236 sayfa aynı nesneyi
 * kullanır. Bağı olmayan ayette bölüm hiç çizilmez.
 */
const links = getVerseConnections(surahId, verseNumber);
const hasLinks =
  links.stories.length + links.principles.length + links.concepts.length + links.events.length > 0;

/**
 * İlgili ayetler — plan §12.5.
 *
 * Bağlar AI önerisi değil sayımdır: iki ayetin aynı kıssayı, olayı, kökü ya da
 * kavramı gerçekten paylaşıp paylaşmadığı sayılır (scripts/import/lib/relations.ts).
 * Gerekçe her satırda yazar; kavram üzerinden kurulan bağ "olası" etiketiyle
 * ayrılır çünkü kavram–ayet eşleştirmesinin kendisi kökten türetilmiştir.
 *
 * Meal parçası öntanımlı mealden alınır — hangi ayete gittiğini görmeden
 * bağlantıya tıklamak zorunda kalınmaz.
 */
const related = getRelatedVerses(surahId, verseNumber);
const defaultAuthor = getDefaultAuthor();

/** Kelime ortasında kesmez; kesildiyse üç nokta koyar. */
function excerpt(text: string | null, limit = 150): string | null {
  if (text === null) return null;
  const clean = text.trim();
  if (clean.length <= limit) return clean;
  const cut = clean.slice(0, limit);
  const lastSpace = cut.lastIndexOf(" ");
  return `${(lastSpace > limit * 0.6 ? cut.slice(0, lastSpace) : cut).trimEnd()}…`;
}

const relatedRows = related.map((row) => ({
  ...row,
  excerpt: excerpt(getVerseText(row.surahId, row.verseNumber, defaultAuthor.slug)),
}));

/**
 * Bağlam penceresi — plan §12.1: "önceki 3 ayet, seçilen ayet, sonraki 3 ayet".
 *
 * Amaç planın kendi cümlesi: "ayetin bağlamından kopuk değerlendirilmesini
 * azaltmak". Tek ayet sayfasına doğrudan gelen okur, o ayetin neyin ortasında
 * durduğunu görmeden okuyup gidebiliyordu.
 *
 * Sure başında ve sonunda pencere kısalır; eksik tarafa boş satır konmaz.
 *
 * Konu başlığı (§12.1: "sure içindeki konu başlığı, önceki/sonraki konu")
 * bölümlemesi OLAN surelerde pencerenin üstünde durur. Bölümlemesi olmayan
 * surede hiç çizilmez — boş başlık göstermek belirsizliği saklamak olurdu.
 */
const CONTEXT_RADIUS = 3;
const contextStart = Math.max(1, verse.verseNumber - CONTEXT_RADIUS);
const contextEnd = Math.min(surahMeta.verseCount, verse.verseNumber + CONTEXT_RADIUS);
const contextVerses = getPassageVerses(surahId, contextStart, contextEnd, defaultAuthor.slug);
const topic = getVerseSections(surahId, verse.verseNumber);

/*
 * Bazı mealler ayetleri BİRLİKTE veriyor: Diyanet, Fâtiha 2-4'ü ve Nâs 1-6'yı
 * tek metin olarak yazıp her ayete aynı metni koyuyor. Ham liste bunu aynı
 * cümleyi altı kez basarak gösteriyordu — kaynağın kendi tercihi, ama ekranda
 * hata gibi duruyor ve pencerenin işini bozuyor.
 *
 * Ardışık ve metni AYNI olan satırlar tek satırda toplanıp aralık olarak
 * yazılıyor ("2-4"). Metin değiştirilmiyor, yalnızca tekrarı kaldırılıyor.
 */
interface ContextGroup {
  from: number;
  to: number;
  text: string | null;
  hasCurrent: boolean;
}

const contextGroups: ContextGroup[] = [];
for (const row of contextVerses) {
  const last = contextGroups[contextGroups.length - 1];
  const isCurrent = row.verseNumber === verse.verseNumber;
  if (last !== undefined && last.text !== null && last.text === row.translation) {
    last.to = row.verseNumber;
    last.hasCurrent = last.hasCurrent || isCurrent;
  } else {
    contextGroups.push({
      from: row.verseNumber,
      to: row.verseNumber,
      text: row.translation,
      hasCurrent: isCurrent,
    });
  }
}

const authorBySlug = new Map(getAuthorsIndex().authors.map((author) => [author.slug, author]));
const orderedSlugs = sortAuthorsForDisplay(verse.translations.map((item) => item.authorSlug));
const translationBySlug = new Map(verse.translations.map((item) => [item.authorSlug, item]));

interface Row {
  slug: string;
  name: string;
  language: string;
  text: string;
  footnotes: { number: number; text: string }[];
}

const rows: Row[] = orderedSlugs.flatMap((slug) => {
  const item = translationBySlug.get(slug);
  const author = authorBySlug.get(slug);
  // İkisinden biri yoksa veri tutarsızdır; linter bunu yakalar. Burada sessizce
  // atlamak yerine atlanan sayılır ve aşağıda kontrol edilir.
  if (item === undefined || author === undefined) return [];
  return [
    {
      slug,
      name: item.authorName,
      language: author.language,
      text: item.text,
      footnotes: [...item.footnotes],
    },
  ];
});

if (rows.length !== verse.translations.length) {
  throw new Error(
    `${label}: ${verse.translations.length} meal var ama ${rows.length} tanesinin ` +
      "yazar kaydi authors_index.json icinde bulundu. Veri tutarsiz.",
  );
}

const turkish = rows.filter((row) => row.language === "tr");
const other = rows.filter((row) => row.language !== "tr");

const previous = verse.verseNumber > 1 ? verse.verseNumber - 1 : null;
const next = verse.verseNumber < surahMeta.verseCount ? verse.verseNumber + 1 : null;

const title = `${verse.surahNameTr} ${verse.verseNumber} — ${turkish.length} meal`;
---

<Base
  title={title}
  description={`${label}. Arapça metin ve ${rows.length} farklı meal yan yana.`}
  arabic
  reading
>
  <main id="icerik" class="pg pg-wide">
    <nav aria-label="Konum" class="pg-crumb">
      <a href="/">Ana sayfa</a> <span aria-hidden="true">›</span>
      <a href="/sureler">Sureler</a> <span aria-hidden="true">›</span>
      <a href={`/${verse.surahSlug}`}>{verse.surahNameTr}</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{verse.verseNumber}. ayet</span>
    </nav>

    <header class="pg-head">
      <p class="pg-kicker">{verse.surahNameTr} suresi</p>
      <h1 class="pg-title">{label}</h1>

      <ul class="chip-row">
        <li class="chip">sayfa <b>{verse.page}</b></li>
        <li class="chip">cüz <b>{verse.juz}</b></li>
        <li class="chip is-accent"><b>{turkish.length}</b> Türkçe meal</li>
        {other.length > 0 && <li class="chip"><b>{other.length}</b> İngilizce çeviri</li>}
      </ul>

      <div class="mt-6">
        <VerseArabic
          text={verse.textUthmani}
          verseNumber={verse.verseNumber}
          label={label}
          sajda={verse.sajda}
          large
        />
      </div>

      {
        /* Kaynakta eksikse satır hiç çizilmez — boş başlık gösterilmez. */
        verse.transcriptionTr !== null && (
          <p lang="tr" class="transcription">
            {verse.transcriptionTr}
          </p>
        )
      }
    </header>

    {
      contextVerses.length > 1 && (
        <section>
          <div class="sec-head">
            <h2>Bağlam</h2>
            <span class="sec-note">
              {verse.surahNameTr} {contextStart}–{contextEnd} · surenin{" "}
              {verse.verseNumber}. ayeti / {surahMeta.verseCount}
            </span>
          </div>
          {topic !== null && (
            <div class="ctx-topic">
              <p class="ctx-topic-name">
                <span class="ctx-topic-label">Konu</span>
                {topic.main.title}
                <span class="ctx-topic-range">
                  {verse.surahNameTr} {topic.main.verseStart}–{topic.main.verseEnd}
                </span>
              </p>
              {topic.main.note !== null && <p class="ctx-topic-note">{topic.main.note}</p>}
              {topic.also.length > 0 && (
                <p class="ctx-topic-note">
                  Bu ayet ayrıca şu konuya da giriyor:{" "}
                  {topic.also.map((x) => x.title).join(", ")}
                </p>
              )}
              <nav class="ctx-topic-nav" aria-label="Konular arası gezinme">
                {topic.previous === null ? (
                  <span />
                ) : (
                  <a href={`/${verse.surahSlug}/${String(topic.previous.verseStart)}`}>
                    <span aria-hidden="true">←</span> {topic.previous.title}
                  </a>
                )}
                <span class="ctx-topic-pos">
                  {topic.main.order}. konu / {topic.total}
                </span>
                {topic.next === null ? (
                  <span />
                ) : (
                  <a href={`/${verse.surahSlug}/${String(topic.next.verseStart)}`}>
                    {topic.next.title} <span aria-hidden="true">→</span>
                  </a>
                )}
              </nav>
              {/* Başlığın nereden geldiği gizlenmez — plan §1.5, §12.15. */}
              <p class="ctx-origin">
                {topic.origin === "platform"
                  ? "Konu başlıkları platform derlemesidir; bir tefsirden alınmamıştır."
                  : "Konu başlıkları kaynaktan alınmıştır."}
              </p>
            </div>
          )}

          <ol class="ctx-list">
            {contextGroups.map((row) => {
              const label = row.from === row.to ? String(row.from) : `${row.from}–${row.to}`;
              return (
                <li class:list={["ctx-row", row.hasCurrent && "is-current"]}>
                  {row.hasCurrent ? (
                    <span class="ctx-num" aria-current="true">
                      {label}
                    </span>
                  ) : (
                    <a class="ctx-num" href={`/${verse.surahSlug}/${String(row.from)}`}>
                      <span class="sr-only">{verse.surahNameTr} </span>
                      {label}
                    </a>
                  )}
                  <p class="ctx-text">
                    {row.text ?? <span class="ctx-missing">Bu ayetin meali kaynakta yok.</span>}
                  </p>
                </li>
              );
            })}
          </ol>
          <p class="sec-note mt-3">
            Bağlam metinleri {defaultAuthor.name} mealindendir; bu ayetin bütün
            mealleri aşağıdadır. Birleşik numaralar ({defaultAuthor.name} bu
            ayetleri tek metin olarak veriyor) aralık olarak yazılır.
          </p>
        </section>
      )
    }

    {
      verseWords !== null && (
        <section>
          <div class="sec-head">
            <h2>Kelimeler</h2>
            <span class="sec-note">
              Kök bağlantısı o kökün Kur'an'daki bütün geçişlerine götürür.
            </span>
          </div>
          <WordByWord words={verseWords.words} label={label} />
        </section>
      )
    }

    {
      hasLinks && (
        <section>
          <div class="sec-head">
            <h2>Bu ayet neye bağlı</h2>
            <span class="sec-note">Kıssa, ilke, kavram ve nüzul dönemi</span>
          </div>
          <div class="link-groups">
            {links.stories.length > 0 && (
              <div>
                <h3>Kıssa</h3>
                <ul class="tag-list">
                  {links.stories.map((story) => (
                    <li>
                      <a href={`/kissa/${story.slug}`}>{story.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {links.principles.length > 0 && (
              <div>
                <h3>İlkeler</h3>
                <ul class="tag-list">
                  {links.principles.map((principle) => (
                    <li>
                      <a href={`/ilke/${principle.slug}`}>{principle.nameTr}</a>
                      {principle.role === "primary" && (
                        <span class="tag-role">doğrudan dayanak</span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {links.concepts.length > 0 && (
              <div>
                <h3>Kavramlar</h3>
                <ul class="tag-list">
                  {links.concepts.slice(0, 12).map((concept) => (
                    <li>
                      <a href={`/kavram/${concept.slug}`}>{concept.nameTr}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {links.events.length > 0 && (
              <div>
                <h3>Nüzul</h3>
                <ul class="tag-list">
                  {links.events.map((event) => (
                    <li>
                      <a href="/zaman">{event.title}</a>
                      {event.approxYear !== null && (
                        <span class="tag-note">{event.approxYear}</span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      )
    }

    {
      relatedRows.length > 0 && (
        <section>
          <div class="sec-head">
            <h2>İlgili ayetler</h2>
            <span class="sec-note">
              Her bağın gerekçesi yanında yazar. Bunlar yorum değil, ortak kıssa
              / olay / kök / kavram sayımıdır.
            </span>
          </div>
          <ul class="rel-verse-list">
            {relatedRows.map((row) => (
              <li class="rel-verse">
                <div class="rel-verse-head">
                  <a
                    class="rel-verse-ref"
                    href={`/${row.surahSlug}/${String(row.verseNumber)}`}
                  >
                    {row.surahNameTr} {row.verseNumber}
                  </a>
                  {row.confidence === "muhtemel" && (
                    <span class="confidence-badge" data-confidence="muhtemel">
                      olası
                    </span>
                  )}
                </div>
                <p class="rel-verse-why">{row.reason}</p>
                {row.excerpt !== null && <p class="rel-verse-text">{row.excerpt}</p>}
              </li>
            ))}
          </ul>
          <p class="sec-note mt-3">
            Meal parçaları {defaultAuthor.name} mealindendir.
          </p>
        </section>
      )
    }

    <section>
      <div class="sec-head">
        <h2>Türkçe mealler</h2>
        <span class="sec-note">
          {turkish.length} meal. Aralarındaki fark yorum farkıdır; hiçbiri tek
          doğru olarak sunulmaz.
        </span>
      </div>

      <div class="meal-grid">
        {
          turkish.map((row) => (
            <Translation
              authorName={row.name}
              authorSlug={row.slug}
              text={row.text}
              footnotes={row.footnotes}
              sourceDeclaredBy="sayfa altındaki kaynak listesi"
              anchorPrefix={`${String(surahId)}-${String(verseNumber)}-${row.slug}`}
              lang="tr"
            />
          ))
        }
      </div>
    </section>

    {
      other.length > 0 && (
        <section>
          <details>
            <summary class="sec-head cursor-pointer">
              <h2>İngilizce çeviriler</h2>
              <span class="sec-note">({other.length})</span>
            </summary>
            <div class="meal-grid">
              {other.map((row) => (
                <Translation
                  authorName={row.name}
                  authorSlug={row.slug}
                  text={row.text}
                  footnotes={row.footnotes}
                  sourceDeclaredBy="sayfa altındaki kaynak listesi"
                  anchorPrefix={`${String(surahId)}-${String(verseNumber)}-${row.slug}`}
                  lang="en"
                />
              ))}
            </div>
          </details>
        </section>
      )
    }

    <nav aria-label="Ayetler arası gezinme" class="pg-nav">
      {
        previous === null ? (
          <span />
        ) : (
          <a href={`/${verse.surahSlug}/${String(previous)}`}>
            <span aria-hidden="true">←</span> {previous}. ayet
          </a>
        )
      }
      <a href={`/${verse.surahSlug}#ayet-${String(verse.verseNumber)}`}>
        {verse.surahNameTr} suresinin tamamı
      </a>
      {
        next === null ? (
          <span />
        ) : (
          <a href={`/${verse.surahSlug}/${String(next)}`}>
            {next}. ayet <span aria-hidden="true">→</span>
          </a>
        )
      }
    </nav>
  </main>
</Base>
