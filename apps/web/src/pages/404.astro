---
import Base from "~/layouts/Base.astro";
import { getSurahsIndex } from "~/lib/data";

/**
 * 404 sayfası.
 *
 * Nginx `error_page 404 /404.html;` ile bunu servis eder. Statik site olduğu
 * için sunucu tarafında arama yok — kullanıcıya nereye gidebileceği söylenir.
 */

const { totals } = getSurahsIndex();
---

<Base title="Sayfa bulunamadı — Kur'an-ı Kerim Keşif Platformu">
  <main id="icerik" class="mx-auto max-w-narrow px-4 py-8">
    <h1 class="m-0 text-3xl">Sayfa bulunamadı</h1>
    <p class="text-text-secondary mt-2">
      Aradığınız adres yok ya da taşınmış olabilir.
    </p>

    <ul class="mt-6 list-none space-y-2 p-0">
      <li><a href="/">Ana sayfa</a></li>
      <li><a href="/sureler">Sure listesi</a> — {totals.surahs} sure</li>
    </ul>

    <p class="text-text-secondary mt-6 text-sm">
      Ayet adresleri <code>/sure-adi-suresi/ayet-numarasi</code> biçimindedir;
      örnek: <a href="/bakara-suresi/153">/bakara-suresi/153</a>.
    </p>
  </main>
</Base>
