---
import Base from "~/layouts/Base.astro";
import HaritaStatik from "~/components/HaritaStatik.astro";
import Translation from "~/components/Translation.astro";
import {
  getAuthorsIndex,
  getDefaultAuthor,
  getLocations,
  getSurahsIndex,
  getVerseDetail,
  verseLabel,
} from "~/lib/data";
import { TELEGRAM } from "~/lib/site";

/**
 * Tanıtım sayfası — plan §14.1, DESIGN.md §7.
 *
 * Görsel dil 2026-09-04 tasarımından gelir (docs/landing.html): mürekkep
 * laciverdi zemin, pirinç vurgu, Cormorant başlık, Karla gövde.
 *
 * HERO VİDEOSU (2026-09-04). Alt katmanda sessiz, döngülü bir video var.
 * Sunucu CSP'sine bunun için `media-src 'self'` eklendi; öncesinde
 * `default-src 'none'` videoyu sessizce engelliyordu. `script-src` AÇILMADI —
 * sayfa hâlâ 0 bayt JS. Video kaynağında beş peygamber insan figürü olarak
 * görünüyordu; plan §20.3 gereği o aralıklar çıkarıldı, kesim kararı
 * `scripts/media/build_media.ts` içinde kayıtlı.
 *
 * Menüdeki açılır listeler yalnızca CSS (:focus-within); mobil menü
 * <details>. Betik yok.
 *
 * DÜRÜSTLÜK KURALI: hazır olmayan bölüm "yakında" diye işaretlenir, çalışıyor
 * gibi gösterilmez. Menüde de yalnızca var olan sayfalar bağlantıdır; gerisi
 * "yakında" etiketiyle, tıklanamaz durur (plan §1.5, CLAUDE.md kural 5).
 *
 * Kural İKİ YÖNLÜ çalışır ve ikinci yönü 2026-09-07'de İKİ KEZ kaçırıldı:
 *   1. Bülten bölümü "henüz açılmadı, arkasında çalışan bir sunucu yok"
 *      diyordu; Telegram botu o gün yayına girmişti.
 *   2. Kapılar bölümü "şu an Kelime kapısı açık, diğer dördünün altyapısı
 *      hazırlanıyor" diyordu; beşi de çoktan açılmıştı.
 * İkisini de kullanıcı fark etti. Hazır olmayanı hazır göstermek kadar
 * HAZIR OLANI YOK GÖSTERMEK de yalandır. Bir modül yayına girdiğinde bu
 * sayfadaki durum cümleleri de aranır — "yakında" etiketi kadar metnin kendisi
 * de eskiyebilir ve eskidiğinde kimse hata almaz.
 *
 * BÖLÜM SIRASI (2026-09-07, kullanıcı kararı): hero'dan hemen sonra "Keşfe
 * başlayın" gelir. Gerekçe: hero'nun düğmesi zaten #kapilar'a gönderiyor;
 * ziyaretçiyi önce manifestoyla karşılamak, girmek isteyeni bir ekran
 * bekletiyordu. "Neden farklı" bir kademe aşağı indi.
 *
 * KAYNAK BÖLÜMLERİ KALDIRILDI (kullanıcı kararı 2026-09-04): "Kaynaklar" ve
 * "Kaynak Şeffaflığı" bölümleri aynı şeyi sayfanın dört yerinde tekrar
 * ediyordu. Kalan tek şey mealin KİME ait olduğu. Yasal atıf kaldırılmadı:
 * `<Attribution>` her sayfanın altında, `/kaynaklar` sayfası yerinde —
 * Açık Kuran verisi CC BY-NC-SA 4.0, atıf lisansın şartı.
 */

const { surahs, totals } = getSurahsIndex();
const authors = getAuthorsIndex().authors;
const turkishAuthors = authors.filter((a) => a.language === "tr");
const englishAuthors = authors.filter((a) => a.language === "en");
const defaultAuthor = getDefaultAuthor();

/**
 * Harita onizlemesi icin konum sayilari.
 *
 * Sayilar VERIDEN gelir, koda yazilmaz. Ana sayfada elle yazilmis bir sayinin
 * ne oldugu 2026-09-07'de goruldu: modul listesinde "26 meal" yaziyordu, ayni
 * sayfanin hero'su ise veriden gelen 54'u basiyordu. Iki sayi tek sayfada.
 */
const locations = getLocations();
const locationsByConfidence = {
  kesin: locations.filter((l) => l.confidence === "kesin").length,
  muhtemel: locations.filter((l) => l.confidence === "muhtemel").length,
  gelenek: locations.filter((l) => l.confidence === "gelenek").length,
  tartismali: locations.filter((l) => l.confidence === "tartismali").length,
};

/**
 * Hero ayeti: Âl-i İmrân 103. Sabit seçim — sayfanın "ağ" fikrini taşıyan
 * ayet bu ("Allah'ın ipine hep birlikte sarılın"). Metin ve meal yine
 * veriden gelir, koda gömülmez.
 */
const heroVerse = getVerseDetail(3, 103);
const heroTranslation = heroVerse.translations.find((t) => t.authorSlug === defaultAuthor.slug);

/**
 * "Kur'an'da Bugün" — build gününe göre seçilir.
 *
 * Sunucu tarafı kod yok; site tamamen statik. Bu yüzden ayet BUILD anında
 * seçilir ve bir sonraki build'e kadar aynı kalır. Sayfada bu açıkça yazıyor;
 * "her gün değişir" denip değişmemesi yalan olurdu.
 */
const buildDate = new Date();
const dayOfYear = Math.floor(
  (buildDate.getTime() - new Date(buildDate.getFullYear(), 0, 0).getTime()) / 86_400_000,
);
const featuredIndex = (dayOfYear * 137) % totals.verses;
let running = 0;
let featuredSurahId = 1;
let featuredVerseNumber = 1;
for (const surah of surahs) {
  if (running + surah.verseCount > featuredIndex) {
    featuredSurahId = surah.id;
    featuredVerseNumber = featuredIndex - running + 1;
    break;
  }
  running += surah.verseCount;
}
const featured = getVerseDetail(featuredSurahId, featuredVerseNumber);
const featuredTranslation = featured.translations.find((t) => t.authorSlug === defaultAuthor.slug);
const featuredDateLabel = buildDate.toLocaleDateString("tr-TR", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

/**
 * Beş keşif kapısı — plan §2. Yalnızca Kelime hazır.
 *
 * `href` sayfanın kendisi, `to` KARTIN GİTTİĞİ YER. Hazır olmayan kapılar
 * olmayan bir sayfaya bağlanamaz (dürüstlük kuralı, plan §1.5) ama tık da
 * boşa gitmemeli: onlar "Kullanacağınız araçlar" bölümüne iniyor, çünkü
 * neyin ne zaman geleceği orada yazıyor.
 */
const gates = [
  {
    numeral: "I",
    name: "Harita",
    note: "Nuh'un gemisi, Yusuf'un kuyusu, Musa'nın yolculuğu — kıssaların geçtiği yerler, her birinin ne kadar kesin olduğu belirtilerek.",
    href: "/harita",
    to: "/harita",
  },
  {
    numeral: "II",
    name: "Zaman",
    note: "Sureleri mushaf sırasıyla değil indikleri sırayla okuyun. O gün Mekke'de ne oluyordu, hemen yanında.",
    href: "/zaman",
    to: "/zaman",
  },
  {
    numeral: "III",
    name: "Kavram",
    note: "Sabır nereye bağlanıyor, şükürle nasıl kesişiyor? Kavramlar arasında gezinin, her düğümde ayetleri görün.",
    href: "/kavramlar",
    to: "/kavramlar",
  },
  {
    numeral: "IV",
    name: "Kelime",
    note: "Arapça bilmeden de kökleri izleyin. Bir kelimenin kökü, türevleri ve Kur'an'ın her yerindeki izi.",
    href: "/kok",
    to: "/kok",
  },
  {
    numeral: "V",
    name: "İlkeler",
    note: "Adalet, emanet, ölçüde dürüstlük, öfkeyi yutmak — dayandığı ayetler ve tefsir kaynaklarıyla birlikte.",
    href: "/ilkeler",
    to: "/ilkeler",
  },
] as const;

/**
 * Ayet merkezli ağ — §5'teki şemanın etiketleri (plan §15).
 *
 * `to`: bugün gerçekten çalışan şey nereye götürüyor. Bağlam ve Nüzul için
 * hazır bir örnek sayfa var (hero ayetinin kendi sayfası ve suresi); Kök
 * kendi bölümüne gider. Kalanlar henüz yok, "Kullanacağınız araçlar"a iner.
 */
const heroVerseHref = `/${heroVerse.surahSlug}/${String(heroVerse.verseNumber)}`;
const spokes = [
  {
    name: "Bağlam",
    note: "Önceki ve sonraki ayetler, sure içindeki konu başlığı",
    to: heroVerseHref,
  },
  { name: "Kıssa", note: "Ayetin parçası olduğu anlatı, kronolojik sırasıyla", to: "/kissalar" },
  { name: "Kavram", note: "İçinde geçen kavramlar ve bağlı kavramlar", to: "/kavramlar" },
  { name: "Kök", note: "Kelimelerin kökleri ve Kur'an'daki diğer kullanımları", to: "/kok" },
  {
    name: "Nüzul",
    note: "İniş sırası, dönemi ve o döneme ait olaylar",
    to: "/zaman",
  },
  { name: "Konum", note: "Anlatılan olayın geçtiği yer, güven derecesiyle", to: "/harita" },
] as const;

/**
 * Modüller — plan §2. Durum dürüstçe işaretlenir.
 *
 * `to` yalnızca HAZIR modüllerde var. "Yakında" olanlar tıklanmaz: olmayan
 * bir sayfaya bağlamak da, kendi bölümüne geri döndürmek de kullanıcıyı
 * kandırır. Durum etiketi zaten ne olduğunu söylüyor.
 */
const modules = [
  {
    name: "Klasik okuma",
    state: "hazir",
    to: "/sureler",
    note: `${totals.surahs} sure, ${totals.verses} ayet; Arapça metin ve meal yan yana.`,
  },
  {
    name: "Meal karşılaştırma",
    state: "hazir",
    to: heroVerseHref,
    note:
      `${turkishAuthors.length} Türkçe ve ${englishAuthors.length} İngilizce meal yan yana. ` +
      "Aynı ayetin farklı karşılanışını görün.",
  },
  {
    name: "Çeviriyazı",
    state: "hazir",
    to: heroVerseHref,
    note: "Her ayetin Latin harfli okunuşu. Arapça bilmeden de takip edilir.",
  },
  {
    name: "Meal sahipliği",
    state: "hazir",
    to: "/kaynaklar",
    note: "Her mealin ve tefsirin kime ait olduğu metnin yanında yazar.",
  },
  {
    name: "Kelime ve kök",
    state: "hazir",
    to: "/kok",
    note: "77.429 kelime, 1.641 kök. Kökten türevlere, türevlerden ayetlere.",
  },
  {
    name: "Kıssalar",
    state: "hazir",
    to: "/kissalar",
    note: "Kıssa akışı ve kronoloji; her adım ayete bağlı.",
  },
  {
    name: "Kavram ağı",
    state: "hazir",
    to: "/kavramlar",
    note: "Kavramdan ayete, ayetten kavrama; bağları izleyin.",
  },
  {
    name: "Harita",
    state: "hazir",
    to: "/harita",
    note: "Kıssaların coğrafyası. Liste alternatifi zorunlu.",
  },
  {
    name: "Günlük ayet (Telegram)",
    state: "hazir",
    to: "/telegram",
    note: "Her gün bir ayet ve bir ilke; kaynaklı, reklamsız, takipsiz.",
  },
  {
    name: "Hoca notları",
    state: "yakinda",
    note: "Ders videolarından çıkarılmış açıklamalar, tam dakikasına bağlı.",
  },
  {
    name: "Okuma günlüğü",
    state: "hazir",
    to: "/gunluk",
    note: "Notlarınız ve ezber tekrarınız; sunucuda değil, cihazınızda.",
  },
  {
    name: "Ses (kıraat)",
    state: "hazir",
    to: heroVerseHref,
    note: "Her ayetin kıraati ayet sayfasında; Mishary Alafasy kaydı.",
  },
  {
    name: "Çevrimdışı okuma",
    state: "yakinda",
    note: "Okuduğunuz cüz cihazınıza iner, bağlantı zayıfken de açılır.",
  },
] as const;

const stateLabel = {
  hazir: "hazır",
  yakinda: "yakında",
} as const;

/**
 * Menü — yalnızca var olan sayfalar bağlantıdır (dürüstlük kuralı).
 *
 * 2026-09-06: menüde üç boşluk vardı, üçü de düzeltildi.
 *   1. `/kissalar` HİÇBİR yerde yoktu — ne "Keşfet"te ne "Oku"da. 50
 *      kıssalık canlı bir bölüm menüden erişilemiyordu. "Kıssa Haritası"
 *      vardı ama o `/harita`ya gider, kıssa listesine değil.
 *   2. `/kaynaklar` yoktu. Her sayfanın altındaki <Attribution> üzerinden
 *      erişiliyordu ama iç sayfaların menüsünde (Base.astro) yer alıyor.
 *   3. Mobil panel yalnızca ÜST BAŞLIKLARI basıyordu; alt maddeler hiç
 *      yoktu. Yani telefondan ana sayfaya giren biri kök, harita, zaman,
 *      kavram, ilke, kıssa ve kaynak sayfalarının hiçbirine menüden
 *      ulaşamıyordu. En ağır olan buydu.
 *
 * İki kapı yapısı korundu: ana sayfada sekiz düz bağlantı yerine "Keşfet"
 * ve "Oku" iki giriş noktası. İç sayfalarda menü zaten düz ve tam
 * (Base.astro). Açılır listeler saf CSS — :hover / :focus-within, JS yok.
 */
const menu = [
  {
    label: "Keşfet",
    href: "#kapilar",
    items: [
      { name: "Kıssalar", note: "Kıssa akışı ve kronoloji, her adım ayete bağlı", href: "/kissalar" },
      { name: "Kök Kelime Keşfi", note: "Kökten türevlere, türevlerden ayetlere", href: "/kok" },
      { name: "Kıssa Haritası", note: "Kıssaların geçtiği yerler", href: "/harita" },
      { name: "Nüzul Zaman Çizelgesi", note: "Sureler iniş sırasıyla", href: "/zaman" },
      { name: "Kavram Haritası", note: "Kavramlar arası bağlar", href: "/kavramlar" },
      { name: "İlkeler", note: "Kur'an'ın tavsiye ettiği ilkeler", href: "/ilkeler" },
    ],
  },
  {
    label: "Oku",
    href: "/sureler",
    items: [
      { name: "Sure Listesi", note: `${totals.surahs} sure`, href: "/sureler" },
      // Karşılaştırma AYET sayfasında yaşıyor: bütün Türkçe mealler aynı anda,
      // üstünde hangilerinin görüneceğini seçen JS'siz bir panel. Menü
      // buraya, Fâtiha'nın ilk ayetine açılıyor — sabit ve tanıdık bir
      // başlangıç. Eskiden `/sureler`e gidiyordu, yani "Sure Listesi" ile
      // aynı yere; iki madde tek hedefti (kullanıcı bildirdi 2026-09-06).
      {
        name: "Meal Karşılaştırma",
        note: `${String(turkishAuthors.length)} Türkçe meal yan yana; istediğinizi seçin`,
        href: "/fatiha-suresi/1#mealler",
      },
      { name: "Mushaf Modu", note: "Sayfa düzeninde Arapça metin", href: undefined },
      { name: "Sade Okuma", note: "Dikkat dağıtmayan tek sütun", href: undefined },
    ],
  },
] as const;
---

<Base
  title="Kur'an-ı Kerim Keşfi — Keşfet • Oku • Anla"
  description="Ücretsiz, reklamsız, üyeliksiz, takipsiz. Kur'an-ı Kerim metni, çeviriyazısı ve mealleri; her bilgi kaynağıyla birlikte."
  arabic
  bareHeader
>
  {/* --- Menü ------------------------------------------------------------ */}
  <nav class="lp-nav" aria-label="Ana gezinme">
    <div class="lp-nav-in">
      <a href="/" class="lp-brand">
        <img src="/brand/logo-96.webp" width="38" height="38" alt="" aria-hidden="true" />
        <span class="lp-brand-txt">
          Kur'an-ı Kerim Keşfi
          <em>kurankesfi.tr</em>
        </span>
      </a>

      {/* Masaüstü menü: açılır listeler yalnızca CSS (:hover / :focus-within). */}
      <ul class="lp-menu">
        {
          menu.map((entry) => (
            <li class:list={["lp-mi", entry.items.length > 0 && "has"]}>
              <a href={entry.href}>{entry.label}</a>
              {entry.items.length > 0 && (
                <div class="lp-drop">
                  {entry.items.map((item) =>
                    item.href === undefined ? (
                      <span class="is-soon">
                        {item.name}
                        <span>{item.note} — yakında</span>
                      </span>
                    ) : (
                      <a href={item.href}>
                        {item.name}
                        <span>{item.note}</span>
                      </a>
                    ),
                  )}
                </div>
              )}
            </li>
          ))
        }
        {/* Kaynaklar açılır liste değil, düz bağlantı: tek sayfa. Atıf
            zorunluluğu gereği menüde görünür olması gerekiyor. */}
        <li class="lp-mi">
          <a href="/kaynaklar">Kaynaklar</a>
        </li>
      </ul>

      <a href="/sureler" class="lp-nav-cta">Keşfetmeye başla</a>

      {/* Mobil menü: <details> — betik gerektirmez. */}
      <details class="lp-burger">
        <summary aria-label="Menüyü aç"><span></span><span></span><span></span></summary>
        <div class="lp-burger-panel">
          {
            menu.map((entry) => (
              <div class="lp-burger-grp">
                <a href={entry.href} class="is-head">
                  {entry.label}
                </a>
                {entry.items.map((item) =>
                  item.href === undefined ? (
                    <span class="is-soon">{item.name} — yakında</span>
                  ) : (
                    <a href={item.href} class="is-sub">
                      {item.name}
                    </a>
                  ),
                )}
              </div>
            ))
          }
          <a href="/kaynaklar" class="is-head">Kaynaklar</a>
          <a href="/sureler" class="is-cta">
            Keşfetmeye başla
          </a>
        </div>
      </details>
    </div>
  </nav>

  <main id="icerik">
    {/* --- 1. Hero ------------------------------------------------------- */}
    <header class="lp-hero">
      {/*
        Alt katman: hero videosu.

        Sessiz, döngülü, `playsinline` — arka plan videosunun tarayıcıda
        kendiliğinden oynaması bunları gerektirir. `poster` video inmeden
        önce görünen kare; LCP'yi o taşır (12 KB WebP).

        Video DEKORATİFTİR: anlattığı her şey sayfada zaten yazıyor. Bu
        yüzden `aria-hidden` ve ekran okuyucuya hiç verilmiyor.

        Sunucu CSP'sine `media-src 'self'` eklendi (2026-09-04); öncesinde
        `default-src 'none'` bunu sessizce engelliyordu.

        Figürsüz kurgu: kaynakta beş peygamber insan figürü olarak
        görünüyordu, plan §20.3 gereği o aralıklar çıkarıldı. Kesim kararı
        `scripts/media/build_media.ts` içinde kayıtlı.
      */}
      <video
        class="lp-hero-video"
        poster="/media/hero-poster.webp"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
        tabindex="-1"
      >
        <source src="/media/hero.mp4" type="video/mp4" />
      </video>
      <div class="lp-hero-veil" aria-hidden="true"></div>

      <div class="lp-hero-in">
        {/* Logo ve marka şeridi kaldırıldı (kullanıcı kararı 2026-09-06):
            ikisi de üst şeritte zaten duruyor, hero'da tekrar edince
            başlığın önüne geçiyorlardı. */}
        <h1 class="lp-h1">
          Oku. Anla. Keşfet.
          <span class="lp-l2">Hayatına Taşı.</span>
        </h1>

        <p class="lp-hero-sub">
          Kur'an'ı okumak bir başlangıçtır. Anlamak bir yolculuk, yaşamak ise hedeftir.
        </p>

        <p class="lp-hero-lede">
          Bir ayeti açın; geçtiği kıssa, bağlı olduğu kavram, kökü, indiği dönem ve
          anlatıldığı yer aynı anda önünüze gelsin. {turkishAuthors.length} Türkçe,
          {" "}{englishAuthors.length} İngilizce meal ve kaynağı gösterilen açıklamalarla.
        </p>

        <p class="lp-hero-acts">
          <a href="#kapilar" class="lp-btn lp-btn-p">Keşfetmeye başla</a>
          <a href="/sureler" class="lp-btn lp-btn-s">Klasik okumaya geç</a>
        </p>

        <div class="lp-hero-verse">
          <p class="lp-hv-ar" lang="ar" dir="rtl">{heroVerse.textUthmani}</p>
          {
            heroTranslation !== undefined && (
              <p class="lp-hv-tr" lang="tr">
                “{heroTranslation.text}”
              </p>
            )
          }
          <p class="lp-hv-src">
            {verseLabel(heroVerse.surahNameTr, heroVerse.verseNumber)}
            <span aria-hidden="true"> · </span>
            {defaultAuthor.name} meali
          </p>
        </div>
      </div>
    </header>

    {/* --- 2. Keşfe Başla ------------------------------------------------ */}
    <section class="lp-sec" id="kapilar" aria-labelledby="kapilar-baslik">
      <div class="lp-wrap">
        <p class="rule-ornament" aria-hidden="true"><span></span></p>
        <h2 id="kapilar-baslik" class="lp-h2">Keşfe başlayın</h2>
        {/*
          2026-09-07: burada "Şu an Kelime kapısı açık; diğer dördünün altyapısı
          hazırlanıyor" yazıyordu. Beşi de açıldığı hâlde metin öyle kalmıştı —
          bülten bölümüyle aynı hata (bkz. dosyanın başındaki dürüstlük notu).
          Kapılardan birinin durumu değişirse bu cümle de değişir.
        */}
        <p class="lp-lead">
          Beş kapının beşi de açık. Hangisinden girerseniz girin aynı yere —
          ayete — çıkarsınız; yolu siz seçersiniz: bir yer adından, bir tarihten,
          bir kavramdan, bir kelimenin kökünden ya da bir ilkeden.
        </p>

        <ul class="lp-gates">
          {
            gates.map((gate) => (
              <li class:list={["lp-gate", gate.href === undefined && "is-soon"]}>
                <span class="lp-gate-num" aria-hidden="true">
                  {gate.numeral}
                </span>
                {/* Bağlantı başlıkta, tık alanı kartın tamamı (.lp-stretch).
                    Hazır olmayan kapı "Kullanacağınız araçlar"a iner. */}
                <h3>
                  <a href={gate.to} class="lp-stretch">
                    {gate.name}
                  </a>
                </h3>
                <p>{gate.note}</p>
                <p class:list={["state", gate.href === undefined ? "state-yakinda" : "state-hazir"]}>
                  {gate.href === undefined ? "yakında" : "hazır"}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* --- 3. Neden Farklı ----------------------------------------------- */}
    <section class="lp-manifesto" id="neden-farkli" aria-labelledby="neden-farkli-baslik">
      <h2 id="neden-farkli-baslik" class="sr-only">Neden farklı</h2>
      <div class="lp-wrap lp-man-grid">
        <div class="lp-man-cell">
          <h3><a href="/kaynaklar" class="lp-stretch">Her bilgi kaynağıyla</a></h3>
          <p>
            Tefsir de meal de hoca açıklaması da bir yorumdur. Hepsini kimin söylediğiyle,
            hangi esere dayandığıyla birlikte gösteriyoruz. Farklı görüşler yan yana durur.
          </p>
        </div>
        <div class="lp-man-cell">
          <h3><a href="#sadaka-baslik" class="lp-stretch">Reklamsız, üyeliksiz</a></h3>
          <p>
            Ücretli bölüm, reklam, takip kodu yok. Yazı tipleri bile kendi sunucumuzdan
            gelir — tarayıcınız üçüncü bir siteye istek atmaz. Girmek için hesap açmanız
            gerekmez.
          </p>
        </div>
        <div class="lp-man-cell">
          <h3><a href="/kaynaklar" class="lp-stretch">Belirsizlik gizlenmez</a></h3>
          <p>
            Bir konum tartışmalıysa haritada öyle görünür. Nüzul sırasında farklı görüş
            varsa ikisi de yazar. Kesin olmayan hiçbir şey kesinmiş gibi sunulmaz.
          </p>
        </div>
      </div>
    </section>

    {/* --- 4. Nasıl Çalışır ---------------------------------------------- */}
    <section class="lp-net" id="nasil" aria-labelledby="nasil-baslik">
      <div class="lp-wrap lp-net-grid">
        <div>
          <p class="rule-ornament" aria-hidden="true"><span></span></p>
          <h2 id="nasil-baslik" class="lp-h2">Merkezde ayet var</h2>
          <p class="lp-lead">
            Bir ayete tıkladığınızda tek bir meal değil, o ayetin bağlı olduğu her şey
            açılır. Bulunduğunuz yerden başka bir yere geçmek tek tık sürer; nereden
            geldiğinizi de unutmazsınız.
          </p>
          <ul class="lp-net-list">
            {
              spokes.map((spoke) => (
                <li>
                  <a href={spoke.to} class="lp-stretch">
                    <b>{spoke.name}</b>
                  </a>
                  <span>{spoke.note}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="lp-net-vis">
          <svg viewBox="0 0 460 420" role="img" aria-labelledby="net-sema-baslik">
            <title id="net-sema-baslik">
              Ayet merkezli bağlantı şeması: merkezde ayet, çevresinde bağlam, kıssa,
              kavram, kök, nüzul ve konum düğümleri.
            </title>
            <g class="lp-net-spoke">
              <path
                d="M230 210L108 96M230 210L352 96M230 210L64 210M230 210L396 210M230 210L108 324M230 210L352 324"
              ></path>
            </g>
            <g class="lp-net-ring">
              <path d="M108 96L352 96M64 210L108 324M396 210L352 324M108 96L64 210"></path>
            </g>

            <circle class="lp-net-core" cx="230" cy="210" r="46"></circle>
            <text x="230" y="205" text-anchor="middle" class="lp-net-core-t">Ayet</text>
            <text x="230" y="224" text-anchor="middle" class="lp-net-core-s">3:103</text>

            <g class="lp-net-node">
              <circle cx="108" cy="96" r="27"></circle>
              <text x="108" y="100" text-anchor="middle">Bağlam</text>
              <circle cx="352" cy="96" r="27"></circle>
              <text x="352" y="100" text-anchor="middle">Kıssa</text>
              <circle cx="64" cy="210" r="27"></circle>
              <text x="64" y="214" text-anchor="middle">Kavram</text>
              <circle cx="396" cy="210" r="27"></circle>
              <text x="396" y="214" text-anchor="middle">Kök</text>
              <circle cx="108" cy="324" r="27"></circle>
              <text x="108" y="328" text-anchor="middle">Nüzul</text>
              <circle cx="352" cy="324" r="27"></circle>
              <text x="352" y="328" text-anchor="middle">Konum</text>
            </g>
          </svg>
        </div>
      </div>
    </section>

    {/* --- 5. Harita ------------------------------------------------------ */}
    {/*
      HARITA ANA SAYFAYA NEDEN STATIK GIRIYOR (2026-09-07, kullanici istegi:
      "ana sayfaya da harita modulunu koyalim, ordan gitmek isteyen olabilir")

      Ana sayfada `/harita`ya dort METIN baglantisi zaten vardi; eksik olan
      haritanin GORUNMESIYDI. Etkilesimli MapLibre'yi buraya koymak ~970 KB
      betik ve ana sayfanin CSP'sinde `script-src` acmak demekti; ikisi de
      plan 20.4 basari olcutunu (LCP < 2 sn / 3G) ve "8200+ sayfa 0 bayt JS"
      kuralini kirardi — ustelik ana sayfa sitenin en cok acilan sayfasi.

      Statik SVG ayni veriyi, ayni kadraji, ayni pin bicimlerini kullaniyor.
      Etkilesim isteyen bir tik otede: kartin tamami /harita'ya gidiyor.
    */}
    <section class="lp-sec lp-harita" id="harita" aria-labelledby="harita-baslik">
      <div class="lp-wrap lp-harita-grid">
        <div class="lp-harita-metin">
          <p class="rule-ornament" aria-hidden="true"><span></span></p>
          <h2 id="harita-baslik" class="lp-h2">Kıssalar bir yerde geçti</h2>
          <p class="lp-lead">
            Nûh'un gemisi, Mûsâ'nın vadisi, Ashâb-ı Kehf'in mağarası — hepsinin bir
            coğrafyası var. Harita <strong>"işte tam burası" demez</strong>: her konumun
            ne kadar kesin olduğu yanında yazılı, farklı görüşler gizlenmiyor.
          </p>
          <ul class="fact-row">
            <li><b>{locations.length}</b><span>konum</span></li>
            <li><b>{locationsByConfidence.kesin}</b><span>kesin</span></li>
            <li><b>{locationsByConfidence.muhtemel}</b><span>muhtemel</span></li>
            <li><b>{locationsByConfidence.gelenek}</b><span>gelenek</span></li>
            <li><b>{locationsByConfidence.tartismali}</b><span>tartışmalı</span></li>
          </ul>
          <p class="lp-hero-acts">
            <a href="/harita" class="lp-btn lp-btn-s">Haritayı aç</a>
          </p>
        </div>

        {/*
          Baglanti haritayi SARIYOR; `lp-stretch` degil, cunku esneyecek bir
          metin baglantisi yok — haritanin kendisi tiklanan sey.
        */}
        <a href="/harita" class="lp-harita-vis" aria-label={`Kıssa haritası — ${String(locations.length)} konum`}>
          <HaritaStatik variant="onizleme" />
        </a>
      </div>
    </section>

    {/* --- 6. Modüller ---------------------------------------------------- */}
    <section class="lp-sec" id="moduller" aria-labelledby="moduller-baslik">
      <div class="lp-wrap">
        <p class="rule-ornament" aria-hidden="true"><span></span></p>
        <h2 id="moduller-baslik" class="lp-h2">Kullanacağınız araçlar</h2>
        <p class="lp-lead">
          Hepsi ücretsiz, hepsi hesap açmadan. Neyin hazır olduğu, neyin yolda olduğu
          açıkça yazılıdır.
        </p>

        <ul class="lp-mods">
          {
            modules.map((module) => (
              <li class:list={["lp-mod", module.state === "yakinda" && "is-soon"]}>
                <h3>
                  {"to" in module ? (
                    <a href={module.to} class="lp-stretch">
                      {module.name}
                    </a>
                  ) : (
                    module.name
                  )}
                </h3>
                <p>{module.note}</p>
                <p class:list={["state", `state-${module.state}`]}>{stateLabel[module.state]}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* --- 7. Mealler -----------------------------------------------------
        Eskiden burada iki ayrı bölüm vardı: "Kaynaklar" (lisans kartlarıyla)
        ve "Kaynak Şeffaflığı" (rozet gösterimiyle). İkisi de kaldırıldı —
        aynı şey sayfanın dört yerinde tekrarlanıyordu (kullanıcı kararı
        2026-09-04). Kalan tek şey mealin KİME ait olduğu.

        Yasal atıf KALDIRILMADI, yalnızca bu bölümden çıkarıldı: `<Attribution>`
        her sayfanın altında duruyor ve `/kaynaklar` sayfası yerinde —
        Açık Kuran verisi CC BY-NC-SA 4.0, atıf lisansın şartı. -------------- */}
    <section class="lp-sec" id="mealler" aria-labelledby="mealler-baslik">
      <div class="lp-wrap">
        <p class="rule-ornament" aria-hidden="true"><span></span></p>
        <h2 id="mealler-baslik" class="lp-h2">{turkishAuthors.length} meal, yan yana</h2>
        <p class="lp-lead">
          Açılışta {defaultAuthor.name} meali gelir; dilediğinizi ekleyip çıkarabilirsiniz.
          Her mealin altında kimin olduğu yazar.
        </p>

        <ul class="lp-chips">
          {
            turkishAuthors.map((author) => (
              <li class:list={["lp-chip", author.priority !== null && "is-pri"]}>{author.name}</li>
            ))
          }
        </ul>

        <p class="lp-note">
          Ayrıca {englishAuthors.length} İngilizce çeviri.
        </p>
      </div>
    </section>

    {/* --- 8. Kur'an'da Bugün -------------------------------------------- */}
    <section class="lp-sec" id="bugun" aria-labelledby="bugun-baslik">
      <div class="lp-wrap">
        <p class="rule-ornament" aria-hidden="true"><span></span></p>
        <h2 id="bugun-baslik" class="lp-h2">Kur'an'da bugün</h2>
        <p class="lp-lead">
          {featuredDateLabel} — {verseLabel(featured.surahNameTr, featured.verseNumber)}
        </p>

        <div class="lp-today">
          <div>
            <p class="lp-today-ar" lang="ar" dir="rtl">{featured.textUthmani}</p>
            {
              featuredTranslation !== undefined && (
                <div class="lp-today-meal">
                  <Translation
                    authorName={featuredTranslation.authorName}
                    authorSlug={featuredTranslation.authorSlug}
                    text={featuredTranslation.text}
                    footnotes={featuredTranslation.footnotes}
                    sourceDeclaredBy="sayfa altındaki kaynak ve atıf alanı"
                    anchorPrefix={`bugun-${featured.surahId}-${featured.verseNumber}`}
                  />
                </div>
              )
            }
            {
              featured.transcriptionTr !== null && (
                <p class="lp-today-tr" lang="tr">
                  {featured.transcriptionTr}
                </p>
              )
            }
          </div>

          <div class="lp-today-side">
            {/* Rozet yığını kaldırıldı; kalan tek şey mealin kime ait olduğu. */}
            <h3>MEAL</h3>
            <p class="lp-today-author">{defaultAuthor.name}</p>
            <p class="lp-today-links">
              <a href={`/${featured.surahSlug}/${featured.verseNumber}`}>
                Bu ayetin bütün meallerini gör
              </a>
              <a href={`/${featured.surahSlug}`}>{featured.surahNameTr} suresini aç</a>
            </p>
            <p class="lp-note">
              Site tamamen statiktir; bu ayet her yeni yayında değişir, saat başı değil.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* --- 9. Bülten ------------------------------------------------------ */}
    {/*
      2026-09-07: bu bölüm "henüz açılmadı, arkasında çalışan bir sunucu yok"
      diyordu. Artık VAR — Telegram botu yayında (`apps/bot`, @kurankesfi_bot).
      Metin olduğu gibi bırakılsaydı sitenin KENDİ dürüstlük kuralını çiğneyen
      bir yalan olurdu; kullanıcı fark etti.

      E-posta bülteni hâlâ yok ve burada söz de verilmiyor. Form yine
      KONULMADI ama artık sebebi "sunucu yok" değil: kayıt botun içinde
      yapılıyor, sitenin e-posta toplamasına gerek yok.
    */}
    <section class="lp-bulten" aria-labelledby="bulten-baslik">
      <div class="lp-wrap lp-bulten-in">
        <div>
          <h2 id="bulten-baslik" class="lp-h2">Her sabah bir ayet, bir ilke</h2>
          <p class="lp-lead">
            Telegram'dan geliyor: her gün bir ayet ve o ayetin bağlandığı bir ilke.
            Gönderilen metin bu sitede duranın aynısıdır — aynı meal, aynı kaynak.
            Kayıt için e-posta adresi istemiyoruz, sohbeti başlatmanız yetiyor;
            çıkmak da tek komut: <b>/dur</b> yazınca kaydınız silinir.
          </p>
          <p class="lp-bulten-baglantilar">
            <a class="lp-bulten-cta" href={TELEGRAM.url} rel="noopener noreferrer" target="_blank">
              Telegram'da aç — @{TELEGRAM.username}
              <span class="sr-only"> (yeni sekmede açılır)</span>
            </a>
            <a href="/telegram">Ne saklanıyor, ne saklanmıyor</a>
          </p>
        </div>
        <p class="state state-hazir">hazır</p>
      </div>
    </section>

    {/* --- 10. Sadaka-i Cariye / Açık Kaynak ----------------------------- */}
    <section class="lp-closing" aria-labelledby="sadaka-baslik">
      <div class="lp-wrap">
        <img
          class="lp-closing-logo"
          src="/brand/logo-96.webp"
          width="74"
          height="74"
          alt=""
          aria-hidden="true"
        />
        <h2 id="sadaka-baslik" class="lp-closing-h">
          Bu site Allah rızası için hazırlanmıştır
        </h2>
        <p class="lp-closing-p">
          Ücretsiz kalacak, reklam almayacak, kimseyi takip etmeyecek. Kâr amacı gütmez,
          bağış toplamaz. Faydası olursa bir sadaka-i cariye olması ümit edilir.
        </p>

        <dl class="lp-lic-list">
          <dt>Kod</dt>
          <dd>MIT</dd>
          <dt>Kendi derlediğimiz veri</dt>
          <dd>CC BY-NC-SA 4.0</dd>
          <dt>Üçüncü taraf metinler</dt>
          <dd>
            Kendi lisansları geçerlidir — Arapça metin, mealler ve çeviriyazı bize ait
            değildir.
          </dd>
        </dl>

        <p class="lp-hero-acts">
          <a href="/sureler" class="lp-btn lp-btn-p">Keşfetmeye başla</a>
          <a href="/kok" class="lp-btn lp-btn-s">Kök kelimeleri keşfet</a>
        </p>
      </div>
    </section>
  </main>
</Base>

<style is:global>
  /* ==========================================================================
     Tanıtım sayfası — DESIGN.md §7, görsel dil docs/landing.html (2026-09-04).

     Bu blok YALNIZCA bu sayfaya yüklenir; okuma sayfalarının CSS bütçesini
     şişirmez. Renk/ölçü değerleri token'dan gelir, hex gömülmez.
     ======================================================================= */

  /* --- Menü ------------------------------------------------------------- */

  /* Tasarımda menü hero üzerinde saydam başlayıp kaydırınca katılaşıyordu;
     o davranış betik istiyor (CSP `default-src 'none'`). Bunun yerine menü
     her zaman katı: aynı okunaklılık, 0 bayt JS. */
  .lp-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--border);
    background-color: color-mix(in srgb, var(--bg-primary) 92%, transparent);
    backdrop-filter: blur(14px);
  }
  .lp-nav-in {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    max-width: var(--content-wide);
    margin-inline: auto;
    padding: var(--space-3) var(--space-4);
  }
  .lp-brand {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-primary);
    text-decoration: none;
  }
  .lp-brand img {
    flex: none;
    width: 38px;
    height: 38px;
  }
  .lp-brand-txt {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    line-height: 1.15;
    white-space: nowrap;
  }
  .lp-brand-txt em {
    display: block;
    margin-top: 1px;
    color: var(--accent-text);
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-style: normal;
    letter-spacing: 0.34em;
  }

  .lp-menu {
    display: flex;
    margin: 0 0 0 auto;
    padding: 0;
    gap: var(--space-1);
    list-style: none;
  }
  .lp-mi {
    position: relative;
  }
  .lp-mi > a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .lp-mi:hover > a,
  .lp-mi > a:focus-visible {
    color: var(--text-primary);
  }
  /* Açılır liste olduğunu gösteren ok — yalnızca süs, metin de var. */
  .lp-mi.has > a::after {
    content: "";
    display: inline-block;
    width: 4px;
    height: 4px;
    margin-left: var(--space-2);
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    opacity: 0.55;
    transform: translateY(-1px) rotate(45deg);
  }

  .lp-drop {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: calc(var(--space-2) * -1);
    min-width: 17rem;
    padding: var(--space-2);
    border: 1px solid var(--border);
    background-color: var(--bg-elevated);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out),
      visibility var(--duration-normal);
  }
  /* :focus-within — klavyeyle de açılır, betik gerekmez. */
  .lp-mi:hover .lp-drop,
  .lp-mi:focus-within .lp-drop {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .lp-drop a,
  .lp-drop .is-soon {
    display: block;
    padding: var(--space-2) var(--space-3);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .lp-drop a:hover,
  .lp-drop a:focus-visible {
    background-color: var(--bg-overlay);
    color: var(--text-primary);
  }
  /* Hazır olmayan sayfa bağlantı DEĞİL: tıklanamaz, "yakında" yazar. */
  .lp-drop .is-soon {
    color: var(--text-muted);
    cursor: default;
  }
  .lp-drop a span,
  .lp-drop .is-soon span {
    display: block;
    margin-top: 1px;
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .lp-nav-cta {
    flex: none;
    margin-left: var(--space-3);
    padding: var(--space-2) var(--space-6);
    background-color: var(--accent);
    color: var(--bg-primary);
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--duration-fast) var(--ease-out);
  }
  .lp-nav-cta:hover {
    background-color: var(--accent-hover);
  }

  /* Mobil menü — <details>, betik yok. */
  .lp-burger {
    display: none;
    margin-left: auto;
  }
  .lp-burger > summary {
    padding: var(--space-2);
    list-style: none;
    cursor: pointer;
  }
  .lp-burger > summary::-webkit-details-marker {
    display: none;
  }
  .lp-burger > summary span {
    display: block;
    width: 22px;
    height: 1px;
    margin: 5px 0;
    background-color: var(--text-primary);
  }
  .lp-burger-panel {
    position: absolute;
    right: var(--space-4);
    left: var(--space-4);
    padding: var(--space-2);
    border: 1px solid var(--border);
    background-color: var(--bg-elevated);
    box-shadow: var(--shadow-lg);
  }
  .lp-burger-panel a {
    display: block;
    padding: var(--space-3);
    color: var(--text-secondary);
    text-decoration: none;
  }
  /* Grup basligi kalin ve birincil tonda; alt maddeler girintili ve kucuk.
     Boylece iki kapi yapisi mobilde de okunuyor, duz bir liste yigini
     olmuyor. */
  .lp-burger-grp {
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
  }
  .lp-burger-grp + .lp-burger-grp {
    padding-top: var(--space-2);
  }
  .lp-burger-panel a.is-head {
    color: var(--text-primary);
    font-weight: var(--fw-medium);
  }
  .lp-burger-panel a.is-sub {
    padding-block: var(--space-2);
    padding-left: var(--space-6);
    font-size: var(--text-sm);
  }
  .lp-burger-panel .is-soon {
    display: block;
    padding: var(--space-2) var(--space-3) var(--space-2) var(--space-6);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .lp-burger-panel a.is-cta {
    margin-top: var(--space-2);
    background-color: var(--accent);
    color: var(--bg-primary);
    font-weight: var(--fw-medium);
    text-align: center;
  }

  /* --- Hero -------------------------------------------------------------- */

  .lp-hero {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    min-height: 88svh;
  }
  /* Alt katman: hero videosu. Kadrajı doldurur, taşan kısmı kırpılır. */
  .lp-hero-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Tam güçte. Karartma perdenin ve metin siperinin işi — videoyu ayrıca
       soldurmak ikisini üst üste bindirip görüntüyü öldürüyordu. */
    opacity: 1;
    /* Perde kesildiği için video artık doğrudan görünüyor; derecelendirmenin
       çoğu encode'a taşındı (build_media.ts EQ). Burada yalnızca ekranda
       kalan son bir kademe var. */
    filter: saturate(1.16) contrast(1.06);
  }

  /*
   * Perde — videonun kendisi düzeltildikten SONRA ayarlandı.
   *
   * 2026-09-05: asıl sorun perde değildi. Kaynak videonun kendisi koyu
   * derecelenmişti ve kesim, başındaki 2 sn'lik uzay siyahı ile sonundaki
   * 1,5 sn'lik fade-to-black'i içeri alıyordu — 11,4 sn'lik döngünün %31'i
   * siyah geçiyordu, poster de 0. kareydi. Ölçüm (signalstats YAVG):
   *
   *   eski çıktı   en karanlık  31/255   ortalama   89/255
   *   yeni çıktı   en karanlık  76/255   ortalama  137/255
   *
   * 2026-09-05 (ikinci tur): kullanıcı "hâlâ çok koyu, fark edilmiyor"
   * dedi. Ölçüldü — bu kez suçlu perdeydi. Video medyanı 149/255, perdenin
   * çekirdeği %52; ekrana düşen ~70/255 idi, yani videonun yarısı perdede
   * kayboluyordu. Çekirdek %52 -> %20'ye indirildi, kenar karartması ve üst
   * bant da yarıya çekildi. Okunurluk tümüyle GLİF GÖLGESİNE bırakıldı:
   * gölge yalnızca harfin çevresini karartır, görüntüyü öldürmez.
   * Alt bant korundu — orası perde değil, sayfa zeminine geçiş.
   *
   * Video artık gerçekten parlak olduğu için perde AZALTILDI ama metnin
   * okunurluğu perdeye değil GLİF GÖLGESİNE bırakıldı (aşağıda): gölge
   * yalnızca harflerin çevresini karartır, görüntünün tamamını değil.
   *
   * İlk deneme %38'di; en parlak karede (çöl göğü, 8,5 sn) başlığın arkasına
   * düşen en parlak piksel 164/255 çıktı, ham kontrast 2,11:1 — perde
   * gökyüzünde yetmiyordu. Çekirdek %52'ye çıkarıldı ama elips DARALTILDI
   * (%62×70 → %56×64): metnin arkası kararıyor, kenarlar ve alt yarı açık
   * kalıyor. Görünen video eskisinden hâlâ çok daha parlak çünkü kaynağın
   * kendisi %54 parlaklaştı.
   *
   * Kontrast WCAG 1.4.3'ün dediği gibi HALEYLE ölçülüyor: gölge varsa
   * harfin komşu pikseli gölgedir, arka plan değil. Ölçüm DESIGN.md §8'de.
   */
  .lp-hero-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      /* Metin siperi — TAM GENİŞLİK. `.lp-hero-in` üzerinde olamaz: o kutu
         1180px'e kilitli, kenarında düz bir dikiş bırakıyordu. */
      /* 2026-09-06: kullanıcı üçüncü kez "perde çok koyu, görüntü
         anlaşılmıyor" dedi. Çekirdek DARALTILDI ve HAFİFLETİLDİ — kutunun
         dışı artık tamamen açık, karartma yalnızca metnin oturduğu dar
         elipste. Okunurluk perdeden değil glif halkasından geliyor. */
      radial-gradient(
        42% 46% at 50% 44%,
        color-mix(in srgb, var(--bg-primary) 24%, transparent) 0%,
        color-mix(in srgb, var(--bg-primary) 14%, transparent) 60%,
        transparent 100%
      ),
      radial-gradient(
        140% 115% at 50% 45%,
        transparent 0%,
        color-mix(in srgb, var(--bg-primary) 2%, transparent) 40%,
        color-mix(in srgb, var(--bg-primary) 5%, transparent) 70%,
        color-mix(in srgb, var(--bg-primary) 12%, transparent) 100%
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--bg-primary) 12%, transparent) 0%,
        color-mix(in srgb, var(--bg-primary) 3%, transparent) 20%,
        transparent 62%,
        color-mix(in srgb, var(--bg-primary) 58%, transparent) 92%,
        var(--bg-primary) 100%
      );
  }

  /* Açık modda perde kağıt tonudur, yani KARARTMAZ AÇAR. Video parlaklaştığı
     için opaklık 0,45'ten 0,55'e çıktı; koyu mürekkep metin zaten üstünde. */
  /*
   * 2026-09-05 (ucuncu tur): kullanici "arka goruntu yine perde arkasi"
   * dedi. Ekran goruntusu alinca sebep gorundu: ACIK MODDA video %55
   * opaklıktaydı, yani yarısı kağıt zeminine karışıyordu. Perde değil
   * videonun kendisi soluktu. Tam güce alındı; açık modda metin KOYU
   * mürekkep olduğu için tehlike parlak alan değil KARANLIK alandır —
   * perde bu yüzden karartmaz, AÇAR ve çekirdeği bir kademe artırıldı.
   */
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) .lp-hero-video {
      opacity: 1;
    }
    :root:not([data-theme="dark"]) .lp-hero-veil {
      background:
        radial-gradient(
          62% 70% at 50% 48%,
          color-mix(in srgb, var(--bg-primary) 32%, transparent) 0%,
          color-mix(in srgb, var(--bg-primary) 22%, transparent) 55%,
          transparent 100%
        ),
        radial-gradient(
          140% 115% at 50% 45%,
          transparent 0%,
          color-mix(in srgb, var(--bg-primary) 8%, transparent) 38%,
          color-mix(in srgb, var(--bg-primary) 20%, transparent) 66%,
          color-mix(in srgb, var(--bg-primary) 38%, transparent) 100%
        ),
        linear-gradient(
          to bottom,
          color-mix(in srgb, var(--bg-primary) 55%, transparent) 0%,
          color-mix(in srgb, var(--bg-primary) 12%, transparent) 22%,
          transparent 55%,
          color-mix(in srgb, var(--bg-primary) 70%, transparent) 88%,
          var(--bg-primary) 100%
        );
    }
  }
  :root[data-theme="light"] .lp-hero-video {
    opacity: 1;
  }

  /*
   * Metin siperi.
   *
   * Kenarlarda video tam görünsün diye perde hafifletildi; okunurluğu burada
   * garantiye alıyoruz. Kutu değil, yumuşak bir radyal — sınırı belli olmuyor.
   * Merkezde ~%50 karartma: tepe kare (160/255) için gereken %39'un üstünde.
   */
  .lp-hero-in {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--content-wide);
    margin-inline: auto;
    padding: var(--space-16) var(--space-4) var(--space-12);
    text-align: center;
  }
  /*
   * Glif gölgesi — okunurluğun ASIL taşıyıcısı.
   *
   * Perde bütün görüntüyü karartır; gölge yalnızca harfin çevresindeki
   * birkaç pikseli karartır. Aynı kontrastı görüntüyü öldürmeden verir.
   * İki katman: dar ve koyu olan kenarı keskinleştirir, geniş ve yumuşak
   * olan parlak karelerde harfin etrafına hale açar.
   */
  .lp-hero-in :is(h1, p, span) {
    /* Ölçüldü (haleyle, en parlak kare): tek dar katman 85% ile alıntı
       satırı p05 3,23:1, giriş paragrafı medyan 4,36:1 kalıyordu. 2px
       ötede gölge %34'e düşüyordu. İki dar katman (2px %95 + 4px %90)
       harfin 2px komşusunu ~%55 örtüyor; ölçüm DESIGN.md §8'de. */
    /* İlk iki katman TAM OPAK ve dar: harfin ~3px komşusunu neredeyse
       tamamen örterler. Ölçüm 2px komşuyu okuduğu için kontratı taşıyan
       katmanlar bunlar. Geniş ve yumuşak olanlar yalnızca geçişi yumuşatır;
       görüntünün geri kalanına dokunmazlar — perdenin aksine.

       Yarıçaplar ÖLÇÜMLE bulundu, tahminle değil. 1px+3px opak denendi:
       slogan 2,49:1'de kaldı (eşik 3,0). Slogan ince ve italik, glif
       çeperi dar; gölge 2px komşuya yeterince ulaşmıyordu. 2px+5px opak
       + 10px %92 ile ölçüm eşiklerin üstüne çıktı: slogan 3,04:1. Pay
       inceydi (eşik 3,0), 10px katmanı %97'ye çekildi — son ölçüm
       aşağıdaki tabloda, DESIGN.md §8'de. */
    text-shadow:
      0 0 3px var(--bg-primary),
      0 0 7px var(--bg-primary),
      0 0 13px color-mix(in srgb, var(--bg-primary) 98%, transparent),
      0 2px 24px color-mix(in srgb, var(--bg-primary) 84%, transparent),
      0 4px 46px color-mix(in srgb, var(--bg-primary) 60%, transparent);
  }
  /* Açık modda perde kağıt tonu, metin koyu mürekkep: hale ters düşer. */
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) .lp-hero-in :is(h1, p, span) {
      text-shadow: 0 1px 10px color-mix(in srgb, var(--bg-primary) 80%, transparent);
    }
  }
  :root[data-theme="light"] .lp-hero-in :is(h1, p, span) {
    text-shadow: 0 1px 10px color-mix(in srgb, var(--bg-primary) 80%, transparent);
  }
  /*
   * Giriş efekti — plan §13 (hareket kullanıcının denetiminde).
   *
   * JS YOK: saf CSS animasyonu, `script-src` kapalıyken de çalışır.
   *
   * Başlangıç durumu (opacity: 0) BASE KURALA YAZILMAZ, yalnızca keyframe'in
   * `from` adımında durur. Sebebi güvenlik: animasyon herhangi bir nedenle
   * çalışmazsa — tarayıcı desteklemiyorsa ya da aşağıdaki reduced-motion
   * kuralı `animation: none` yaparsa — element normal stiline döner ve
   * GÖRÜNÜR olur. Base kurala opacity:0 yazılsaydı metin kalıcı kaybolurdu.
   *
   * Gecikmeler okuma sırasını izler: logo, başlığın iki satırı, slogan,
   * giriş paragrafı, düğmeler, ayet. Toplam ~1,5 sn; ilk ekranın tamamı
   * bu süre içinde yerine oturuyor.
   */
  @keyframes lp-rise {
    from {
      opacity: 0;
      transform: translateY(1.1rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .lp-hero-in h1,
  .lp-hero-in .lp-l2,
  .lp-hero-sub,
  .lp-hero-lede,
  .lp-hero-acts,
  .lp-hero-verse {
    animation: lp-rise 800ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }
  .lp-hero-in h1 { animation-delay: 160ms; }
  /* İkinci satır kendi başına gelir: "Hayatına Taşı." vurgusu böyle çıkıyor.
     `span` blok yapılmadan transform uygulanamaz; .lp-l2 zaten blok. */
  .lp-hero-in .lp-l2 { animation-delay: 340ms; }
  .lp-hero-sub { animation-delay: 520ms; }
  .lp-hero-lede { animation-delay: 700ms; }
  .lp-hero-acts { animation-delay: 860ms; }
  .lp-hero-verse { animation-delay: 1020ms; }

  /* Hareketi azalt diyene hareket YOK — elementler doğrudan yerinde durur. */
  @media (prefers-reduced-motion: reduce) {
    .lp-hero-in h1,
    .lp-hero-in .lp-l2,
    .lp-hero-sub,
    .lp-hero-lede,
    .lp-hero-acts,
    .lp-hero-verse {
      animation: none;
    }
  }

  .lp-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin: 0 0 var(--space-6);
    color: var(--accent-text);
    font-size: var(--text-xs);
    letter-spacing: 0.3em;
  }
  .lp-eyebrow::before,
  .lp-eyebrow::after {
    content: "";
    width: 2.2rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent));
  }
  .lp-eyebrow::after {
    background: linear-gradient(90deg, var(--accent), transparent);
  }
  .lp-h1 {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-heading);
    font-size: var(--text-hero);
    font-weight: var(--fw-light);
    line-height: 1.02;
    letter-spacing: -0.015em;
  }
  .lp-h1 .lp-l2 {
    display: block;
    /* Koyu modda --accent-hover 11:1 veriyor; açık modda kağıt üzerinde
       1,51:1'e düşüyordu. Metin sürümü moda göre değişir. */
    color: var(--accent-hover);
    font-style: italic;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) .lp-h1 .lp-l2 {
      color: var(--accent-text);
    }
  }
  :root[data-theme="light"] .lp-h1 .lp-l2 {
    color: var(--accent-text);
  }
  /* Alıntı satırı — başlığın altında, serif ve italik. */
  .lp-hero-sub {
    max-width: 46rem;
    margin: var(--space-6) auto 0;
    color: var(--accent-hover);
    /* Açık mod karşılığı aşağıda — kağıt üzerinde 4,77:1. */
    font-family: var(--font-heading);
    /* En küçük boyut 1.5rem = 24px: WCAG "büyük metin" sınırı. Altına
       inerse eşik 3:1'den 4,5:1'e çıkar ve parlak karelerde kalır
       (ölçüldü: en parlak karede 3,83:1). */
    font-size: clamp(1.5rem, 2.6vw, 1.75rem);
    font-style: italic;
    font-weight: var(--fw-light);
    line-height: 1.45;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) .lp-hero-sub {
      color: var(--accent-text);
    }
  }
  :root[data-theme="light"] .lp-hero-sub {
    color: var(--accent-text);
  }

  /* Ne yaptığımızı anlatan satır; alıntının altında, sakin. */
  .lp-hero-lede {
    max-width: var(--content-normal);
    margin: var(--space-6) auto 0;
    /* Normal boyutlu metin, eşik 4,5:1. İkincil ton (#CFC7B6) en parlak
       karede medyan 4,36'da kalıyordu; birincil parşömen gerekli payı verdi. */
    color: var(--text-primary);
    font-size: var(--text-md);
    line-height: var(--lh-relaxed);
  }
  .lp-hero-acts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .lp-btn {
    padding: var(--space-3) var(--space-8);
    border: 1px solid transparent;
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    text-decoration: none;
    transition: all var(--duration-normal) var(--ease-out);
  }
  .lp-btn-p {
    background-color: var(--accent);
    color: var(--bg-primary);
  }
  .lp-btn-p:hover {
    background-color: var(--accent-hover);
  }
  .lp-btn-s {
    border-color: var(--accent-text);
    color: var(--accent-text);
  }
  .lp-btn-s:hover {
    background-color: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .lp-hero-verse {
    max-width: 34rem;
    margin: var(--space-12) auto 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-strong);
  }
  .lp-hv-ar {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-arabic);
    font-size: var(--text-ar-md);
    line-height: var(--lh-arabic);
  }
  .lp-hv-tr {
    margin: var(--space-3) 0 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-style: italic;
  }
  .lp-hv-src {
    margin: var(--space-2) 0 0;
    color: var(--accent-text);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* --- Ortak bölüm iskeleti ---------------------------------------------- */

  .lp-wrap {
    max-width: var(--content-wide);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
  .lp-sec {
    padding-block: var(--space-16);
  }
  @media (min-width: 48rem) {
    .lp-sec {
      padding-block: var(--space-24);
    }
  }
  .lp-h2 {
    margin: var(--space-6) 0 var(--space-3);
    color: var(--text-primary);
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: var(--fw-light);
    line-height: 1.14;
  }
  .lp-lead {
    max-width: var(--content-normal);
    margin: 0 0 var(--space-8);
    color: var(--text-secondary);
    font-size: var(--text-md);
    line-height: var(--lh-relaxed);
  }
  .lp-note {
    margin-top: var(--space-6);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  /* --- Neden farklı ------------------------------------------------------ */

  .lp-manifesto {
    border-block: 1px solid var(--border);
    background-color: var(--bg-elevated);
  }
  .lp-man-grid {
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 60rem) {
    .lp-man-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .lp-man-cell {
    padding: var(--space-12) var(--space-6);
    border-bottom: 1px solid var(--border);
  }
  .lp-man-cell:last-child {
    border-bottom: 0;
  }
  @media (min-width: 60rem) {
    .lp-man-cell {
      border-right: 1px solid var(--border);
      border-bottom: 0;
    }
    .lp-man-cell:last-child {
      border-right: 0;
    }
  }
  .lp-man-cell h3 {
    margin: 0 0 var(--space-3);
    color: var(--text-primary);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--fw-normal);
  }
  .lp-man-cell p {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: var(--lh-relaxed);
  }

  /* --- Beş kapı ---------------------------------------------------------- */

  .lp-gates {
    display: grid;
    grid-template-columns: 1fr;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    list-style: none;
  }
  @media (min-width: 40rem) {
    .lp-gates {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .lp-gates {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .lp-gate {
    position: relative;
    padding: var(--space-8) var(--space-6);
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    transition: background-color var(--duration-slow) var(--ease-out);
  }
  .lp-gate:hover {
    background-color: var(--bg-elevated);
  }
  .lp-gate-num {
    position: absolute;
    top: var(--space-6);
    right: var(--space-6);
    color: var(--accent-text);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    opacity: 0.45;
  }
  .lp-gate h3 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--fw-normal);
    line-height: 1.2;
  }
  .lp-gate h3,
  .lp-gate h3 a {
    color: var(--text-primary);
  }
  .lp-gate.is-soon h3,
  .lp-gate.is-soon h3 a {
    color: var(--text-muted);
  }
  /* Tasarımda açıklama yalnızca üzerine gelince açılıyordu; dokunmatik ve
     klavye kullanıcısı için her zaman görünür bırakıldı (plan §20.4
     erişilebilirlik). */
  .lp-gate p {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: var(--lh-normal);
  }

  /*
   * Gerilmiş bağlantı — kartın tamamı tıklanır (kullanıcı isteği 2026-09-05:
   * "ana sayfada olanlar tıklanır olsun ve ilgili bölümüne gitsin").
   *
   * Bağlantı başlıktadır; ::after ile kartı kaplar. Böylece ekran okuyucu
   * yine kısa bir metin duyar ("Kelime"), kart metnini bağlantı olarak
   * okumaz. Kap `position: relative` olmalı — .lp-gate, .lp-mod,
   * .lp-man-cell ve .lp-net-list li aşağıda öyle.
   */
  .lp-stretch {
    color: inherit;
    text-decoration: none;
  }
  .lp-stretch::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  /* Klavye odağı KARTIN kenarında görünür, harflerin değil. :has()
     desteklenmiyorsa varsayılan odak halkası harflerde kalır — hiç
     kalmamasından iyidir; bu yüzden outline:none @supports içinde. */
  @supports selector(:has(a)) {
    .lp-stretch:focus-visible {
      outline: none;
    }
    :is(.lp-gate, .lp-mod, .lp-man-cell, .lp-net-list li):has(.lp-stretch:focus-visible) {
      outline: 2px solid var(--accent);
      outline-offset: -2px;
    }
