---
import type { ContentClass } from "@kuran/schema";
import type { SourceRef } from "~/components/types";

/**
 * Kaynak rozeti — plan §12.10, CLAUDE.md kural 4, DESIGN.md §5.
 *
 * Bu bileşen projenin omurgasıdır: kaynaklı hiçbir içerik bu rozet olmadan
 * render edilmez. Kural yorum değil, kod: kaynaksız bir "kaynaklı" ya da
 * "alternatif" rozeti build'i durdurur (aşağıdaki throw).
 *
 * Üç içerik sınıfı yalnızca renkle değil, KENARLIK BİÇİMİ + METİN ile ayrışır
 * (DESIGN.md §1: "renk tek başına anlam taşımaz"). Gri baskıda ve renk
 * körlüğünde bilgi kaybolmaz.
 *
 * Sıfır JavaScript: kaynak listesi <details>/<summary> ile açılır.
 *
 * `compact`: aynı kaynağın onlarca kez tekrarlandığı yerler için (bir ayetin
 * 50 meali gibi) açılır panel yerine tek satır. Ölçüldü: tam rozet ~1,2 KB,
 * 50 kez tekrarlanınca ayet sayfasının %60'ını kaplıyordu. Kaynak bilgisi
 * kaybolmuyor — bölüm başında bir tam rozet duruyor, satırlarda kısası.
 */

interface Props {
  /** "kaynakli" | "alternatif" | "platform" — packages/schema/src/source.ts */
  contentClass: ContentClass;
  /** contentClass "platform" değilse en az bir kaynak ZORUNLUDUR. */
  sources?: readonly SourceRef[];
  /** Neyin kaynağı — ekran okuyucu için: "Bakara 153 meali" */
  label?: string;
  /** Açılır panel yok, tek satır. Aynı kaynağın tekrarlandığı listeler için. */
  compact?: boolean;
  class?: string;
}

const {
  contentClass,
  sources = [],
  label,
  compact = false,
  class: className,
} = Astro.props;

// --- Kural uygulaması (build zamanı) --------------------------------------
// Astro statik export ettiği için bu hatalar üretime çıkamaz; build patlar.
if (contentClass !== "platform" && sources.length === 0) {
  throw new Error(
    `<SourceBadge> kaynaksiz render edilemez: contentClass="${contentClass}"` +
      (label ? `, label="${label}"` : "") +
      ". Kaynakli icerik kaynagi gosterilmeden yayinlanmaz (plan 12.10).",
  );
}
if (contentClass === "platform" && sources.length > 0) {
  throw new Error(
    "<SourceBadge> contentClass=\"platform\" ise kaynak listesi bos olmalidir; " +
      "platform verisi kendi derlememizdir, disaridan bir kaynaga dayanmaz (plan 12.15). " +
      `Verilen: ${sources.map((s) => s.slug).join(", ")}`,
  );
}

const first = sources[0];
const extraCount = Math.max(0, sources.length - 1);

/** Rozetin üstünde görünen metin. */
const summaryText =
  contentClass === "platform"
    ? "Kendi derlememiz"
    : (contentClass === "alternatif" ? "Alternatif görüş — " : "") +
      (first?.name ?? "") +
      (extraCount > 0 ? ` +${extraCount} kaynak` : "");

/** Ekran okuyucuya sınıfı açıkça söyle; görsel kenarlığı duyamaz. */
const classNameForScreenReader: Record<ContentClass, string> = {
  kaynakli: "Kaynaklı bilgi",
  alternatif: "Alternatif görüş",
  platform: "Platform verisi",
};

/**
 * Kenarlık biçimi sınıfları.
 *
 * Tailwind yardımcı sınıf yığını yerine tek sınıf: bu rozet bir sure
 * sayfasında 286, bir ayet sayfasında 50 kez tekrarlanıyor. Uzun `class`
 * dizisi Bakara'da ~57 KB'a mal oluyordu. Stiller global.css § Bileşenler.
 */
const variantClass: Record<ContentClass, string> = {
  kaynakli: "is-kaynakli",
  alternatif: "is-alternatif",
  platform: "is-platform",
};

/**
 * Sınıf ikonu — DESIGN.md §6: kaynaklı "kitap", alternatif "çatal yol",
 * platform "küp". İnce çizgi, satır içi SVG (ağ isteği yok), `aria-hidden`:
 * anlamı zaten metin ve kenarlık taşıyor, ikon yalnızca hızlı tanıma içindir.
 */
const iconPath: Record<ContentClass, string> = {
  // açık kitap
  kaynakli: "M1 3.2c2.2-.9 3.9-.9 5 0 1.1-.9 2.8-.9 5 0v6.6c-2.2-.9-3.9-.9-5 0-1.1-.9-2.8-.9-5 0zM6 3.2v6.6",
  // çatallanan yol
  alternatif: "M6 11V7M6 7 3 3.5M6 7l3-3.5",
  // küp
  platform: "M6 1.2 10.5 3.6v4.8L6 10.8 1.5 8.4V3.6zM1.5 3.6 6 6l4.5-2.4M6 6v4.8",
};

/** Kaynak satırının alt bilgisi: eser · yazar · referans */
function metaLine(source: SourceRef): string {
  return [source.workTitle, source.author, source.reference]
    .filter((part): part is string => Boolean(part))
    .join(" · ");
}
---

<div
  class:list={["source-badge", variantClass[contentClass], compact && "is-compact", className]}
  data-content-class={contentClass}
>
  <span class="sr-only">
    {classNameForScreenReader[contentClass]}{label ? ` — ${label}` : ""}.
  </span>

  {
    sources.length === 0 || compact ? (
      <span class="badge-line">
        <svg
          class="badge-icon"
          width="12"
          height="12"
          viewBox="0 0 12 12"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d={iconPath[contentClass]} />
        </svg>
        {summaryText}
        {compact && sources.length > 0 && <span class="license"> · {first?.license}</span>}
      </span>
    ) : (
      <details>
        <summary class="badge-line">
          <svg
            class="badge-icon"
            width="12"
            height="12"
            viewBox="0 0 12 12"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d={iconPath[contentClass]} />
          </svg>
          <span>{summaryText}</span>
          <span class="toggle" data-show>
            Kaynakları göster
          </span>
          <span class="toggle" data-hide>
            Gizle
          </span>
        </summary>

        <ul class="source-list">
          {sources.map((source) => (
            <li>
              <span class="name">{source.name}</span>
              {metaLine(source) && <span class="meta">{metaLine(source)}</span>}
              <span class="license">Lisans: {source.license}</span>
              {source.url && (
                <a href={source.url} rel="noopener noreferrer" target="_blank">
                  Kaynağa git
                  <span class="sr-only"> (yeni sekmede açılır)</span>
                </a>
              )}
            </li>
          ))}
        </ul>
      </details>
    )
  }
</div>

{/* Stiller global.css'te (§ Bileşenler). Astro'nun scoped <style>'ı her
    öğeye data-astro-cid-* özniteliği ekliyor; 6236 ayet sayfası × onlarca
    öğede bu ciddi bayt. Sınıf adları benzersiz olduğu için kapsam kaybı yok. */}
