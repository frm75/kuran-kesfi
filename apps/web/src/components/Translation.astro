---
import {
  getScripture,
  getScriptureBooks,
  getScriptureQuotes,
  splitFootnoteMarkers,
  verseReferenceHref,
} from "~/lib/data";
import { splitVerseReferences } from "~/lib/footnote-refs";

/**
 * Tek bir meal bloğu — DESIGN.md §5: aynı bileşen her sayfada aynı görünür.
 *
 * Sure sayfası ve ayet sayfası aynı bloğu kullanır; tek fark hangi mealleri
 * verdikleridir.
 *
 * ## Kaynak zorunluluğu (plan §12.10)
 *
 * Kaynaksız meal gösterilmez — ama kaynağın NEREDE gösterildiği 2026-09-05'te
 * değişti. Önce her blok (ya da bölüm başı) kendi `<SourceBadge>` rozetini
 * taşıyordu; kullanıcı kararıyla o kutular içerik sayfalarından kaldırıldı:
 * "sadece meal veya tefsirlerin kime ait olduğunu yazacağız".
 *
 * Kaldırılan şey KUTU, atıf değil. Atıf üç yerde duruyor ve üçü de zorunlu:
 *   1. mealin sahibinin adı — bu bloğun başlığı (aşağıda)
 *   2. <Attribution> — Base.astro içinde, yani istisnasız her sayfanın altında
 *   3. /kaynaklar — eser, hazırlayan ve lisans dökümü
 * data/LICENSE (CC BY-NC-SA 4.0) bu üçüyle karşılanıyor.
 *
 * `sourceDeclaredBy` bu yüzden ARTIK ZORUNLU: kaynağın nerede bildirildiğini
 * yazmadan bir meal render edilemez. Boş geçilirse build durur. Değer HTML'e
 * yazılmaz — 7996 sayfa × ~20 meal, ölçülebilir bayt; kural build zamanında
 * uygulanıyor, çıktıda tekrarlanmasına gerek yok.
 *
 * ## Dipnottaki ayet atıfları (2026-09-06)
 *
 * Dipnot metni artık düz basılmıyor: içindeki ayet atıfları (`Bakara 2:83`,
 * `{{16:96}}Nahl 16/96{{/}}`) aynı mealin o ayetine bağlanıyor. Hangi atfın
 * bağlanacağına `~/lib/footnote-refs` karar verir; oradaki kural dar tutuldu
 * çünkü aynı biçimde Tevrat/İncil atıfları da var. Meal METNİ bu işlemden
 * geçmez — orada yalnızca `[1]` dipnot işaretleri ayrılır.
 *
 * Dipnottaki Tevrat/İncil atıfları da işaretlenir ve açılır bir kutuda o
 * ayetin KISA alıntısı gösterilir (en fazla 200 karakter, kaynak künyesi ve
 * yayıncı bağlantısıyla). Metin teliflidir, iktibas edilmiştir; sınırlar
 * `data/scripture/LICENSE.md`. Alıntısı olmayan atıf düz metin kalır.
 */

interface Footnote {
  number: number;
  text: string;
}

interface Props {
  authorName: string;
  authorSlug: string;
  text: string;
  footnotes: readonly Footnote[];
  /**
   * Kaynağın sayfada nerede bildirildiğini söyleyen kısa metin:
   * "sayfa altındaki kaynak listesi". Belge amaçlı — okuyan biri iddiayı
   * görüp doğrulayabilsin diye. Boş geçilemez.
   */
  sourceDeclaredBy: string;
  /** Dipnot çapaları sayfada benzersiz olmalı: "2-153-diyanet-isleri" */
  anchorPrefix: string;
  /** Dilin doğru sesle okunması için: "tr" veya "en" */
  lang?: string;
  /**
   * Yazar adını gizle.
   *
   * Sure sayfasında 286 ayetin meali de aynı kişiye ait; adı her blokta
   * tekrarlamak bilgi değil gürültü. Orada ad sayfa başlığındaki çipte
   * bir kez yazıyor. Ekran okuyucudan GİZLENMEZ: görsel olarak kaldırılan
   * başlık `sr-only` olarak yerinde kalır.
   */
  hideAuthor?: boolean;
}

const {
  authorName,
  authorSlug,
  text,
  footnotes,
  sourceDeclaredBy,
  anchorPrefix,
  lang = "tr",
  hideAuthor = false,
} = Astro.props;

if (sourceDeclaredBy.trim() === "") {
  throw new Error(
    `<Translation> kaynaksiz render edilemez: authorSlug="${authorSlug}", ` +
      `anchorPrefix="${anchorPrefix}". Kaynagin sayfada nerede bildirildigini ` +
      "'sourceDeclaredBy' ile yazin (plan 12.10).",
  );
}

const scripture = getScripture();
const books = getScriptureBooks();
const quotes = getScriptureQuotes();

const segments = splitFootnoteMarkers(
  text,
  footnotes.map((footnote) => footnote.number),
);

const footnoteId = (number: number): string => `dn-${anchorPrefix}-${number}`;
const markerId = (number: number): string => `dnr-${anchorPrefix}-${number}`;
---

<article class="translation" data-author={authorSlug}>
  <header>
    <h3 class:list={[hideAuthor && "sr-only"]}>{authorName}</h3>
  </header>

  <p lang={lang} class="translation-text">
    {
      segments.map((segment) =>
        segment.kind === "text" ? (
          segment.value
        ) : (
          <sup class="footnote-marker">
            <a id={markerId(segment.number)} href={`#${footnoteId(segment.number)}`}>
              <span class="sr-only">dipnot </span>
              {segment.number}
            </a>
          </sup>
        ),
      )
    }
  </p>

  {
    footnotes.length > 0 && (
      <div class="footnotes">
        <h4 class="sr-only">{authorName} — dipnotlar</h4>
        <ol>
          {footnotes.map((footnote) => (
            <li id={footnoteId(footnote.number)}>
              <a href={`#${markerId(footnote.number)}`} class="footnote-back">
                <span aria-hidden="true">↑</span>
                <span class="sr-only">metne dön, dipnot</span> {footnote.number}
              </a>{" "}
              {/* <details> akis icerigidir, <span> icinde gecersiz olurdu;
                  kapsayici div CSS ile satir ici gosteriliyor. */}
              <div lang={lang} class="footnote-text">
                {splitVerseReferences(footnote.text).map((segment) => {
                  if (segment.kind === "text") return segment.value;

                  if (segment.kind === "scripture") {
                    const book = books.get(segment.osisId);
                    const quote = quotes.get(
                      `${segment.osisId}.${String(segment.chapter)}.${String(segment.verse)}`,
                    );
                    // Alıntısı olmayan atıf düz metin kalır: metin uydurulmaz.
                    if (book === undefined || quote === undefined || scripture === null) {
                      return segment.label;
                    }
                    const canon = book.canon === "eski-ahit" ? "Eski Ahit" : "Yeni Ahit";
                    const merged = quote.spanEnd > quote.spanStart;
                    // Tek ifade: cok satirli JSX "2:" ile "13" arasina bosluk
                    // koyuyor ve kunye "2: 13" diye cikiyordu.
                    const cite = merged
                      ? `${book.nameTr} ${String(quote.chapter)}:${String(quote.spanStart)}-${String(quote.spanEnd)}`
                      : `${book.nameTr} ${String(quote.chapter)}:${String(quote.verse)}`;
                    return (
                      <details class="scripture-ref" data-canon={book.canon}>
                        {/* prettier-ignore */}
                        <summary><span class="scripture-label">{segment.label}</span><span class="sr-only"> — {canon}, {book.nameTr}; alıntıyı aç</span></summary>
                        <div class="scripture-quote">
                          <p class="scripture-cite">
                            {`${canon} · ${cite}`}
                            {merged && (
                              <span class="scripture-note"> (bu çeviride birlikte veriliyor)</span>
                            )}
                          </p>
                          <blockquote lang="tr">{quote.text}</blockquote>
                          <p class="scripture-source">
                            {scripture.source.name} — {scripture.source.publisher}.
                            {quote.truncated && " Alıntı 200 karakterde kesilmiştir."}{" "}
                            <a href={scripture.source.url} rel="nofollow noopener" target="_blank">
                              tam metin
                            </a>
                          </p>
                        </div>
                      </details>
                    );
                  }

                  const href = verseReferenceHref(authorSlug, segment.surahId, segment.verseNumber);
                  // Hedefi dogrulanamayan atif duz metin kalir (plan §1.5).
                  // Etiket tek satirda yazilir: cok satirli JSX baglantinin
                  // icine bosluk katiyor ve "(Bakara 2/40)" metni sayfada
                  // "( Bakara 2/40 )" oluyordu.
                  // prettier-ignore
                  return href === null ? segment.label : <a class="verse-ref" href={href}>{segment.label}</a>;
                })}
              </div>
            </li>
          ))}
        </ol>
      </div>
    )
  }
</article>

{/* Stiller global.css'te (§ Bileşenler) — scoped <style> her öğeye
    data-astro-cid-* ekliyor, 6236 sayfada gereksiz bayt. */}
