---
import type { Confidence } from "@kuran/schema";

/**
 * Güven derecesi rozeti — plan §12.9, DESIGN.md §1 ve §6.
 *
 * Konum, nüzul sırası, tarihsel olay, kıssa kronolojisi ve ayet ilişkilerinde
 * aynı üç değerli sistem kullanılır. Belirsizlik saklanmaz, gösterilir
 * (CLAUDE.md kural 5 / plan §1.5).
 *
 * Ayrışma üç kanaldan — renk tek başına anlam taşımaz (DESIGN.md §1):
 *   renk:      yeşil / altın / gri   (--confidence-* token'ları)
 *   işaret:    dolu / kesikli halka / şeffaf daire — harita pini diliyle aynı
 *   metin:     "kesin" / "muhtemel" / "rivayet"
 *
 * Gri baskıda ve renk körlüğünde ilk kanal düşer, diğer ikisi kalır.
 *
 * Görsel kurallar `global.css` → `.confidence-badge` içinde; renkler
 * `data-confidence` özniteliğine bağlı. Sıfır JavaScript, işaret satır içi SVG.
 */

interface Props {
  confidence: Confidence;
  /** Neyin güven derecesi — ekran okuyucu için: "Nüzul sırası" */
  label?: string;
  class?: string;
}

const { confidence, label, class: className } = Astro.props;
---

<span class:list={["confidence-badge", className]} data-confidence={confidence}>
  <svg width="8" height="8" viewBox="0 0 8 8" aria-hidden="true" focusable="false">
    {confidence === "kesin" && <circle cx="4" cy="4" r="3.2" fill="currentColor" />}
    {
      confidence === "muhtemel" && (
        <circle
          cx="4"
          cy="4"
          r="3"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-dasharray="2 1.6"
        />
      )
    }
    {
      confidence === "rivayet" && (
        <circle cx="4" cy="4" r="3" fill="none" stroke="currentColor" stroke-width="1" />
      )
    }
  </svg>

  <span class="sr-only">{label ? `${label} — güven derecesi: ` : "Güven derecesi: "}</span>
  <span>{confidence}</span>
</span>
