---
import type { Confidence } from "@kuran/schema";

/**
 * Güven derecesi rozeti — plan §12.9, DESIGN.md §1 ve §5.
 *
 * Konum, nüzul sırası, tarihsel olay, kıssa kronolojisi ve ayet ilişkilerinde
 * aynı üç değerli sistem kullanılır. Belirsizlik saklanmaz, gösterilir
 * (CLAUDE.md kural 5 / plan §1.5).
 *
 * Ayrışma kanalı üç katmanlı — renk tek başına anlam taşımaz:
 *   kenarlık:  düz / kesikli / noktalı
 *   işaret:    dolu / kesikli halkalı / şeffaf daire (harita pini diliyle aynı)
 *   metin:     "kesin" / "muhtemel" / "rivayet"
 *
 * Sıfır JavaScript, sıfır ağ isteği: işaret satır içi SVG.
 */

interface Props {
  confidence: Confidence;
  /** Neyin güven derecesi — ekran okuyucu için: "Nüzul sırası" */
  label?: string;
  class?: string;
}

const { confidence, label, class: className } = Astro.props;

const borderStyle: Record<Confidence, string> = {
  kesin: "border-solid",
  muhtemel: "border-dashed",
  rivayet: "border-dotted",
};

/**
 * Metin rengi. Üç ayrı hue kullanılmadı: 12px metinde AA kontrastını
 * (≥ 4.5:1) her iki modda tutan üç ayrı hue paleti gereksiz yere şişirirdi ve
 * DESIGN.md §0'daki sakin karakteri bozardı. Ayrışma kenarlık + işaret +
 * metinle zaten üç kanaldan sağlanıyor; renk yalnızca ağırlık veriyor.
 */
const toneClass: Record<Confidence, string> = {
  kesin: "text-text",
  muhtemel: "text-text-muted",
  rivayet: "text-text-muted",
};
---

<span
  class:list={[
    "confidence-badge inline-flex items-center gap-1 rounded-sm border px-2 py-0.5 text-xs",
    "border-line",
    borderStyle[confidence],
    toneClass[confidence],
    className,
  ]}
  data-confidence={confidence}
>
  <svg
    width="8"
    height="8"
    viewBox="0 0 8 8"
    aria-hidden="true"
    focusable="false"
    class="shrink-0"
  >
    {confidence === "kesin" && <circle cx="4" cy="4" r="3.2" fill="currentColor" />}
    {
      confidence === "muhtemel" && (
        <circle
          cx="4"
          cy="4"
          r="3"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-dasharray="2 1.6"
        />
      )
    }
    {
      confidence === "rivayet" && (
        <circle cx="4" cy="4" r="3" fill="none" stroke="currentColor" stroke-width="1" />
      )
    }
  </svg>

  <span class="sr-only">{label ? `${label} — güven derecesi: ` : "Güven derecesi: "}</span>
  <span>{confidence}</span>
</span>
