---
import type { Confidence, LocationConfidence } from "@kuran/schema";

/**
 * Güven derecesi rozeti — plan §12.9, DESIGN.md §1 ve §6.
 *
 * Belirsizlik saklanmaz, gösterilir (CLAUDE.md kural 4 / plan §1.5).
 *
 * BEŞ DEĞER TANIR, ama hiçbir sayfa beşini birden üretmez:
 *   konum      kesin · muhtemel · gelenek · tartismali   (LocationConfidence)
 *   kronoloji  kesin · muhtemel · rivayet                (Confidence)
 * İki enum bilerek ayrıdır: bir olayın tarihi "tartışmalı" olabilir ama
 * "gelenek" olamaz (packages/schema/src/common.ts).
 *
 * Ayrışma üç kanaldan — renk tek başına anlam taşımaz (DESIGN.md §1):
 *   renk:      yeşil / altın / firuze / kırmızı / gri
 *   işaret:    dolu · kalın halka · halka+nokta · iki halka · ince halka
 *              — harita pini diliyle BİREBİR aynı
 *   metin:     derecenin kendisi yazılır
 *
 * Gri baskıda ve renk körlüğünde ilk kanal düşer, diğer ikisi kalır.
 *
 * Görsel kurallar `global.css` → `.confidence-badge` içinde; renkler
 * `data-confidence` özniteliğine bağlı. Sıfır JavaScript, işaret satır içi SVG.
 */

interface Props {
  confidence: Confidence | LocationConfidence;
  /** Neyin güven derecesi — ekran okuyucu için: "Nüzul sırası" */
  label?: string;
  class?: string;
}

const { confidence, label, class: className } = Astro.props;
---

<span class:list={["confidence-badge", className]} data-confidence={confidence}>
  <svg width="8" height="8" viewBox="0 0 8 8" aria-hidden="true" focusable="false">
    {confidence === "kesin" && <circle cx="4" cy="4" r="3.2" fill="currentColor" />}
    {
      confidence === "muhtemel" && (
        <circle cx="4" cy="4" r="2.9" fill="none" stroke="currentColor" stroke-width="1.6" />
      )
    }
    {
      /* gelenek: halka + merkez nokta — gelenek bir noktayı işaret ediyor,
         halka teyit olmadığını söylüyor */
      confidence === "gelenek" && (
        <>
          <circle cx="4" cy="4" r="3" fill="none" stroke="currentColor" stroke-width="1" />
          <circle cx="4" cy="4" r="1.1" fill="currentColor" />
        </>
      )
    }
    {
      /* tartışmalı: iç içe iki ince halka — birden fazla aday, tek merkez yok */
      confidence === "tartismali" && (
        <>
          <circle cx="4" cy="4" r="3.3" fill="none" stroke="currentColor" stroke-width="0.9" />
          <circle cx="4" cy="4" r="1.6" fill="none" stroke="currentColor" stroke-width="0.9" />
        </>
      )
    }
    {
      /* rivayet yalnızca KRONOLOJİDE yaşar; konumda gelenek + tartışmalı oldu */
      confidence === "rivayet" && (
        <circle cx="4" cy="4" r="3" fill="none" stroke="currentColor" stroke-width="1" />
      )
    }
  </svg>

  <span class="sr-only">{label ? `${label} — güven derecesi: ` : "Güven derecesi: "}</span>
  <span>{confidence}</span>
</span>
