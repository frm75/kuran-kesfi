---
import { kirisYolu } from "~/lib/graf";
import type { GrafYerlesim } from "~/lib/graf";

interface Props {
  yerlesim: GrafYerlesim;
  /** SVG <title> — ekran okuyucu bunu okur */
  baslik: string;
  /** SVG <desc> — grafiğin ne gösterdiği */
  aciklama: string;
  /** Düğüm bağlantısının önü, örn "/kavram/" */
  hrefOnEk: string;
  /**
   * Grup (derinlik 0) düğümleri için AYRI href öneki — verilmezse `hrefOnEk`
   * kullanılır (kavram atlasının mevcut davranışı budur: üst kavramın kendi
   * `/kavram/<slug>` sayfası var, grup düğümü oraya gider).
   *
   * İlke atlasında alanın (`principle_area`) kendi sayfası YOK — yalnızca
   * ilkelerin `/ilke/<slug>` sayfası var. `hrefOnEk`'i alanlara da uygulamak
   * `/ilke/ibadet` gibi var olmayan bir adrese, yani 404'e, çıkardı. Bu prop
   * o durumda çağırana grup düğümlerini listedeki kendi bölümüne (`#<slug>`
   * capası) yönlendirme imkanı verir.
   */
  grupHrefOnEk?: string;
  /**
   * `<title>`/`<desc>` id'lerinin öneki — varsayılan "atlas".
   *
   * Sabit id'ler (`atlas-baslik`/`atlas-desc`) Plan 2'de tek atlaslı sayfalarda
   * sorun çıkarmadı, ama bileşen artık ikinci bir atlasta (ilke atlası) da
   * kullanılıyor. İki atlas aynı sayfada olsaydı `aria-labelledby` iki id'ye
   * birden çözülür, ikisi de yanlış adlandırılırdı — henüz olmadı ama id
   * çakışması sessiz bir erişilebilirlik hatasıdır, önceden kapatılıyor.
   */
  idOnEk?: string;
}

const { yerlesim, baslik, aciklama, hrefOnEk, grupHrefOnEk, idOnEk = "atlas" } = Astro.props;
const { dugumler, kenarlar, boyut } = yerlesim;
const merkez = boyut / 2;
const dugumBySlug = new Map(dugumler.map((d) => [d.slug, d]));
const baslikId = `${idOnEk}-baslik`;
const aciklamaId = `${idOnEk}-desc`;

/*
 * Grup rengi SVG'de sinif adiyla veriliyor, gomulu stille degil: CSP
 * style-src 'unsafe-inline' aciyor ama nitelik icinde renk yazmak temayla
 * degismeyen sabit renk demek olurdu. Sinif -> CSS degiskeni -> iki tema.
 *
 * Renk SLUG'a bagli, dizideki SIRAYA degil. Once index tabanliydi
 * (`gruplar.map((g,i) => ...i%8...)`) ve bu, grup sayfasinda (tek elemanli
 * `gruplar` dizisi, index hep 0) sekiz sayfanin sekizini de gr-1 yapiyordu
 * — ana atlastaki grup kimligi kendi sayfasinda kayboluyordu (olculdu:
 * dist/kavram/grup/*.html hepsi gr-1). Sekiz kavram grubu, ana atlasin
 * MEVCUT gorunumundeki renk sirasiyla sabitlendi ki ayni grup nerede
 * cizilirse cizilsin ayni renk cikssin.
 *
 * Bilinmeyen bir grup slug'i gelirse (ör. ilerideki ilke atlasi bu
 * bileseni kullanirsa) sabit listedeki degil kendi index'ine dusuluyor —
 * bilesen Kur'an kavram taksonomisine kilitlenmesin.
 */
const KAVRAM_GRUP_RENGI: Record<string, string> = {
  "tevhid-ve-allah": "gr-1",
  "vahiy-ve-peygamberlik": "gr-2",
  "iman-ve-kufur": "gr-3",
  "ahlak-ve-toplum": "gr-4",
  "amel-ve-ibadet": "gr-5",
  "ahiret-ve-hesap": "gr-6",
  "insan-ve-nefs": "gr-7",
  "imtihan-ve-kader": "gr-8",
};
const gruplar = [...new Set(dugumler.map((d) => d.grup))];
const grupSinifi = new Map(
  gruplar.map((g, i) => [g, KAVRAM_GRUP_RENGI[g] ?? `gr-${String((i % 8) + 1)}`]),
);
---

<figure class="atlas">
  <svg viewBox={`0 0 ${String(boyut)} ${String(boyut)}`} role="img" aria-labelledby={`${baslikId} ${aciklamaId}`}>
    <title id={baslikId}>{baslik}</title>
    <desc id={aciklamaId}>{aciklama}</desc>

    <g class="atlas-kenarlar">
      {
        kenarlar.map((k) => {
          const a = dugumBySlug.get(k.a);
          const b = dugumBySlug.get(k.b);
          if (a === undefined || b === undefined) return null;
          return (
            <path
              d={kirisYolu(a, b, merkez)}
              class={`kn kn-${k.type} ${k.origin === "computed" ? "kn-hesap" : "kn-elle"}`}
              fill="none"
            />
          );
        })
      }
    </g>

    <g class="atlas-dugumler">
      {
        dugumler.map((d) => (
          <a href={`${d.derinlik === 0 ? (grupHrefOnEk ?? hrefOnEk) : hrefOnEk}${d.slug}`}>
            {/* SVG'de erisilebilir ad ic <title>'dan gelir; <a>'nin ILK cocugu
                olmali (ad cozumlemesi boyle calisir). Grup dugumlerinin
                gorunur <text> etiketi var ama o SESLENDIRILMEZ diye degil,
                sadece gorsel — 101 yaprak dugumun (derinlik 1-2) ise HICBIR
                erisilebilir adi yoktu, ekran okuyucu hedefsiz "link" diyordu. */}
            <title>{d.label}</title>
            <circle cx={d.x} cy={d.y} r={d.r} class={`dg dg-${String(d.derinlik)} ${grupSinifi.get(d.grup) ?? ""}`} />
            {d.derinlik === 0 && (
              <text x={d.x} y={d.y - d.r - 6} class="dg-etiket" text-anchor="middle">
                {d.label}
              </text>
            )}
          </a>
        ))
      }
    </g>
  </svg>
</figure>
