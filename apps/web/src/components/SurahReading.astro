---
import MealSecici from "~/components/MealSecici.astro";
import Translation from "~/components/Translation.astro";
import VerseArabic from "~/components/VerseArabic.astro";
import {
  authorHasSurah,
  getAuthorsIndex,
  getDefaultAuthor,
  getSurah,
  getSurahSections,
  getSurahTranslation,
  getSurahsIndex,
  surahReadingPath,
  verseLabel,
} from "~/lib/data";
import { PERIOD_LABEL, periodOf } from "~/lib/nuzul";

/**
 * Klasik okuma ekraninin govdesi — plan §7, DESIGN.md §9 adim 4.
 *
 * Tek sutun, tek meal. Dort meali birden koymak Bakara'yi 300 KB'a cikarirdi
 * (olcum: scripts/build/README.md); meal karsilastirmasi ayet sayfasinin isi.
 *
 * JavaScript yok. Kenardaki ayet numarasi o ayetin kendi sayfasina gider;
 * ayni yere goturen gorunur "Ayet detayi" dugmesi ayetin altinda duruyor.
 *
 * ## Neden bilesen (2026-09-06)
 *
 * Ayni ekran iki adresten cikiyor: `/<sure>` (ontanimli meal, kanonik) ve
 * `/<sure>/meal/<yazar>` (secilen meal). Ikisi ayri dosyada yazilsaydi 200
 * satirlik okuma ekrani kopyalanir ve zamanla ayrisirdi — birinde duzeltilen
 * bir sey digerinde bozuk kalirdi. Sayfa dosyalari artik yalnizca <Base>
 * basligini ve hangi meali istediklerini soyluyor.
 *
 * ## 2026-09-05 duzeni
 *
 * Kaynak rozetleri kaldirildi (kullanici karari: mealin kime ait oldugu
 * yazsin yeter). Yasal atif kaybolmadi — <Attribution> her sayfanin altinda,
 * /kaynaklar yerinde duruyor (data/LICENSE, CC BY-NC-SA 4.0).
 *
 * Ayet numarasi metnin sonundan kenar bosluguna alindi ve ayet altindaki uc
 * parcali kunye satiri ("tek basina ac · Sayfa · Cuz") silindi: numara zaten
 * baglanti, sayfa ve cuz de sure basliginda yaziyor. Bakara'da bu 286 satir
 * eksiltiyor.
 */

interface Props {
  surahId: number;
  /** Hangi mealin gosterilecegi. Turkce meallerden biri olmali. */
  authorSlug: string;
}

const { surahId, authorSlug } = Astro.props;

const author = getAuthorsIndex().authors.find((item) => item.slug === authorSlug);
if (author === undefined) {
  throw new Error(`authors_index.json icinde '${authorSlug}' meali yok.`);
}

const surah = getSurah(surahId);
const index = getSurahsIndex().surahs;
const previous = index.find((item) => item.id === surahId - 1);
const next = index.find((item) => item.id === surahId + 1);

const isDefaultAuthor = author.slug === getDefaultAuthor().slug;

/**
 * Komsu sure ayni mealde acilir; o mealde o sure yoksa kanonik adrese duser.
 * Okuyucuyu bos bir sayfaya goturmektense ontanimli meale birakmak dogru.
 */
const neighbourHref = (slug: string, id: number): string =>
  authorHasSurah(author, id) ? surahReadingPath(slug, author.slug) : `/${slug}`;

const translation = getSurahTranslation(author.slug, surahId);
const translationByVerse = new Map(
  (translation?.verses ?? []).map((verse) => [verse.verseNumber, verse]),
);

/**
 * Besmele.
 *
 * Fatiha'da 1. ayettir, Tevbe'de (9) hic yoktur; diger 112 surede mushafta
 * sure basinda yer alir ama ayet sayilmaz. Metin uydurulmuyor — Fatiha'nin
 * 1. ayetinden aliniyor.
 */
const showBasmala = surahId !== 1 && surahId !== 9;
const basmala = showBasmala ? getSurah(1).verses[0]?.textUthmani : undefined;

const revelation = surah.revelationType === "mekki" ? "Mekkî" : "Medenî";
const period = periodOf(surah.revelationOrderNoldeke, surah.revelationType);

/**
 * Konu bölümlemesi — 2026-09-09'da okuma akışına girdi.
 *
 * Bakara 286 ayetlik tek düz listeydi: başlık yok, ara yok, dinlenme noktası
 * yok. Bölümleme 114 surenin hepsinde zaten vardı ve yalnızca ayet
 * sayfasında görünüyordu; asıl okunan yer burası (kullanıcı kararı
 * 2026-09-09). Bakara artık 44 bölüm.
 *
 * Başlıklar platform derlemesidir (plan §12.15) ve konu dizininin içinde öyle
 * yazıyor; bir tefsirden alınmış gibi sunulmaz.
 */
const sectioning = getSurahSections(surahId);
const sections = sectioning?.sections ?? [];

interface ReadingGroup {
  topic: (typeof sections)[number] | null;
  verses: typeof surah.verses;
}

/*
 * Ayetler konulara bölünür. Bölümleme yoksa ya da bir ayet hiçbir aralığa
 * düşmüyorsa AYET KAYBOLMAZ: kalanlar başlıksız son gruba girer. Linter
 * aralıkların bitişikliğini zaten denetliyor, bu yalnızca son emniyet.
 */
const groups: ReadingGroup[] = [];
const taken = new Set<number>();
for (const topic of sections) {
  const verses = surah.verses.filter(
    (v) => v.verseNumber >= topic.verseStart && v.verseNumber <= topic.verseEnd,
  );
  for (const v of verses) taken.add(v.verseNumber);
  if (verses.length > 0) groups.push({ topic, verses });
}
const leftover = surah.verses.filter((v) => !taken.has(v.verseNumber));
if (leftover.length > 0) groups.push({ topic: null, verses: leftover });

/**
 * Cüz sınırı düşen ayetler.
 *
 * Bakara cüz 1-3 arasına yayılıyor ve okurken nerede olunduğu belli değildi.
 * Sayfa işareti KONULMADI: Bakara 48 sayfa sürüyor, 48 işaret akışı bölerdi.
 * Surenin ilk ayeti işaretlenmez — cüz zaten başlıkta yazıyor.
 */
/*
 * Aralık etiketi TEK İFADE olarak üretilir.
 *
 * Şablonda `{start}{end !== start && ...}` yazınca Astro iki ifadenin arasına
 * boşluk koyuyor ve çıktı "1 –5" oluyor. Fonksiyon tek bir metin döndürür.
 */
const rangeLabel = (from: number, to: number): string =>
  from === to ? String(from) : `${String(from)}–${String(to)}`;

/*
 * Karşılaştırma sayfasında kaç meal olduğu — düğme metninde yazıyor.
 * Sabit "4" yazmak, öncelik listesi değişince sessizce yalan olurdu.
 */
const firstTopic = sections[0];

const compareAuthorCount = getAuthorsIndex().authors.filter(
  (item) => item.language === "tr" && item.priority !== null,
).length;

const juzStarts = new Set<number>();
let seenJuz: number | null = null;
for (const verse of surah.verses) {
  if (seenJuz !== null && verse.juz !== seenJuz) juzStarts.add(verse.verseNumber);
  seenJuz = verse.juz;
}
---

<main id="icerik" class="pg pg-normal">
  <nav aria-label="Konum" class="pg-crumb">
    <a href="/">Ana sayfa</a> <span aria-hidden="true">›</span>
    <a href="/sureler">Sureler</a> <span aria-hidden="true">›</span>
    {
      isDefaultAuthor ? (
        <span aria-current="page">{surah.nameTr}</span>
      ) : (
        <Fragment>
          <a href={`/${surah.slug}`}>{surah.nameTr}</a>{" "}
          <span aria-hidden="true">›</span>
          <span aria-current="page">{author.name} meali</span>
        </Fragment>
      )
    }
  </nav>

  <header class="pg-head">
    <p class="pg-kicker">{surah.id}. sure</p>
    <h1 class="pg-title">
      {surah.nameTr} Suresi
      <span lang="ar" dir="rtl" class="pg-title-ar">{surah.nameAr}</span>
    </h1>

    <ul class="chip-row">
      <li class="chip"><b>{surah.verseCount}</b> ayet</li>
      <li class="chip">
        {revelation}
        {period !== null && (
          <Fragment>
            <span aria-hidden="true"> · </span>
            {PERIOD_LABEL[period]}
          </Fragment>
        )}
      </li>
      <li class="chip">iniş sırası <b>{surah.revelationOrderStandard}</b></li>
      <li class="chip">sayfa <b>{surah.pageStart}</b></li>
      {/* Mealin sahibi metnin yanında yazar — kaynak kutusunun yerine geçen
          tek bilgi bu (kullanıcı kararı, 2026-09-05). 2026-09-06'da bu çip
          aynı zamanda meal geçişi oldu: adı okumak için açmak gerekmiyor,
          kapalı hâli eskisiyle aynı. */}
      <li>
        <MealSecici surahSlug={surah.slug} surahId={surah.id} currentSlug={author.slug} />
      </li>
      {/*
        Pasaj karşılaştırma kapısı. Önce her konu başlığında duruyordu; 44
        tekrar hem gürültüydü hem geç fark ediliyordu (kullanıcı kararı
        2026-09-09). Artık künye satırında, meal seçicinin sağında — okuyucu
        hangi mealde olduğunu görürken yanında "başkalarıyla karşılaştır"
        kapısını da görüyor.

        Hedef ilk konu; oradan önceki/sonraki konuyla ilerleniyor. Belirli bir
        bölümün karşılaştırmasına konu dizininden de girilebiliyor.
      */}
      {firstTopic !== undefined && (
        <li>
          <a class="chip-cta" href={`/${surah.slug}/karsilastir/${String(firstTopic.order)}`}>
            {compareAuthorCount} mealde karşılaştır
            <span class="sr-only"> — {surah.nameTr} suresi, bölüm bölüm</span>
            <span aria-hidden="true"> →</span>
          </a>
        </li>
      )}
    </ul>

    {/* Kesintisiz dinleme ve kelime takip isigi orada: bu sayfa betiksiz
        kaliyor (plan 04, spec 2). */}
    <p class="pg-dinle">
      <a href={`/dinle/${String(surah.id)}`}>
        Bu sureyi dinle — okunan kelime işaretlenir
      </a>
    </p>
  </header>

  {
    sections.length > 1 && (
      <details class="rd-index">
        <summary>
          Konu dizini <span class="rd-index-count">{sections.length} konu</span>
        </summary>
        <ol class="rd-index-list">
          {sections.map((topic) => (
            <li>
              <a href={`#konu-${String(topic.order)}`}>
                <span class="rd-index-title">{topic.title}</span>
                <span class="rd-index-range">{rangeLabel(topic.verseStart, topic.verseEnd)}</span>
              </a>
              {/* Belirli bir bölümü karşılaştırmanın yolu; okuma akışında
                  düğme yok, erişim burada duruyor. */}
              <a
                class="rd-index-cmp"
                href={`/${surah.slug}/karsilastir/${String(topic.order)}`}
              >
                karşılaştır
                <span class="sr-only"> — {topic.title}</span>
              </a>
            </li>
          ))}
        </ol>
        <p class="rd-index-note">
          {sectioning?.origin === "platform"
            ? "Konu başlıkları platform derlemesidir; bir tefsirden alınmamıştır."
            : "Konu başlıkları kaynaktan alınmıştır."}
        </p>
      </details>
    )
  }

  {
    basmala !== undefined && (
      <p lang="ar" dir="rtl" class="verse-arabic is-large border-border mb-8 border-b pb-6 text-center">
        {basmala}
      </p>
    )
  }

  {
    translation === null && (
      /* Belirsizlik saklanmaz (plan §1.5): mealin bu suresi kaynakta yok. */
      <p class="border-border text-text-secondary mb-8 rounded border border-dashed p-3 text-sm">
        {author.name} mealinde bu sure kaynakta bulunmuyor. Arapça metin aşağıda;
        diğer meallere yukarıdaki meal listesinden veya ayet sayfalarından
        ulaşabilirsiniz.
      </p>
    )
  }

  {
    groups.map((group) => (
      <section
        class="rd-topic"
        id={group.topic === null ? undefined : `konu-${String(group.topic.order)}`}
      >
        {group.topic !== null && (
          /* Başlık <ol>'un İÇİNE konamaz — <ol> yalnız <li> alır. Her konu
             kendi <section>'ında: başlık + o konunun ayet listesi. */
          <h2 class="rd-topic-head">
            <span class="rd-topic-title">{group.topic.title}</span>
            <span class="rd-topic-range">{rangeLabel(group.topic.verseStart, group.topic.verseEnd)}</span>
          </h2>
        )}

        <ol class="verse-list">
          {group.verses.map((verse) => {
            const meal = translationByVerse.get(verse.verseNumber);
            const label = verseLabel(surah.nameTr, verse.verseNumber);
            return (
              <li id={`ayet-${String(verse.verseNumber)}`}>
                {juzStarts.has(verse.verseNumber) && (
                  <p class="v-juz">
                    <span class="sr-only">Buradan itibaren </span>
                    cüz {verse.juz}
                  </p>
                )}
                <a class="v-num" href={`/${surah.slug}/${String(verse.verseNumber)}`}>
                  <span class="sr-only">{label} — tek başına aç</span>
                  <span aria-hidden="true">{verse.verseNumber}</span>
                </a>
                <div class="v-body">
                  <VerseArabic
                    text={verse.textUthmani}
                    verseNumber={verse.verseNumber}
                    label={label}
                    sajda={verse.sajda}
                  />

                  {verse.transcriptionTr !== null && (
                    <p lang="tr" class="transcription">
                      {verse.transcriptionTr}
                    </p>
                  )}

                  {meal === undefined ? (
                    <p class="text-text-secondary m-0 text-sm">
                      Bu ayetin {author.name} mealinde karşılığı kaynakta yok.
                    </p>
                  ) : (
                    <Translation
                      authorName={author.name}
                      authorSlug={author.slug}
                      text={meal.text}
                      footnotes={meal.footnotes}
                      sourceDeclaredBy="sayfa altındaki kaynak listesi"
                      anchorPrefix={`${String(surah.id)}-${String(verse.verseNumber)}-${author.slug}`}
                      hideAuthor
                    />
                  )}

                  {/*
                    Ayet sayfasina giren tek kapi kenardaki numaraydi; kimse onu
                    baglanti gibi gormedi (kullanici karari, 2026-09-08). Numara
                    yerinde duruyor, yaninda gorunur bir dugme var. Erisilebilir
                    ad ayet etiketini tasiyor: 286 tane "Ayet detayi" baglantisi
                    ekran okuyucuda ayirt edilemezdi.
                  */}
                  <p class="v-more">
                    <a class="v-detail" href={`/${surah.slug}/${String(verse.verseNumber)}`}>
                      Ayet detayı<span class="sr-only"> — {label}</span>{" "}
                      <span aria-hidden="true">→</span>
                    </a>
                  </p>
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    ))
  }

  <nav aria-label="Sureler arası gezinme" class="pg-nav">
    {
      previous === undefined ? (
        <span />
      ) : (
        <a href={neighbourHref(previous.slug, previous.id)}>
          <span aria-hidden="true">←</span> {previous.id}. {previous.nameTr}
        </a>
      )
    }
    <a href="/sureler">Bütün sureler</a>
    {
      next === undefined ? (
        <span />
      ) : (
        <a href={neighbourHref(next.slug, next.id)}>
          {next.id}. {next.nameTr} <span aria-hidden="true">→</span>
        </a>
      )
    }
  </nav>
</main>
