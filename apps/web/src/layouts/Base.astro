---
import "~/styles/global.css";
import Attribution from "~/components/Attribution.astro";
import { absoluteUrl, routePath } from "~/lib/site";

interface Props {
  title: string;
  description?: string;
  /**
   * Sayfada Arapça ayet metni var mı.
   *
   * Varsa Arapça font önceden yüklenir (39 KB). Yoksa yüklenmez: @font-face
   * unicode-range sayesinde tarayıcı zaten indirmez, preload etmek o kazancı
   * geri verirdi.
   */
  arabic?: boolean;
  /** Tanıtım sayfası kendi başlığını taşır; site şeridi çizilmez. */
  bareHeader?: boolean;
  /**
   * Sayfada meal/dipnot metni var mı.
   *
   * Varsa okuma serifi (Source Serif 4, 32 KB) önceden yüklenir. Tanıtım
   * sayfasında meal gövdesi yok — orada yüklenmez (plan §20.4 bütçesi).
   */
  reading?: boolean;
}

const {
  title,
  description,
  arabic = false,
  bareHeader = false,
  reading = false,
} = Astro.props;
const path = routePath(Astro.url.pathname);
const isCurrent = (href: string): boolean => path === href;

/**
 * Kanonik adres.
 *
 * Nginx `try_files $uri $uri.html` kullanıyor: `/bakara-suresi` ve
 * `/bakara-suresi.html` AYNI sayfayı veriyor. Kanonik olmadan arama motoru
 * bunları iki ayrı sayfa sayar.
 */
const canonical = absoluteUrl(path);
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    {/* Fontlar kendi sunucumuzdan gelir; CDN yok (plan §1.3, §1.7).
        crossorigin: aynı kaynakta bile font isteği CORS modunda gider —
        yoksa preload boşa çıkar ve dosya iki kez indirilir. */}
    <link rel="preload" href="/fonts/karla-latin.woff2" as="font" type="font/woff2" crossorigin />
    {/* Cormorant her sayfanın başlığında kullanılıyor; 51 KB. */}
    <link
      rel="preload"
      href="/fonts/cormorant-garamond-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      arabic && (
        <link
          rel="preload"
          href="/fonts/amiri-quran-arabic.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
    {
      reading && (
        <link
          rel="preload"
          href="/fonts/source-serif-latin.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }

    {/* Marka — DESIGN.md §10. Logo tek dosyadan türetildi (scripts/brand). */}
    <link rel="icon" href="/brand/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/brand/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />

    {/* Tarayıcı çerçevesi sayfa zeminiyle aynı olsun — iki temada iki değer. */}
    <meta name="theme-color" content="#071023" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#efe6d3" media="(prefers-color-scheme: light)" />

    <link rel="canonical" href={canonical} />

    {/* Paylaşım botları göreli adres çözmez; og:image MUTLAK olmak zorunda. */}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content="Kur'an-ı Kerim Keşfi" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteUrl("/brand/og-image.png")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kur'an-ı Kerim Keşfi" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Takip yok: analitik, ucuncu taraf cerez veya piksel eklenmez (plan 1.3) -->
  </head>
  <body>
    <a href="#icerik" class="skip-link">İçeriğe geç</a>

    {
      !bareHeader && (
        <div class="site-header">
          <div class="site-header-in">
            <a href="/" class="site-name">
              <img
                src="/brand/logo-48.webp"
                width="34"
                height="34"
                alt=""
                aria-hidden="true"
                class="site-mark"
              />
              Kur'an-ı Kerim Keşfi
            </a>
            <nav aria-label="Ana gezinme" class="site-nav">
              <a href="/sureler" aria-current={isCurrent("/sureler") ? "page" : undefined}>
                Sureler
              </a>
              <a href="/kissalar" aria-current={isCurrent("/kissalar") ? "page" : undefined}>
                Kıssalar
              </a>
              <a href="/zaman" aria-current={isCurrent("/zaman") ? "page" : undefined}>
                Zaman
              </a>
              <a href="/kavramlar" aria-current={isCurrent("/kavramlar") ? "page" : undefined}>
                Kavramlar
              </a>
              <a href="/kok" aria-current={isCurrent("/kok") ? "page" : undefined}>
                Kökler
              </a>
              <a href="/ilkeler" aria-current={isCurrent("/ilkeler") ? "page" : undefined}>
                İlkeler
              </a>
              <a href="/yazmalar" aria-current={isCurrent("/yazmalar") ? "page" : undefined}>
                Yazmalar
              </a>
              <a href="/harita" aria-current={isCurrent("/harita") ? "page" : undefined}>
                Harita
              </a>
              <a href="/kaynaklar" aria-current={isCurrent("/kaynaklar") ? "page" : undefined}>
                Kaynaklar
              </a>
            </nav>
          </div>
        </div>
      )
    }

    <slot />

    {/* Zorunlu atıf alanı — DESIGN.md §5. Her sayfada, istisnasız. */}
    <Attribution />
  </body>
</html>
