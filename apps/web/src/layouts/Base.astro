---
import "~/styles/global.css";
import Attribution from "~/components/Attribution.astro";

interface Props {
  title: string;
  description?: string;
  /**
   * Sayfada Arapça ayet metni var mı.
   *
   * Varsa Arapça font önceden yüklenir (39 KB). Yoksa yüklenmez: @font-face
   * unicode-range sayesinde tarayıcı zaten indirmez, preload etmek o kazancı
   * geri verirdi.
   */
  arabic?: boolean;
  /** Tanıtım sayfası kendi başlığını taşır; site şeridi çizilmez. */
  bareHeader?: boolean;
}

const { title, description, arabic = false, bareHeader = false } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string): boolean => path === href || path === `${href}/`;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    {/* Fontlar kendi sunucumuzdan gelir; CDN yok (plan §1.3, §1.7).
        crossorigin: aynı kaynakta bile font isteği CORS modunda gider —
        yoksa preload boşa çıkar ve dosya iki kez indirilir. */}
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    {/* Playfair her sayfanın başlığında kullanılıyor; 26 KB. */}
    <link
      rel="preload"
      href="/fonts/playfair-display-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      arabic && (
        <link
          rel="preload"
          href="/fonts/amiri-quran-arabic.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }

    <!-- Takip yok: analitik, ucuncu taraf cerez veya piksel eklenmez (plan 1.3) -->
  </head>
  <body>
    <a href="#icerik" class="skip-link">İçeriğe geç</a>

    {
      !bareHeader && (
        <div class="site-header">
          <div class="mx-auto flex max-w-wide flex-wrap items-baseline gap-x-6 gap-y-2 px-4">
            <a href="/" class="site-name">
              Kur'an-ı Kerim Keşfi
            </a>
            <nav aria-label="Ana gezinme" class="site-nav">
              <a href="/sureler" aria-current={isCurrent("/sureler") ? "page" : undefined}>
                Sureler
              </a>
              <a href="/kaynaklar" aria-current={isCurrent("/kaynaklar") ? "page" : undefined}>
                Kaynaklar
              </a>
            </nav>
          </div>
        </div>
      )
    }

    <slot />

    {/* Zorunlu atıf alanı — DESIGN.md §5. Her sayfada, istisnasız. */}
    <Attribution />
  </body>
</html>
