{
  "name": "@kuran/web",
  "version": "0.0.0",
  "private": true,
  "description": "Kur'an-i Kerim Kesif Platformu — Astro statik site",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm prepare:harita && ASTRO_TELEMETRY_DISABLED=1 astro dev --port ${SITE_PORT:-4321}",
    "build": "pnpm prepare:harita && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --port ${SITE_PORT:-4321}",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "prepare:harita": "node scripts/prepare-harita.mjs",
    "test:smoke": "tsx src/lib/gunluk/__tests__/fsrs.smoke.ts"
  },
  "dependencies": {
    "@kuran/schema": "workspace:*",
    "astro": "^5.18.2",
    "maplibre-gl": "^6.7.0",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
