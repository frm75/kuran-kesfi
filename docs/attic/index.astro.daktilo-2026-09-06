<style is:global>
  /* ==========================================================================
     Tanıtım sayfası — DESIGN.md §7, görsel dil docs/landing.html (2026-09-04).

     Bu blok YALNIZCA bu sayfaya yüklenir; okuma sayfalarının CSS bütçesini
     şişirmez. Renk/ölçü değerleri token'dan gelir, hex gömülmez.
     ======================================================================= */

  /* --- Menü ------------------------------------------------------------- */

  /* Tasarımda menü hero üzerinde saydam başlayıp kaydırınca katılaşıyordu;
     o davranış betik istiyor (CSP `default-src 'none'`). Bunun yerine menü
     her zaman katı: aynı okunaklılık, 0 bayt JS. */
  .lp-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--border);
    background-color: color-mix(in srgb, var(--bg-primary) 92%, transparent);
    backdrop-filter: blur(14px);
  }
  .lp-nav-in {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    max-width: var(--content-wide);
    margin-inline: auto;
    padding: var(--space-3) var(--space-4);
  }
  .lp-brand {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-primary);
    text-decoration: none;
  }
  .lp-brand img {
    flex: none;
    width: 38px;
    height: 38px;
  }
  .lp-brand-txt {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    line-height: 1.15;
    white-space: nowrap;
  }
  .lp-brand-txt em {
    display: block;
    margin-top: 1px;
    color: var(--accent-text);
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-style: normal;
    letter-spacing: 0.34em;
  }

  .lp-menu {
    display: flex;
    margin: 0 0 0 auto;
    padding: 0;
    gap: var(--space-1);
    list-style: none;
  }
  .lp-mi {
    position: relative;
  }
  .lp-mi > a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .lp-mi:hover > a,
  .lp-mi > a:focus-visible {
    color: var(--text-primary);
  }
  /* Açılır liste olduğunu gösteren ok — yalnızca süs, metin de var. */
  .lp-mi.has > a::after {
    content: "";
    display: inline-block;
    width: 4px;
    height: 4px;
    margin-left: var(--space-2);
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    opacity: 0.55;
    transform: translateY(-1px) rotate(45deg);
  }

  .lp-drop {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: calc(var(--space-2) * -1);
    min-width: 17rem;
    padding: var(--space-2);
    border: 1px solid var(--border);
    background-color: var(--bg-elevated);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out),
      visibility var(--duration-normal);
  }
  /* :focus-within — klavyeyle de açılır, betik gerekmez. */
  .lp-mi:hover .lp-drop,
  .lp-mi:focus-within .lp-drop {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .lp-drop a,
  .lp-drop .is-soon {
    display: block;
    padding: var(--space-2) var(--space-3);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .lp-drop a:hover,
  .lp-drop a:focus-visible {
    background-color: var(--bg-overlay);
    color: var(--text-primary);
  }
  /* Hazır olmayan sayfa bağlantı DEĞİL: tıklanamaz, "yakında" yazar. */
  .lp-drop .is-soon {
    color: var(--text-muted);
    cursor: default;
  }
  .lp-drop a span,
  .lp-drop .is-soon span {
    display: block;
    margin-top: 1px;
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .lp-nav-cta {
    flex: none;
    margin-left: var(--space-3);
    padding: var(--space-2) var(--space-6);
    background-color: var(--accent);
    color: var(--bg-primary);
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--duration-fast) var(--ease-out);
  }
  .lp-nav-cta:hover {
    background-color: var(--accent-hover);
  }

  /* Mobil menü — <details>, betik yok. */
  .lp-burger {
    display: none;
    margin-left: auto;
  }
  .lp-burger > summary {
    padding: var(--space-2);
    list-style: none;
    cursor: pointer;
  }
  .lp-burger > summary::-webkit-details-marker {
    display: none;
  }
  .lp-burger > summary span {
    display: block;
    width: 22px;
    height: 1px;
    margin: 5px 0;
    background-color: var(--text-primary);
  }
  .lp-burger-panel {
    position: absolute;
    right: var(--space-4);
    left: var(--space-4);
    padding: var(--space-2);
    border: 1px solid var(--border);
    background-color: var(--bg-elevated);
    box-shadow: var(--shadow-lg);
  }
  .lp-burger-panel a {
    display: block;
    padding: var(--space-3);
    color: var(--text-secondary);
    text-decoration: none;
  }
  .lp-burger-panel a.is-cta {
    margin-top: var(--space-2);
    background-color: var(--accent);
    color: var(--bg-primary);
    font-weight: var(--fw-medium);
    text-align: center;
  }

  /* --- Hero -------------------------------------------------------------- */

  .lp-hero {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    min-height: 88svh;
  }
  /* Alt katman: hero videosu. Kadrajı doldurur, taşan kısmı kırpılır. */
  .lp-hero-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Tam güçte. Karartma perdenin ve metin siperinin işi — videoyu ayrıca
       soldurmak ikisini üst üste bindirip görüntüyü öldürüyordu. */
    opacity: 1;
    /* Perde kesildiği için video artık doğrudan görünüyor; derecelendirmenin
       çoğu encode'a taşındı (build_media.ts EQ). Burada yalnızca ekranda
       kalan son bir kademe var. */
    filter: saturate(1.16) contrast(1.06);
  }

  /*
   * Alt gecis seridi — eskiden "perde" idi, artik degil.
   *
   * Tarihce (kisa): kaynak video koyu derecelenmisti; duzeltildi. Sonra
   * perdenin kendisi suclu cikti; kademe kademe %52 -> %38 -> %24'e indi.
   * Her turda kullanici "hala anlasilmiyor" dedi ve her turda perde
   * hafifledikce metin kontrasti esige yaklasti. Dorduncu turda kullanici
   * dugumu kesti: PERDE OLMASIN, metin kalin ve buyuk olsun.
   *
   * Yapilan tam olarak bu. Goruntuyu karartan uc katman (metin siperi
   * elipsi, vinyet, ust bant) SILINDI. Kalan tek katman videonun sayfa
   * zeminine baglandigi alt seritdir — o karartma degil, dikis kapatmadir.
   * Silinirse hero'nun bittigi yerde keskin bir yatay cizgi kaliyor.
   *
   * Okunurluk artik iki seyden geliyor, ikisi de YEREL:
   *   1. Metnin kendi agirligi: 300 -> 500 (Cormorant'in gercek ust siniri;
   *      600 istenirse font 300-500 araligindan yeniden ornekelenmeli,
   *      yoksa tarayici sahte kalin uretir).
   *   2. Glif halesi (asagida): yalnizca harfin cevresindeki birkac pikseli
   *      karartir, goruntunun geri kalanina dokunmaz.
   *
   * Ayni kural acik modda ters yonde calisir: --bg-primary kagit tonudur,
   * yani hale KARARTMAZ ACAR ve koyu murekkep metni ayakta tutar. Tek
   * kural iki modu da kapsadigi icin acik mod ayrik tanimi kaldirildi.
   */
  .lp-hero-fade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 66%,
      color-mix(in srgb, var(--bg-primary) 22%, transparent) 82%,
      color-mix(in srgb, var(--bg-primary) 62%, transparent) 93%,
      var(--bg-primary) 100%
    );
  }

  /*
   * Metin siperi.
   *
   * Kenarlarda video tam görünsün diye perde hafifletildi; okunurluğu burada
   * garantiye alıyoruz. Kutu değil, yumuşak bir radyal — sınırı belli olmuyor.
   * Merkezde ~%50 karartma: tepe kare (160/255) için gereken %39'un üstünde.
   */
  .lp-hero-in {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--content-wide);
    margin-inline: auto;
    padding: var(--space-16) var(--space-4) var(--space-12);
    text-align: center;
  }
  /*
   * Glif halesi — perde kalktiktan sonra okunurlugun TEK tasiyicisi.
   *
   * Perde butun goruntuyu karartir; hale yalnizca harfin cevresindeki
   * birkac pikseli karartir. Ayni kontrasti goruntuyu oldurmeden verir.
   *
   * Renk `--bg-primary` oldugu icin TEK KURAL iki modu da kapsar: koyu
   * modda hale karartir (acik metnin arkasi), acik modda kagit tonuyla
   * ACAR (koyu murekkebin arkasi). Onceki surumde acik mod icin ayri ve
   * daha zayif bir golge vardi; olcumde acik mod meal satiri 4,43:1 ile
   * kaliyordu. Ayrim kaldirildi.
   *
   * DERINLIK OGEYE GORE DEGISIR — bu kasitli. Tek bir global deger ise
   * yaramiyor, olculdu:
   *   - 13px opak: baslik gecti, slogan 2,40:1'de kaldi (esik 3,0).
   *   - 26px opak: hepsi gecti AMA 18px'lik giris paragrafinin arkasi
   *     dumduz siyah bir bloga dondu — yani perdeyi kapidan kovup
   *     pencereden geri almis olduk. Ekran goruntusuyle gorulup birakildi.
   * Cozum: hale yaricapi METNIN BOYUYLA ORANTILI. Buyuk baslikta 28px
   * bir isima, kucuk metinde ayni deger bir levha.
   *
   * Olcum HALEYLE yapilir (WCAG 1.4.3): iki kare cekilir, ikincisinde
   * metin rengi seffaftir; farki glif maskesidir, maskeye 2px komsuluktaki
   * EN KOTU piksel arka plan sayilir. Yordam DESIGN.md §8'de.
   */
  .lp-hero-in :is(h1, p, span) {
    text-shadow:
      0 0 2px var(--bg-primary),
      0 0 4px var(--bg-primary),
      0 0 7px var(--bg-primary),
      0 0 10px var(--bg-primary),
      0 0 14px var(--bg-primary),
      0 0 20px color-mix(in srgb, var(--bg-primary) 80%, transparent),
      0 0 32px color-mix(in srgb, var(--bg-primary) 55%, transparent),
      0 4px 56px color-mix(in srgb, var(--bg-primary) 35%, transparent);
  }
  /*
   * Slogan hero'nun EN ZOR satiri: 32px, altin (parsomenden daha koyu) ve
   * kadrajda tam gunes parlamasinin uzerine dusuyor. Temel haleyle 2,55:1
   * kaliyordu. Derin hale burada levha yapmiyor cunku yaricap (28px) metin
   * boyunun altinda — isima gibi okunuyor.
   */
  .lp-hero-sub,
  .lp-hero-sub span {
    text-shadow:
      0 0 2px var(--bg-primary),
      0 0 4px var(--bg-primary),
      0 0 6px var(--bg-primary),
      0 0 9px var(--bg-primary),
      0 0 12px var(--bg-primary),
      0 0 16px var(--bg-primary),
      0 0 20px var(--bg-primary),
      0 0 28px color-mix(in srgb, var(--bg-primary) 75%, transparent),
      0 0 44px color-mix(in srgb, var(--bg-primary) 45%, transparent);
  }
  /* Meal satiri kucuk ve uzun; acik modda sinirdaydi (4,43 -> 4,53). */
  .lp-hv-tr {
    text-shadow:
      0 0 2px var(--bg-primary),
      0 0 4px var(--bg-primary),
      0 0 6px var(--bg-primary),
      0 0 9px var(--bg-primary),
      0 0 13px var(--bg-primary),
      0 0 18px var(--bg-primary),
      0 0 26px color-mix(in srgb, var(--bg-primary) 75%, transparent),
      0 0 42px color-mix(in srgb, var(--bg-primary) 45%, transparent);
  }
  /*
   * Dugmelerin KENDI zemini var; hale uzerlerinde kirli bir leke
   * birakiyordu (ekran goruntusuyle gorulup kaldirildi).
   */
  .lp-hero-acts .lp-btn {
    text-shadow: none;
  }
  /*
   * Giris efekti — plan §13 (hareket kullanicinin denetiminde).
   *
   * JS YOK. Ana sayfada `script-src` kapali (CSP `default-src 'none'`);
   * daktilo efektinin JS ile yazilmasi CSP'yi acmayi gerektirirdi, o da
   * ayri onay ister. Onun yerine efekt tamamen CSS: her satir kendi
   * kutusunda, `clip-path` ile soldan aciliyor, `steps(N)` acilmayi harf
   * sayisi kadar kademeye boluyor. Gorunen sonuc daktilodur.
   *
   * Baslangic durumu (kirpilmis / opacity 0) BASE KURALA YAZILMAZ, yalnizca
   * keyframe'in `from` adiminda durur. Sebep guvenlik: animasyon herhangi
   * bir nedenle calismazsa element normal stiline doner ve GORUNUR olur.
   * Base kurala yazilsaydi metin kalici kaybolurdu.
   *
   * Sira ve ritim: ~38 harf/sn.
   *   250 ms  "Oku. Anla. Kesfet."            18 harf   470 ms
   *   800 ms  "Hayatina Tasi."                14 harf   370 ms
   *  1280 ms  "Kur'an'i okumak..."            33 harf   870 ms
   *  2250 ms  "Anlamak bir yolculuk..."       43 harf  1130 ms
   *  3520 ms  giris paragrafi, dugmeler, ayet — bunlar daktilo DEGIL,
   *           yumusak yukselisle gelir: cok satirli bloklar, `clip-path`
   *           soldan acilinca butun satirlari ayni anda acardi.
   *
   * Yazi bir kez yazilir ve KALIR (`both`). Video altta donguye devam eder;
   * dongunun sonundaki bekleme encode'a gomuludur (build_media.ts HOLD).
   */
  @keyframes lp-rise {
    from {
      opacity: 0;
      transform: translateY(1.1rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes lp-type {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes lp-caret {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }

  /*
   * Daktilo satiri.
   *
   * `padding` + negatif `margin-block`: clip-path SINIR KUTUSUNDAN keser,
   * glif halesi ise kutunun disina tasar. Dolgu olmadan hale kirpilir ve
   * parlak videonun uzerinde harflerin cevresinde keskin bir dikdortgen
   * kenari gorunur. 34px dolgu halenin tasiyici katmanlarini (3/7/13/24px)
   * tamamen icine alir; negatif dikey pay dolgunun yer kaplamasini geri
   * verir, yani satir araligi degismez. Yatay dolgu zaten kaymaya yol
   * acmaz: kutu `fit-content` ve ortalanmis.
   *
   * `flow-root` ust ogede: negatif dikey payin ust kutunun disina tasip
   * cevredeki bosluklari bozmasini engeller (margin collapsing).
   */
  .lp-h1,
  .lp-hero-sub {
    display: flow-root;
  }
  .lp-tw {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    padding: 34px;
    margin-block: -34px;
    white-space: nowrap;
    clip-path: inset(0 0 0 0);
    animation: lp-type 470ms steps(18, end) 250ms both;
  }
  .lp-tw-2 {
    animation: lp-type 370ms steps(14, end) 800ms both;
  }
  .lp-tw-3 {
    animation: lp-type 870ms steps(33, end) 1280ms both;
  }
  .lp-tw-4 {
    animation: lp-type 1130ms steps(43, end) 2250ms both;
  }
  /* Imlec — yalnizca son satirin ucunda, alti kez yanip soner ve kaybolur.
     Base `opacity: 0`: animasyon calismazsa hic gorunmez, cunku tamamen
     dekoratiftir. */
  .lp-tw-4::after {
    content: "";
    display: inline-block;
    width: 0.07em;
    height: 0.95em;
    margin-left: 0.14em;
    vertical-align: -0.1em;
    background: currentColor;
    opacity: 0;
    animation: lp-caret 900ms steps(1, end) 3380ms 6 forwards;
  }

  .lp-hero-lede,
  .lp-hero-acts,
  .lp-hero-verse {
    animation: lp-rise 800ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }
  .lp-hero-lede { animation-delay: 3520ms; }
  .lp-hero-acts { animation-delay: 3820ms; }
  .lp-hero-verse { animation-delay: 4080ms; }

  /*
   * Dar ekranda daktilo YOK. Efekt `white-space: nowrap` gerektiriyor —
   * kirpma soldan sag saga tek satir boyunca ilerler; satir sararsa butun
   * satirlar ayni anda acilir ve efekt bozulur. Nowrap birakilsa bu kez
   * metin ekrandan tasardi. Dar ekranda satirlar yumusak yukselisle gelir.
   */
  @media (max-width: 680px) {
    .lp-tw {
      width: auto;
      white-space: normal;
      padding: 0;
      margin-block: 0;
      animation: lp-rise 800ms cubic-bezier(0.22, 0.61, 0.36, 1) 250ms both;
    }
    .lp-tw-2 { animation-delay: 500ms; }
    .lp-tw-3 { animation-delay: 750ms; }
    .lp-tw-4 { animation-delay: 1000ms; }
    .lp-tw-4::after { display: none; }
    /* Dar ekranda slogan satirlari birbirine yaklasir ve iki halka
       birlesip tam genislikte bir bant olusturur. Aralik acildi; hale
       gucune DOKUNULMADI cunku olcumde mobilde de gerekiyor. */
    .lp-hero-sub {
      line-height: 1.3;
    }
    .lp-hero-sub .lp-tw + .lp-tw {
      margin-top: 0.8em;
    }
    .lp-hero-lede { animation-delay: 1250ms; }
    .lp-hero-acts { animation-delay: 1500ms; }
    .lp-hero-verse { animation-delay: 1750ms; }
  }

  /* Hareketi azalt diyene hareket YOK — ogeler dogrudan yerinde durur. */
  @media (prefers-reduced-motion: reduce) {
    .lp-tw,
    .lp-hero-lede,
    .lp-hero-acts,
    .lp-hero-verse {
      animation: none;
    }
    .lp-tw-4::after {
      display: none;
    }
  }

  .lp-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin: 0 0 var(--space-6);
    color: var(--accent-text);
    font-size: var(--text-xs);
    letter-spacing: 0.3em;
  }
  .lp-eyebrow::before,
  .lp-eyebrow::after {
    content: "";
    width: 2.2rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent));
  }
  .lp-eyebrow::after {
    background: linear-gradient(90deg, var(--accent), transparent);
  }
  /*
   * 2026-09-06: perde kalkti, okunurlugu artik metnin kendisi tasiyor.
   * 300 -> 500. 500 KEYFI DEGIL, Cormorant'in bu projedeki GERCEK ust
   * siniri: font wght 300-500 araliginda ornekelenmis (global.css §0,
   * 50,8 KB). 600 yazilsaydi tarayici sahte kalin uretirdi — goruntu
   * serifinde bu bulanik ve kirli cikar. Daha kalin gerekirse cozum CSS
   * degil, fontu 300-600 olarak yeniden uretmektir (~+3 KB).
   */
  .lp-h1 {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-heading);
    font-size: var(--text-hero);
    font-weight: var(--fw-medium);
    line-height: 1.02;
    letter-spacing: -0.015em;
  }
  .lp-h1 .lp-l2 {
    display: block;
    /* Koyu modda --accent-hover 11:1 veriyor; açık modda kağıt üzerinde
       1,51:1'e düşüyordu. Metin sürümü moda göre değişir. */
    color: var(--accent-hover);
    font-style: italic;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) .lp-h1 .lp-l2 {
      color: var(--accent-text);
    }
  }
  :root[data-theme="light"] .lp-h1 .lp-l2 {
    color: var(--accent-text);
  }
  /* Alıntı satırı — başlığın altında, serif ve italik. */
  .lp-hero-sub {
    max-width: 46rem;
    margin: var(--space-6) auto 0;
    /*
     * 2026-09-06: altin (--accent-hover) iken hero'nun en zor satiriydi.
     * Parsomenden koyu oldugu icin gunes parlamasinin uzerinde 2,55:1'de
     * kaliyordu ve gecmesi icin 28px'lik bir hale gerekiyordu — o hale de
     * mobilde satirin arkasini tam genislikte bir banda ceviriyordu.
     *
     * Renk birincil metne alindi: koyu modda parsomen, acik modda murekkep.
     * Daha parlak/koyu oldugu icin ayni kontrast 20px hale ile saglaniyor,
     * bant kayboluyor. Altin vurgu KAYBOLMUYOR — basligin ikinci satirinda
     * duruyor; asil vurgunun orada olmasi hiyerarsiyi de duzeltiyor.
     *
     * Tek kural iki modu da kapsadigi icin acik mod ayrik tanimi kaldirildi.
     */
    color: var(--text-primary);
    font-family: var(--font-heading);
    /* En küçük boyut 1.5rem = 24px: WCAG "büyük metin" sınırı. Altına
       inerse eşik 3:1'den 4,5:1'e çıkar ve parlak karelerde kalır
       (ölçüldü: en parlak karede 3,83:1). */
    font-size: clamp(1.6rem, 2.9vw, 2rem);
    font-style: italic;
    font-weight: var(--fw-medium);
    line-height: 1.45;
  }

  /* Ne yaptığımızı anlatan satır; alıntının altında, sakin. */
  .lp-hero-lede {
    max-width: var(--content-normal);
    margin: var(--space-6) auto 0;
    /* Normal boyutlu metin, eşik 4,5:1. İkincil ton (#CFC7B6) en parlak
       karede medyan 4,36'da kalıyordu; birincil parşömen gerekli payı verdi. */
    color: var(--text-primary);
    /*
     * 1,5rem = 24px. Bu KEYFI DEGIL: WCAG'nin "buyuk metin" sinirin tam
     * kendisi. Altinda esik 4,5:1, ustunde 3,0:1. Perde kalkinca 18px'te
     * 3,94:1'de kaliyordu; buyutuldu ve hem kullanicinin istedigi "buyuk
     * ve okunakli" karsilandi hem de esik dogru yere oturdu.
     */
    font-size: 1.5rem;
    /* Karla 300-600 arasi ornekelenmis: 500 gercek agirliktir, sahte
       kalin degil. */
    font-weight: var(--fw-medium);
    line-height: var(--lh-relaxed);
  }
  .lp-hero-acts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .lp-btn {
    padding: var(--space-3) var(--space-8);
    border: 1px solid transparent;
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    text-decoration: none;
    transition: all var(--duration-normal) var(--ease-out);
  }
  .lp-btn-p {
    background-color: var(--accent);
    color: var(--bg-primary);
  }
  .lp-btn-p:hover {
    background-color: var(--accent-hover);
  }
  .lp-btn-s {
    border-color: var(--accent-text);
    color: var(--accent-text);
  }
  .lp-btn-s:hover {
    background-color: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .lp-hero-verse {
    max-width: 34rem;
    margin: var(--space-12) auto 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-strong);
  }
  .lp-hv-ar {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-arabic);
    font-size: var(--text-ar-md);
    line-height: var(--lh-arabic);
  }
  .lp-hv-tr {
    margin: var(--space-3) 0 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-style: italic;
  }
  .lp-hv-src {
    margin: var(--space-2) 0 0;
    color: var(--accent-text);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* --- Ortak bölüm iskeleti ---------------------------------------------- */

  .lp-wrap {
    max-width: var(--content-wide);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
  .lp-sec {
    padding-block: var(--space-16);
  }
  @media (min-width: 48rem) {
    .lp-sec {
      padding-block: var(--space-24);
    }
  }
  .lp-h2 {
    margin: var(--space-6) 0 var(--space-3);
    color: var(--text-primary);
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: var(--fw-light);
    line-height: 1.14;
  }
  .lp-lead {
    max-width: var(--content-normal);
    margin: 0 0 var(--space-8);
    color: var(--text-secondary);
    font-size: var(--text-md);
    line-height: var(--lh-relaxed);
  }
  .lp-note {
    margin-top: var(--space-6);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  /* --- Neden farklı ------------------------------------------------------ */

  .lp-manifesto {
    border-block: 1px solid var(--border);
    background-color: var(--bg-elevated);
  }
  .lp-man-grid {
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 60rem) {
    .lp-man-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .lp-man-cell {
    padding: var(--space-12) var(--space-6);
    border-bottom: 1px solid var(--border);
  }
  .lp-man-cell:last-child {
    border-bottom: 0;
  }
  @media (min-width: 60rem) {
    .lp-man-cell {
      border-right: 1px solid var(--border);
      border-bottom: 0;
    }
    .lp-man-cell:last-child {
      border-right: 0;
    }
  }
  .lp-man-cell h3 {
    margin: 0 0 var(--space-3);
    color: var(--text-primary);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--fw-normal);
  }
  .lp-man-cell p {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: var(--lh-relaxed);
  }

  /* --- Beş kapı ---------------------------------------------------------- */

  .lp-gates {
    display: grid;
    grid-template-columns: 1fr;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    list-style: none;
  }
  @media (min-width: 40rem) {
    .lp-gates {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .lp-gates {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .lp-gate {
    position: relative;
    padding: var(--space-8) var(--space-6);
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    transition: background-color var(--duration-slow) var(--ease-out);
  }
  .lp-gate:hover {
    background-color: var(--bg-elevated);
  }
  .lp-gate-num {
    position: absolute;
    top: var(--space-6);
    right: var(--space-6);
    color: var(--accent-text);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    opacity: 0.45;
  }
  .lp-gate h3 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--fw-normal);
    line-height: 1.2;
  }
  .lp-gate h3,
  .lp-gate h3 a {
    color: var(--text-primary);
  }
  .lp-gate.is-soon h3,
  .lp-gate.is-soon h3 a {
    color: var(--text-muted);
  }
  /* Tasarımda açıklama yalnızca üzerine gelince açılıyordu; dokunmatik ve
     klavye kullanıcısı için her zaman görünür bırakıldı (plan §20.4
     erişilebilirlik). */
  .lp-gate p {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: var(--lh-normal);
  }

  /*
   * Gerilmiş bağlantı — kartın tamamı tıklanır (kullanıcı isteği 2026-09-05:
   * "ana sayfada olanlar tıklanır olsun ve ilgili bölümüne gitsin").
   *
   * Bağlantı başlıktadır; ::after ile kartı kaplar. Böylece ekran okuyucu
   * yine kısa bir metin duyar ("Kelime"), kart metnini bağlantı olarak
   * okumaz. Kap `position: relative` olmalı — .lp-gate, .lp-mod,
   * .lp-man-cell ve .lp-net-list li aşağıda öyle.
   */
  .lp-stretch {
    color: inherit;
    text-decoration: none;
  }
  .lp-stretch::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  /* Klavye odağı KARTIN kenarında görünür, harflerin değil. :has()
     desteklenmiyorsa varsayılan odak halkası harflerde kalır — hiç
     kalmamasından iyidir; bu yüzden outline:none @supports içinde. */
  @supports selector(:has(a)) {
    .lp-stretch:focus-visible {
      outline: none;
    }
    :is(.lp-gate, .lp-mod, .lp-man-cell, .lp-net-list li):has(.lp-stretch:focus-visible) {
      outline: 2px solid var(--accent);
      outline-offset: -2px;
    }
  }
  .lp-man-cell,
  .lp-net-list li,
  .lp-mod {
    position: relative;
  }
  /* Tıklanabilir kart üzerine gelince başlık pirince döner — tıklanabilir
     olduğu renkle değil imleçle de belli: ::after tüm kartı kapladığı için
     imleç zaten el oluyor. */
  :is(.lp-gate, .lp-mod, .lp-man-cell):has(.lp-stretch):hover h3,
  .lp-net-list li:has(.lp-stretch):hover b {
    color: var(--accent-text);
  }

  /* --- Nasıl çalışır ----------------------------------------------------- */

  .lp-net {
    padding-block: var(--space-16);
    border-block: 1px solid var(--border);
    background-color: var(--bg-elevated);
  }
  @media (min-width: 48rem) {
    .lp-net {
      padding-block: var(--space-24);
    }
  }
  .lp-net-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .lp-net-grid {
      grid-template-columns: 1fr 1.05fr;
    }
  }
  .lp-net-list {
    margin: var(--space-8) 0 0;
    padding: 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }
  .lp-net-list li {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border);
    font-size: var(--text-sm);
  }
  /* Bağlantı artık flex çocuğu; sabit sütun genişliği ona geçti. */
  .lp-net-list .lp-stretch {
    flex: 0 0 7rem;
  }
  .lp-net-list b {
    color: var(--accent-text);
    font-weight: var(--fw-medium);
  }
  .lp-net-list span {
    color: var(--text-secondary);
  }

  .lp-net-vis svg {
    width: 100%;
    height: auto;
  }
  .lp-net-spoke path {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1;
  }
  .lp-net-ring path {
    fill: none;
    stroke: var(--teal);
    stroke-width: 1;
    opacity: 0.45;
  }
  .lp-net-core {
    fill: var(--bg-primary);
    stroke: var(--accent);
    stroke-width: 1.2;
  }
  .lp-net-core-t {
    fill: var(--text-primary);
    font-family: var(--font-heading);
    font-size: 21px;
  }
  .lp-net-core-s {
    fill: var(--accent-text);
    font-family: var(--font-body);
    font-size: 10px;
    letter-spacing: 1.6px;
  }
  .lp-net-node circle {
    fill: var(--bg-primary);
    stroke: var(--border-strong);
  }
  .lp-net-node text {
    fill: var(--text-secondary);
    font-family: var(--font-body);
    font-size: 11.5px;
  }

  /* --- Modüller ---------------------------------------------------------- */

  .lp-mods {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    background-color: var(--border);
    list-style: none;
  }
  @media (min-width: 40rem) {
    .lp-mods {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .lp-mods {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .lp-mod {
    padding: var(--space-6);
    background-color: var(--bg-primary);
    transition: background-color var(--duration-normal) var(--ease-out);
  }
  .lp-mod:hover {
    background-color: var(--bg-elevated);
  }
  .lp-mod h3 {
    margin: 0 0 var(--space-2);
    color: var(--text-primary);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--fw-medium);
  }
  .lp-mod.is-soon h3 {
    color: var(--text-muted);
  }
  .lp-mod p {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: var(--lh-normal);
  }

  /* --- Durum etiketi (hazır / yakında) ------------------------------------ */

  /* Renk TEK BAŞINA anlam taşımaz: metin de yazıyor, kenarlık biçimi de
     ayrışıyor (DESIGN.md §1). */
  .state {
    display: inline-block;
    margin: var(--space-3) 0 0;
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .state-hazir {
    border: 1px solid var(--success);
    color: var(--success);
  }
  .state-yakinda {
    border: 1px dashed var(--text-muted);
    color: var(--text-muted);
  }

  /* --- Mealler ----------------------------------------------------------- */

  .lp-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lp-chip {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border-strong);
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
  /* Öncelikli mealler (author.priority) — ince altın kenarlık. */
  .lp-chip.is-pri {
    border-color: var(--accent-text);
    color: var(--accent-text);
  }

  /* --- Kur'an'da bugün --------------------------------------------------- */

  .lp-today {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: start;
    padding: var(--space-8);
    border: 1px solid var(--border);
    background: linear-gradient(160deg, var(--bg-elevated), var(--bg-primary));
  }
  @media (min-width: 64rem) {
    .lp-today {
      grid-template-columns: 1.15fr 1fr;
      gap: var(--space-12);
    }
  }
  .lp-today-ar {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-arabic);
    font-size: var(--text-ar-lg);
    line-height: var(--lh-arabic);
    text-align: right;
  }
  .lp-today-meal {
    margin-top: var(--space-6);
  }
  .lp-today-tr {
    margin: var(--space-4) 0 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-style: italic;
  }
