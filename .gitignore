# bagimliliklar
node_modules/
.pnpm-store/

# build ciktilari
dist/
dist_new/
.astro/
apps/web/public/data/
*.tsbuildinfo

# indirilen ham kaynak veri (repoya girmez, plan 20.1)
cache/

# yerel kuran-extract projesinden gelen hoca notu paketleri (repoya girmez).
# Dizinin kendisi degil icerigi yoksayilir; aksi halde .gitkeep istisnasi
# calismaz (git: hariç tutulan bir dizinin altindaki dosya geri alinamaz).
inbox/*
!inbox/.gitkeep

# sirlar ve ortam
.env
.env.*
!.env.example

# import raporlari
reports/

# gecici gorsel uretim alani
data/images/tmp/

# tasarim kaynak dosyalari — diskte kalir, git'e girmez.
#
# docs/logo_*.png: logo_512.png ile scripts/brand/logo-source.png BAYT BAYT
# aynidir (sha256 d7b059ab); digerleri artik pipeline'in urettigi boyutlar.
# Tek kaynak scripts/brand/logo-source.png'dir, kopyasi tutulmaz.
#
# docs/hero-video.mp4 (9,3 MB): tanitim sayfasinda KULLANILMIYOR. Sunucu CSP'si
# `default-src 'none'` ve `media-src` tanimli degil — video sessizce engellenir.
# Gerekce apps/web/src/pages/index.astro basindaki not.
docs/logo_*.png
docs/hero-video.mp4

# editor / isletim sistemi
.DS_Store
.vscode/
.idea/
*.swp

# loglar
*.log
npm-debug.log*
pnpm-debug.log*

# yapilandirma yedekleri (CLAUDE.md: her degisiklikten once *.bak.<tarih>).
# Diskte kalir, git'e girmez — surum gecmisi zaten git'in isi; yedek dosyasini
# da versiyonlamak ayni bilgiyi iki yerde tutmak olur.
*.bak.[0-9]*

# R2 hazirlik alani — ses, video, PMTiles altligi. Dosyalar git'e girmez
# (gigabaytlar). Figur tarama kaydi 2026-09-06'da kaldirildi: figur yasagi
# kalkinca kapinin dayanagi da kalkti (CLAUDE.md kural 8).
media/*
!media/.gitkeep

# MapLibre isci dosyalari — build oncesi node_modules'tan kopyalanir
# (apps/web/scripts/prepare-harita.mjs). Kaynagi pnpm-lock.yaml; ikinci bir
# kopyayi surum gecmisinde tutmanin anlami yok.
apps/web/public/_maplibre/

# Kure projeksiyonu icin dunya kara silueti — build oncesi data/geo'dan
# kopyalanir (apps/web/scripts/prepare-harita.mjs). Kaynak repoda zaten var.
apps/web/public/geo/

# calisma zamani verisi — iletisim formu mesajlari (SQLite).
# Ziyaretci mesajlari surum gecmisine girmez.
var/
