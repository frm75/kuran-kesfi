  "lessons": [
    {
      "text": "Yûsuf kıssası iffet, sabır ve affetmenin bir arada işlendiği kıssa olarak ele alınır; zindandaki daveti tebliğin her ortamda mümkün olduğuna örnek gösterilir.",
      "sourceName": "TDV İslâm Ansiklopedisi",
      "sourceReference": "YÛSUF maddesi — islamansiklopedisi.org.tr/yusuf",
      "sourceSlugs": [
        "tdv-islam-ansiklopedisi"
      ],
      "order": 1
    },
    {
      "text": "Kardeşlerini affederken 'bugün size kınama yok' demesi, güç eline geçince intikam yerine affı seçmenin örneği sayılır.",
      "sourceName": "TDV İslâm Ansiklopedisi",
      "sourceReference": "YÛSUF maddesi — islamansiklopedisi.org.tr/yusuf",
      "sourceSlugs": [
        "tdv-islam-ansiklopedisi"
      ],
      "order": 2
    },
    {
      "text": "Yûsuf'un 'beni hazinelerin başına getir, ben iyi koruyucu ve bilenim' demesi, emanet ve liyakatin birlikte anılmasına örnek gösterilir.",
      "sourceName": "TDV İslâm Ansiklopedisi",
